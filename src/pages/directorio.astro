---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Directorio Automotriz de República Dominicana | Tu Carro y Más">
    <!-- Header Banner -->
    <div class="bg-[#0f172a] text-white py-16 border-b border-slate-800">
        <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <span class="px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/30 text-[10px] font-black uppercase tracking-widest mb-3 inline-block">
                    Directorio Comercial & Servicios
                </span>
                <h1 class="text-3xl sm:text-4xl font-bold tracking-tight uppercase font-['Outfit',sans-serif]">
                    Directorio Automotriz de RD
                </h1>
                <p class="text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
                    Encuentra talleres mecánicos, venta de repuestos, detailing y servicios certificados en todo el país. Contacto directo por WhatsApp con cada negocio.
                </p>
            </div>
        </div>
    </div>

    <!-- Filter Bar and Categories -->
    <section class="bg-white border-b border-slate-200 py-4 sticky top-20 z-30 shadow-xs">
        <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row md:items-center justify-between gap-4">
            
            <!-- Category Pills Filter (Generated dynamically) -->
            <div id="category-filter-pills" class="flex items-center gap-2 overflow-x-auto pb-1 scrollbar-hide">
                <button class="cat-pill active px-3.5 py-1.5 text-xs font-bold uppercase tracking-wider bg-[#0f172a] text-white border border-[#0f172a]" data-cat="all">
                    Todos
                </button>
                <button class="cat-pill px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200" data-cat="talleres-mecanicos">
                    Talleres Mecánicos
                </button>
                <button class="cat-pill px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200" data-cat="repuestos-y-accesorios">
                    Venta de Repuestos
                </button>
                <button class="cat-pill px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200" data-cat="detailing-car-wash">
                    Detailing & Lavado
                </button>
            </div>

            <div class="flex items-center gap-3 shrink-0">
                <a href="/anunciar" class="px-4 py-2 bg-[#1d4ed8] hover:bg-[#1e40af] text-white text-xs font-bold uppercase tracking-wider luxury-btn">
                    <i class="fas fa-plus me-1"></i> Anunciar Negocio (1er Año Gratis)
                </a>
            </div>

        </div>
    </section>

    <!-- Businesses Grid -->
    <section class="py-12 bg-[#f8fafc] min-h-[500px]">
        <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="flex items-center justify-between mb-8">
                <h2 id="dir-heading" class="text-xl font-bold text-[#0f172a] uppercase tracking-wide">
                    Negocios Registrados
                </h2>
                <span id="biz-count-label" class="text-xs text-slate-500 font-semibold">
                    Cargando directorio...
                </span>
            </div>

            <!-- Grid Container -->
            <div id="businesses-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Skeleton Placeholders -->
                <div class="bg-white border border-slate-200 p-6 animate-pulse space-y-3">
                    <div class="h-40 bg-slate-100"></div>
                    <div class="h-5 bg-slate-100 w-3/4"></div>
                    <div class="h-4 bg-slate-100 w-1/2"></div>
                </div>
                <div class="bg-white border border-slate-200 p-6 animate-pulse space-y-3">
                    <div class="h-40 bg-slate-100"></div>
                    <div class="h-5 bg-slate-100 w-3/4"></div>
                    <div class="h-4 bg-slate-100 w-1/2"></div>
                </div>
            </div>

            <!-- Empty State -->
            <div id="empty-biz" class="hidden text-center py-16 bg-white border border-dashed border-slate-300 p-8">
                <i class="fas fa-store text-4xl text-slate-300 mb-3"></i>
                <h3 class="text-base font-bold text-slate-800">No hay negocios registrados en esta categoría aún</h3>
                <p class="text-xs text-slate-500 mt-1 mb-6">¡Sé el primero en anunciar tu negocio en esta sección y obtén el 1er año gratis!</p>
                <a href="/anunciar" class="px-6 py-2.5 bg-[#1d4ed8] text-white text-xs font-bold uppercase tracking-wider luxury-btn">
                    Anunciar Mi Negocio
                </a>
            </div>

        </div>
    </section>
</Layout>

<script>
    import { collection, onSnapshot, query, orderBy } from "firebase/firestore";
    import { db } from "../lib/firebase/client";

    const grid = document.getElementById('businesses-grid');
    const countLabel = document.getElementById('biz-count-label');
    const emptyBox = document.getElementById('empty-biz');
    const pillsContainer = document.getElementById('category-filter-pills');

    // Read URL param
    const urlParams = new URLSearchParams(window.location.search);
    let activeFilter = urlParams.get('cat') || 'all';

    let allBusinesses: any[] = [];

    function renderBusinesses() {
        if (!grid) return;
        grid.innerHTML = '';

        const filtered = activeFilter === 'all' 
            ? allBusinesses 
            : allBusinesses.filter(b => b.categorySlug === activeFilter);

        if (countLabel) countLabel.textContent = `${filtered.length} Negocios Encontrados`;

        if (filtered.length === 0) {
            emptyBox?.classList.remove('hidden');
            return;
        }
        emptyBox?.classList.add('hidden');

        filtered.forEach((b) => {
            const cleanPhone = (b.whatsapp || b.phone || '18499154010').replace(/\D/g, '');
            const msg = encodeURIComponent(`Hola, vi su negocio ${b.name} en el Directorio de Tu Carro y Más y quisiera información.`);

            const card = document.createElement('div');
            card.className = "luxury-card overflow-hidden flex flex-col justify-between";
            card.innerHTML = `
                <div>
                    <!-- Photo/Cover -->
                    <div class="h-48 w-full bg-slate-100 overflow-hidden relative">
                        <img src="${b.logoUrl || 'https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=800&q=80'}" alt="${b.name}" class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
                        <span class="absolute top-3 left-3 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider bg-[#0f172a] text-white border border-slate-700">
                            ${b.category}
                        </span>
                        <span class="absolute bottom-3 right-3 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider bg-emerald-700 text-white">
                            Verificado
                        </span>
                    </div>

                    <!-- Body -->
                    <div class="p-6">
                        <h3 class="text-lg font-bold text-[#0f172a] mb-1 leading-snug">${b.name}</h3>
                        <p class="text-xs text-slate-500 flex items-center gap-1.5 mb-3">
                            <i class="fas fa-map-marker-alt text-[#1d4ed8]"></i>
                            <span>${b.city || 'Santo Domingo'} ${b.address ? '• ' + b.address : ''}</span>
                        </p>
                        <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed mb-4">
                            ${b.description || 'Servicios automotrices de calidad y repuestos.'}
                        </p>
                    </div>
                </div>

                <!-- Footer WhatsApp Direct Button -->
                <div class="p-5 bg-slate-50 border-t border-slate-100 space-y-2">
                    <a href="https://wa.me/${cleanPhone}?text=${msg}" target="_blank" rel="noopener noreferrer" class="w-full py-3 px-4 bg-[#15803d] hover:bg-[#166534] text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 transition-colors">
                        <i class="fab fa-whatsapp text-lg"></i>
                        <span>Contactar por WhatsApp</span>
                    </a>
                </div>
            `;
            grid.appendChild(card);
        });
    }

    // Set up filter buttons
    function updatePillsUI() {
        const pills = document.querySelectorAll('.cat-pill');
        pills.forEach(p => {
            const cat = p.getAttribute('data-cat');
            if (cat === activeFilter) {
                p.classList.add('bg-[#0f172a]', 'text-white', 'border-[#0f172a]');
                p.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200');
            } else {
                p.classList.remove('bg-[#0f172a]', 'text-white', 'border-[#0f172a]');
                p.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200');
            }
        });
    }

    pillsContainer?.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest('.cat-pill');
        if (target) {
            const cat = target.getAttribute('data-cat') || 'all';
            activeFilter = cat;
            updatePillsUI();
            renderBusinesses();
        }
    });

    // Firestore Realtime Listener
    const q = query(collection(db, "businesses"), orderBy("createdAt", "desc"));
    onSnapshot(q, (snapshot) => {
        allBusinesses = [];
        const dynamicCategories = new Set();

        snapshot.forEach(docSnap => {
            const d = docSnap.data();
            d.id = docSnap.id;
            allBusinesses.push(d);

            if (d.category && d.categorySlug) {
                dynamicCategories.add(JSON.stringify({ name: d.category, slug: d.categorySlug }));
            }
        });

        // Add dynamic pills if new categories exist
        dynamicCategories.forEach((jsonStr: any) => {
            const item = JSON.parse(jsonStr);
            const exists = document.querySelector(`[data-cat="${item.slug}"]`);
            if (!exists && pillsContainer) {
                const btn = document.createElement('button');
                btn.className = "cat-pill px-3.5 py-1.5 text-xs font-semibold uppercase tracking-wider bg-slate-50 text-slate-700 hover:bg-slate-100 border border-slate-200 shrink-0";
                btn.setAttribute('data-cat', item.slug);
                btn.textContent = item.name;
                pillsContainer.appendChild(btn);
            }
        });

        updatePillsUI();
        renderBusinesses();
    });
</script>

---
import Layout from "../layouts/Layout.astro";
import { ALL_DOMINICAN_BRANDS } from "../lib/brandsData";

// Orden alfabético estricto (A-Z) para todas las marcas
const sortedBrandsAlphabetical = [...ALL_DOMINICAN_BRANDS].sort((a, b) => 
  a.name.localeCompare(b.name, "es", { sensitivity: "base" })
);
---

<Layout title="Marcas de Vehículos y Transporte en República Dominicana | TuCarroYMas">
  <div class="bg-white min-h-screen py-10 px-4 sm:px-8">
    <div class="max-w-6xl mx-auto">
      
      <!-- Breadcrumbs & Title /brands/ -->
      <div class="mb-8">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">
          <a href="/" class="hover:text-[#D54000]">Inicio</a>
          <span>/</span>
          <span class="text-slate-800">Marcas de Vehículos</span>
        </div>
        <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Marcas Disponibles en República Dominicana
        </h1>
        <p class="text-sm text-slate-500 mt-1 max-w-2xl">
          Explora todas las marcas de vehículos ordenadas alfabéticamente (A-Z): autos, todoterrenos, marcas chinas líderes, camionetas, camiones 18-wheelers, maquinaria pesada y motocicletas comercializadas en el país.
        </p>
      </div>

      <!-- Quick Filter Pills: Incluye filtro especial para Marcas Chinas -->
      <div class="flex flex-wrap gap-2 mb-8 pb-4 border-b border-slate-200 text-xs font-bold">
        <button type="button" class="brand-filter-btn px-3.5 py-1.5 rounded-full bg-[#D54000] text-white shadow-sm" data-filter="all">
          Todas ({sortedBrandsAlphabetical.length})
        </button>
        <button type="button" class="brand-filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="chinas">
          Marcas Chinas (BYD, Changan, Geely, etc.)
        </button>
        <button type="button" class="brand-filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="autos">
          Autos & SUVs
        </button>
        <button type="button" class="brand-filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="pesados">
          Camiones & 18-Wheelers
        </button>
        <button type="button" class="brand-filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="maquinaria">
          Maquinaria Pesada
        </button>
        <button type="button" class="brand-filter-btn px-3.5 py-1.5 rounded-full bg-slate-100 text-slate-700 hover:bg-slate-200" data-filter="motos">
          Motocicletas
        </button>
      </div>

      <!-- Grid of all Dominican Brands ordenadas alfabéticamente en 5 columnas -->
      <div id="brands-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 sm:gap-6">
        {sortedBrandsAlphabetical.map(brand => (
          <a 
            href={`/vehiculos?make=${encodeURIComponent(brand.name)}`}
            data-category={brand.category}
            data-name={brand.name}
            class="brand-card flex flex-col items-center justify-center p-5 sm:p-6 border border-slate-200 rounded-sm hover:border-[#D54000] hover:shadow-xl transition-all group bg-white text-center cursor-pointer"
          >
            <!-- SVG Logo Container (Cargado localmente desde /brands/*.svg) -->
            <div class="w-20 h-20 sm:w-24 sm:h-24 flex items-center justify-center mb-3">
              <img 
                src={brand.logo} 
                alt={`Logo ${brand.name}`} 
                class="max-w-[64px] max-h-[64px] sm:max-w-[72px] sm:max-h-[72px] object-contain opacity-85 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" 
                loading="lazy"
              />
            </div>

            <!-- Brand Name -->
            <span class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-[#D54000] transition-colors leading-tight">
              {brand.name}
            </span>

            <!-- Country badge -->
            <span class="text-[10px] text-slate-400 mt-1">
              {brand.country}
            </span>
          </a>
        ))}
      </div>

      <!-- Bottom help block -->
      <div class="mt-14 p-6 bg-slate-50 border border-slate-200 rounded-sm flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-sm font-bold text-slate-900">¿No encuentras una marca o deseas registrar tu concesionario?</h3>
          <p class="text-xs text-slate-500 mt-0.5">Publica tus vehículos gratuitamente con ficha técnica completa y contacto a WhatsApp.</p>
        </div>
        <a href="/publicar" class="bg-[#D54000] hover:bg-[#b83600] text-white text-xs font-bold uppercase tracking-wider py-2.5 px-5 rounded-full whitespace-nowrap shadow-sm">
          Publicar Anuncio
        </a>
      </div>

    </div>
  </div>
</Layout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".brand-filter-btn");
  const cards = document.querySelectorAll<HTMLElement>(".brand-card");

  buttons.forEach(btn => {
    btn.addEventListener("click", () => {
      const filter = btn.getAttribute("data-filter");
      buttons.forEach(b => {
        b.classList.remove("bg-[#D54000]", "text-white");
        b.classList.add("bg-slate-100", "text-slate-700");
      });
      btn.classList.add("bg-[#D54000]", "text-white");
      btn.classList.remove("bg-slate-100", "text-slate-700");

      cards.forEach(card => {
        if (filter === "all" || card.getAttribute("data-category") === filter) {
          card.classList.remove("hidden");
        } else {
          card.classList.add("hidden");
        }
      });
    });
  });
</script>

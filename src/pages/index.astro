---
import Layout from '../layouts/Layout.astro';
import { VEHICLE_BRANDS, DOMINICAN_PROVINCES, MARKETPLACE_CATEGORIES } from '../lib/constants';
---

<Layout 
    title="TuCarroYMás.com | Dealer Digital de Vehículos, Motos, Botes y Pesados"
    description="Compra y vende vehículos, camionetas, motos, botes y camiones en República Dominicana y el mundo. Publicación gratuita y trato directo por WhatsApp sin comisiones."
>
    <!-- HERO DEALERSHIP BANNER -->
    <section class="relative bg-[#070b16] text-white pt-12 pb-20 border-b border-slate-800 overflow-hidden">
        
        <!-- Background Lighting FX -->
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#2563eb_1px,transparent_1px)] [background-size:24px_24px] pointer-events-none"></div>
        <div class="absolute -top-32 -right-32 w-96 h-96 bg-blue-600/25 rounded-full blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-32 -left-32 w-96 h-96 bg-emerald-600/15 rounded-full blur-3xl pointer-events-none"></div>

        <div class="relative z-10 max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Value Prop & Title -->
            <div class="text-center max-w-3xl mx-auto mb-10">
                <span class="inline-flex items-center gap-2 px-3.5 py-1 bg-blue-950/90 border border-blue-500/40 text-[#38bdf8] text-[11px] font-black uppercase tracking-widest mb-4 shadow-sm">
                    <i class="fas fa-certificate text-emerald-400"></i> Portal Automotriz & Dealer Digital Global
                </span>
                <h1 class="text-3xl sm:text-5xl md:text-6xl font-black uppercase tracking-tight font-['Outfit',sans-serif] leading-tight">
                    El Dealer Digital de <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#38bdf8] via-blue-400 to-[#60a5fa]">Todo Tipo de Transporte</span>
                </h1>
                <p class="text-slate-300 text-sm sm:text-base mt-3 max-w-2xl mx-auto">
                    Carros, Camionetas, SUVs, Motocicletas, Botes y Vehículos Pesados. Publica gratis y contacta directamente al vendedor por WhatsApp.
                </p>
            </div>

            <!-- UNIFIED SEARCH BOX (Cars.com / SuperCarros Style) -->
            <div class="max-w-5xl mx-auto bg-white border-2 border-slate-900 shadow-2xl p-6 sm:p-8" style="border-radius: 0px !important;">
                
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-4">
                    <!-- Categoría de Transporte -->
                    <div>
                        <label class="block text-[11px] font-black uppercase tracking-wider text-slate-700 mb-1" for="filter-cat">
                            Categoría de Transporte
                        </label>
                        <select id="filter-cat" class="w-full text-xs font-semibold p-3.5 bg-slate-50 border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                            <option value="all">Todas las Categorías</option>
                            {MARKETPLACE_CATEGORIES.map(c => <option value={c.id}>{c.name}</option>)}
                        </select>
                    </div>

                    <!-- Marca -->
                    <div>
                        <label class="block text-[11px] font-black uppercase tracking-wider text-slate-700 mb-1" for="filter-brand">
                            Marca / Fabricante
                        </label>
                        <select id="filter-brand" class="w-full text-xs font-semibold p-3.5 bg-slate-50 border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                            <option value="all">Todas las Marcas</option>
                            {VEHICLE_BRANDS.map(b => <option value={b}>{b}</option>)}
                        </select>
                    </div>

                    <!-- Ubicación / Provincia -->
                    <div>
                        <label class="block text-[11px] font-black uppercase tracking-wider text-slate-700 mb-1" for="filter-prov">
                            Ubicación
                        </label>
                        <select id="filter-prov" class="w-full text-xs font-semibold p-3.5 bg-slate-50 border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                            <option value="all">Cualquier Ubicación (RD y Global)</option>
                            {DOMINICAN_PROVINCES.map(p => <option value={p}>{p}</option>)}
                        </select>
                    </div>

                    <!-- Presupuesto Máximo -->
                    <div>
                        <label class="block text-[11px] font-black uppercase tracking-wider text-slate-700 mb-1" for="filter-price">
                            Precio Máximo (USD)
                        </label>
                        <select id="filter-price" class="w-full text-xs font-semibold p-3.5 bg-slate-50 border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                            <option value="all">Cualquier Precio</option>
                            <option value="15000">Hasta $15,000 USD</option>
                            <option value="30000">Hasta $30,000 USD</option>
                            <option value="50000">Hasta $50,000 USD</option>
                            <option value="100000">Hasta $100,000 USD</option>
                            <option value="250000">Más de $100,000 USD</option>
                        </select>
                    </div>
                </div>

                <!-- Action Button -->
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-2 border-t border-slate-100">
                    <span class="text-xs text-slate-500 flex items-center gap-2">
                        <i class="fas fa-bolt text-[#1d4ed8]"></i>
                        <span>Búsqueda instantánea con actualización en tiempo real</span>
                    </span>
                    <button 
                      type="button" 
                      id="btn-search-catalog" 
                      class="w-full sm:w-auto px-10 py-4 bg-[#1d4ed8] hover:bg-[#1e40af] text-white font-black text-xs uppercase tracking-wider luxury-btn shadow-md flex items-center justify-center gap-2"
                      style="border-radius: 0px !important;"
                    >
                        <i class="fas fa-search"></i>
                        <span>Explorar Inventario</span>
                    </button>
                </div>

            </div>

            <!-- CATEGORY BADGES GRID (Cars, SUVs, Trucks, Motorcycles, Boats, Heavy) -->
            <div class="mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                {MARKETPLACE_CATEGORIES.map(cat => (
                    <a 
                      href={`/vehiculos?categoria=${cat.id}`} 
                      class="bg-slate-900/80 hover:bg-blue-600 border border-slate-800 hover:border-blue-500 p-4 text-center transition-all group flex flex-col items-center justify-center"
                      style="border-radius: 0px !important;"
                    >
                        <i class={`fas ${cat.icon} text-2xl text-[#38bdf8] group-hover:text-white group-hover:scale-110 transition-all mb-2`}></i>
                        <strong class="text-xs font-bold text-white uppercase block leading-tight">{cat.name}</strong>
                    </a>
                ))}
            </div>

        </div>
    </section>

    <!-- SECTION: INVENTARIO DESTACADO -->
    <section class="py-16 bg-[#f8fafc]">
        <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-4 mb-8">
                <div>
                    <span class="text-xs font-bold uppercase tracking-widest text-[#1d4ed8] block mb-1">
                        Inventario Verificado
                    </span>
                    <h2 class="text-2xl sm:text-4xl font-black text-[#0f172a] uppercase font-['Outfit',sans-serif] tracking-tight">
                        Unidades Destacadas en el Dealer
                    </h2>
                </div>
                <a href="/vehiculos" class="text-xs font-black uppercase tracking-wider text-[#1d4ed8] hover:text-[#1e40af] flex items-center gap-1.5 border-b border-[#1d4ed8] pb-0.5">
                    <span>Ver Todo el Inventario</span>
                    <i class="fas fa-arrow-right text-[11px]"></i>
                </a>
            </div>

            <!-- Dynamic Grid from Firestore -->
            <div id="dealer-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <div class="bg-white border border-slate-200 p-4 animate-pulse space-y-4">
                    <div class="h-64 bg-slate-100"></div>
                    <div class="h-6 bg-slate-100 w-1/2"></div>
                </div>
                <div class="bg-white border border-slate-200 p-4 animate-pulse space-y-4">
                    <div class="h-64 bg-slate-100"></div>
                    <div class="h-6 bg-slate-100 w-1/2"></div>
                </div>
                <div class="bg-white border border-slate-200 p-4 animate-pulse space-y-4">
                    <div class="h-64 bg-slate-100"></div>
                    <div class="h-6 bg-slate-100 w-1/2"></div>
                </div>
            </div>

        </div>
    </section>

    <!-- SECTION: SELL CTA HERO -->
    <section class="py-16 bg-[#090e1a] text-white border-t border-slate-800">
        <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6">
            <span class="px-3.5 py-1 bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 text-[11px] font-black uppercase tracking-widest inline-block">
                Publicación 100% Gratuita • Sin Comisiones
            </span>
            <h2 class="text-3xl sm:text-5xl font-black uppercase font-['Outfit',sans-serif] tracking-tight max-w-3xl mx-auto">
                ¿Tienes un Carro, Moto, Camioneta o Bote para Vender?
            </h2>
            <p class="text-slate-400 text-sm max-w-2xl mx-auto leading-relaxed">
                Publica tu unidad en minutos con fotos cuadradas automáticas en alta resolución. Los compradores te contactarán de forma directa e inmediata a tu WhatsApp.
            </p>
            <div class="pt-2">
                <a 
                  href="/publicar" 
                  class="px-10 py-4 bg-[#15803d] hover:bg-[#166534] text-white font-black text-xs uppercase tracking-wider luxury-btn shadow-2xl inline-flex items-center gap-2"
                  style="border-radius: 0px !important;"
                >
                    <i class="fas fa-plus-circle text-base"></i>
                    <span>Publicar Mi Unidad Gratis Ahora</span>
                </a>
            </div>
        </div>
    </section>
</Layout>

<script>
    import { collection, onSnapshot, query, orderBy } from "firebase/firestore";
    import { db } from "../lib/firebase/client";

    const searchBtn = document.getElementById('btn-search-catalog');
    searchBtn?.addEventListener('click', () => {
        const cat = (document.getElementById('filter-cat') as HTMLSelectElement).value;
        const brand = (document.getElementById('filter-brand') as HTMLSelectElement).value;
        const prov = (document.getElementById('filter-prov') as HTMLSelectElement).value;
        const price = (document.getElementById('filter-price') as HTMLSelectElement).value;

        const params = new URLSearchParams();
        if (cat !== 'all') params.append('categoria', cat);
        if (brand !== 'all') params.append('marca', brand);
        if (prov !== 'all') params.append('provincia', prov);
        if (price !== 'all') params.append('precio', price);

        window.location.href = `/vehiculos?${params.toString()}`;
    });

    // Stream from Firestore
    const dealerGrid = document.getElementById('dealer-grid');
    const q = query(collection(db, "vehicles"), orderBy("createdAt", "desc"));

    onSnapshot(q, (snap) => {
        if (!dealerGrid) return;
        dealerGrid.innerHTML = '';

        if (snap.empty) {
            dealerGrid.innerHTML = `
                <div class="col-span-full text-center py-12 bg-white border border-slate-200 p-8">
                    <i class="fas fa-car text-4xl text-slate-300 mb-3"></i>
                    <p class="text-sm font-bold text-slate-700 uppercase">Aún no hay unidades registradas</p>
                    <p class="text-xs text-slate-500 mt-1">Sé el primero en publicar tu vehículo gratis.</p>
                </div>
            `;
            return;
        }

        snap.docs.forEach(docSnap => {
            const v = docSnap.data();
            v.id = docSnap.id;

            const price = v.price || v.pricePerDay || 25000;
            const currency = v.currency || 'USD';
            const priceStr = currency === 'DOP' ? `RD$ ${price.toLocaleString()}` : `$${price.toLocaleString()} USD`;
            const carImg = v.title.includes("Honda") ? "/Honda.webp" : v.title.includes("Jeep") ? "/Jeep.webp" : (v.mainImage || "/Honda.webp");
            const cleanPhone = (v.ownerWhatsapp || '18499154010').replace(/\D/g, '');

            const card = document.createElement('div');
            card.className = "luxury-card flex flex-col justify-between overflow-hidden group";
            card.innerHTML = `
                <div>
                    <!-- Image -->
                    <div class="car-image-container relative">
                        <img src="${carImg}" alt="${v.title}" />
                        <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10">
                            <span class="px-2.5 py-1 text-[10px] font-black uppercase tracking-wider bg-[#090e1a] text-white shadow-md">
                                ${v.condition || 'Usado'}
                            </span>
                            <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider bg-black/75 backdrop-blur-md text-emerald-400 border border-emerald-500/30">
                                <i class="fas fa-check-circle me-1"></i> Verificado
                            </span>
                        </div>
                        <div class="absolute bottom-3 right-3 px-3 py-1 bg-white/95 backdrop-blur-md border border-slate-200 text-slate-900 shadow-sm">
                            <strong class="text-base font-black text-[#15803d] font-mono">${priceStr}</strong>
                        </div>
                    </div>

                    <!-- Body -->
                    <div class="p-5">
                        <h4 class="text-lg font-bold text-[#0f172a] tracking-tight group-hover:text-[#1d4ed8] transition-colors mb-1">${v.title}</h4>
                        <p class="text-xs text-slate-500 flex items-center gap-1 mb-3">
                            <i class="fas fa-location-dot text-[#1d4ed8] text-[11px]"></i>
                            <span>${v.province || v.city || 'República Dominicana'}</span>
                            <span class="mx-1">•</span>
                            <span class="text-slate-400 font-semibold">${v.sellerType === 'dealer' ? 'Dealer' : 'Particular'}</span>
                        </p>
                        <div class="grid grid-cols-2 gap-2 text-xs text-slate-700 bg-slate-50 border border-slate-200 p-2 mb-4">
                            <div><span class="text-[10px] text-slate-400 uppercase block font-bold">Motor</span><strong>${v.engine || '2.0L'}</strong></div>
                            <div><span class="text-[10px] text-slate-400 uppercase block font-bold">Millas / Km</span><strong>${(v.mileage || 45000).toLocaleString()}</strong></div>
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <a href="/vehiculos" class="py-2.5 px-3 bg-[#1d4ed8] hover:bg-[#1e40af] text-white text-center text-xs font-bold uppercase tracking-wider luxury-btn">
                                Ficha Técnica
                            </a>
                            <a href="https://wa.me/${cleanPhone}?text=Hola,%20me%20interesa%20comprar%20su%20${encodeURIComponent(v.title)}%20anunciado%20en%20TuCarroYMás.com" target="_blank" rel="noopener noreferrer" class="py-2.5 px-3 bg-[#15803d] hover:bg-[#166534] text-white text-center text-xs font-bold uppercase tracking-wider flex items-center justify-center gap-1 luxury-btn">
                                <i class="fab fa-whatsapp"></i> WhatsApp
                            </a>
                        </div>
                    </div>
                </div>
            `;
            dealerGrid.appendChild(card);
        });
    });
</script>

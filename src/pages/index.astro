---
// Página de Coming Soon / Próximamente Oficial de TuCarroYMas
// Importa el global.css del proyecto para que Astro empaquete e inserte todo el CSS estático sin depender de scripts externos
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Próximamente | TuCarroYMas — Plataforma de Concesionarios y Vehículos en RD</title>
  <meta name="description" content="Estamos preparando la plataforma automotriz y de concesionarios más avanzada de República Dominicana. Muy pronto disponible." />
  <link rel="canonical" href="https://tucarroymas.com" />

  <!-- Fonts & Font Awesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <style>
    /* Estilos base inline 100% seguros y a prueba de fallos de red */
    :root {
      --brand: #D54000;
      --brand-dark: #b83600;
    }
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      background-color: #080d19;
      color: #f8fafc;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      overflow-x: hidden;
    }
    .hero-bg {
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
    }
    .hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.28;
      filter: saturate(1.1);
    }
    .hero-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at center, rgba(213, 64, 0, 0.12) 0%, rgba(8, 13, 25, 0.85) 60%, #080d19 100%);
    }
    .content-wrapper {
      position: relative;
      z-index: 10;
      max-width: 900px;
      margin: auto;
      padding: 2.5rem 1.5rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
    }
    .brand-logo {
      display: inline-flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 2rem;
    }
    .logo-badge {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: #D54000;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 1.25rem;
      box-shadow: 0 10px 25px -5px rgba(213, 64, 0, 0.5);
    }
    .brand-title {
      font-size: 1.75rem;
      font-weight: 900;
      letter-spacing: -0.03em;
      text-transform: uppercase;
      color: #ffffff;
      line-height: 1;
    }
    .brand-subtitle {
      font-size: 0.65rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #94a3b8;
      font-weight: 700;
      margin-top: 0.25rem;
      display: block;
    }
    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.375rem 1rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: rgba(213, 64, 0, 0.15);
      color: #ff6b35;
      border: 1px solid rgba(213, 64, 0, 0.35);
      margin-bottom: 1.5rem;
      backdrop-filter: blur(8px);
    }
    .headline {
      font-size: clamp(2.2rem, 5.5vw, 4.2rem);
      font-weight: 900;
      line-height: 1.08;
      letter-spacing: -0.02em;
      text-transform: uppercase;
      margin-bottom: 1.25rem;
      color: #ffffff;
    }
    .gradient-text {
      background: linear-gradient(135deg, #ffffff 30%, #ffd0b8 70%, #D54000 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .subhead {
      font-size: clamp(0.95rem, 1.8vw, 1.15rem);
      color: #cbd5e1;
      max-width: 640px;
      margin: 0 auto 2.5rem;
      line-height: 1.6;
    }
    .countdown-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0.75rem;
      width: 100%;
      max-width: 480px;
      margin-bottom: 2.5rem;
    }
    .timer-card {
      background: rgba(15, 23, 42, 0.75);
      border: 1px solid rgba(255, 255, 255, 0.1);
      backdrop-filter: blur(12px);
      padding: 1rem 0.5rem;
      border-radius: 10px;
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.4);
    }
    .timer-num {
      display: block;
      font-size: clamp(1.5rem, 3.5vw, 2.25rem);
      font-weight: 900;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      color: #ffffff;
    }
    .timer-num.highlight {
      color: #D54000;
    }
    .timer-lbl {
      display: block;
      font-size: 0.65rem;
      text-transform: uppercase;
      font-weight: 800;
      letter-spacing: 0.1em;
      color: #94a3b8;
      margin-top: 0.25rem;
    }
    .notify-box {
      width: 100%;
      max-width: 440px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid rgba(255, 255, 255, 0.12);
      backdrop-filter: blur(12px);
      padding: 0.5rem;
      border-radius: 8px;
      margin-bottom: 1.5rem;
      box-shadow: 0 15px 35px -10px rgba(0, 0, 0, 0.5);
    }
    .notify-form {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    @media (min-width: 480px) {
      .notify-form {
        flex-direction: row;
      }
    }
    .notify-input {
      flex: 1;
      background: rgba(10, 15, 29, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.15);
      color: #ffffff;
      padding: 0.75rem 1rem;
      font-size: 0.85rem;
      border-radius: 6px;
      outline: none;
    }
    .notify-input:focus {
      border-color: #D54000;
      box-shadow: 0 0 0 2px rgba(213, 64, 0, 0.25);
    }
    .notify-btn {
      background: #D54000;
      color: #ffffff;
      border: none;
      padding: 0.75rem 1.25rem;
      font-size: 0.75rem;
      font-weight: 900;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      transition: background 0.2s, transform 0.1s;
    }
    .notify-btn:hover {
      background: #b83600;
    }
    .dealer-notice {
      font-size: 0.8rem;
      color: #94a3b8;
    }
    .dealer-notice a {
      color: #ff6b35;
      font-weight: 700;
      text-decoration: none;
    }
    .dealer-notice a:hover {
      text-decoration: underline;
    }
    .footer {
      position: relative;
      z-index: 10;
      padding: 1.5rem;
      text-align: center;
      font-size: 0.75rem;
      color: #64748b;
      border-top: 1px solid rgba(255, 255, 255, 0.05);
    }
  </style>
</head>
<body>

  <!-- Cinematic Background Image -->
  <div class="hero-bg">
    <img 
      src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=2000&q=80" 
      alt="Vehículo de Lujo" 
    />
    <div class="hero-overlay"></div>
  </div>

  <!-- Content Center -->
  <div class="content-wrapper">
    
    <!-- Branding Header -->
    <div class="brand-logo">
      <div class="logo-badge">
        <i class="fa-solid fa-car-side"></i>
      </div>
      <div>
        <div class="brand-title">TUCARRO<span style="color: #D54000;">YMAS</span></div>
        <span class="brand-subtitle">República Dominicana</span>
      </div>
    </div>

    <!-- Status Pill -->
    <div class="status-pill">
      <i class="fa-solid fa-wrench"></i>
      <span>Estamos preparando algo extraordinario</span>
    </div>

    <!-- Main Title -->
    <h1 class="headline">
      Gran Apertura <br />
      <span class="gradient-text">Próximamente</span>
    </h1>

    <p class="subhead">
      La plataforma automotriz, de concesionarios oficiales, compra, venta e inventario multicategoría más moderna y rápida de República Dominicana está a punto de encender motores.
    </p>

    <!-- Countdown Timer -->
    <div class="countdown-grid">
      <div class="timer-card">
        <span id="days" class="timer-num">14</span>
        <span class="timer-lbl">Días</span>
      </div>
      <div class="timer-card">
        <span id="hours" class="timer-num">08</span>
        <span class="timer-lbl">Horas</span>
      </div>
      <div class="timer-card">
        <span id="minutes" class="timer-num">42</span>
        <span class="timer-lbl">Minutos</span>
      </div>
      <div class="timer-card">
        <span id="seconds" class="timer-num highlight">19</span>
        <span class="timer-lbl">Segundos</span>
      </div>
    </div>

    <!-- Notification Form Box -->
    <div class="notify-box">
      <form id="notify-form" class="notify-form">
        <input 
          type="email" 
          id="notify-email"
          placeholder="Ingresa tu correo electrónico..." 
          class="notify-input"
          required
        />
        <button type="submit" class="notify-btn">
          <span>Avisarme</span>
          <i class="fa-solid fa-bell"></i>
        </button>
      </form>
      <div id="notify-success" style="display: none; color: #4ade80; font-size: 0.8rem; font-weight: 700; padding: 0.5rem 0;">
        ✓ ¡Gracias! Te avisaremos en el momento exacto del lanzamiento oficial.
      </div>
    </div>

    <p class="dealer-notice">
      ¿Eres concesionario o dealer y deseas registrar tu inventario prioritario? 
      <a href="https://wa.me/18295550199?text=Hola%2C%20deseo%20registrar%20mi%20dealer%20en%20TuCarroYMas" target="_blank">
        <i class="fa-brands fa-whatsapp"></i> Hablar con Soporte
      </a>
    </p>

  </div>

  <!-- Footer -->
  <footer class="footer">
    <p>© 2026 TuCarroYMas. Todos los derechos reservados. República Dominicana.</p>
  </footer>

  <!-- Countdown Script -->
  <script>
    const launchDate = new Date();
    launchDate.setDate(launchDate.getDate() + 14);

    function updateCountdown() {
      const now = new Date().getTime();
      const distance = launchDate.getTime() - now;

      if (distance < 0) return;

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      const daysEl = document.getElementById("days");
      const hoursEl = document.getElementById("hours");
      const minsEl = document.getElementById("minutes");
      const secsEl = document.getElementById("seconds");

      if (daysEl) daysEl.innerText = String(days).padStart(2, "0");
      if (hoursEl) hoursEl.innerText = String(hours).padStart(2, "0");
      if (minsEl) minsEl.innerText = String(minutes).padStart(2, "0");
      if (secsEl) secsEl.innerText = String(seconds).padStart(2, "0");
    }

    setInterval(updateCountdown, 1000);
    updateCountdown();

    const form = document.getElementById("notify-form");
    const successMsg = document.getElementById("notify-success");
    const emailInput = document.getElementById("notify-email") as HTMLInputElement;

    if (form && successMsg && emailInput) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (email) {
          try {
            const list = JSON.parse(localStorage.getItem("tucarroymas_subscribers") || "[]");
            list.push({ email, date: new Date().toISOString() });
            localStorage.setItem("tucarroymas_subscribers", JSON.stringify(list));
          } catch(err) {}

          form.style.display = "none";
          successMsg.style.display = "block";
        }
      });
    }
  </script>

</body>
</html>

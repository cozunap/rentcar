---
// Página de Coming Soon / Próximamente Oficial de TuCarroYMas
// Diseño Ultra Premium, 100% Responsivo, con fondo cinematic y cuenta regresiva
---

<!DOCTYPE html>
<html lang="es" class="h-full">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Próximamente | TuCarroYMas — Plataforma de Concesionarios y Vehículos en RD</title>
  <meta name="description" content="Estamos preparando la plataforma automotriz y de concesionarios más avanzada de República Dominicana. Muy pronto disponible." />
  <link rel="canonical" href="https://tucarroymas.com" />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Tailwind CDN & Base Styling -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              DEFAULT: '#D54000',
              dark: '#b83600',
              light: '#ff5722'
            }
          }
        }
      }
    }
  </script>
</head>
<body class="h-full bg-[#0a0f1d] text-slate-100 font-['Inter',sans-serif] flex flex-col justify-between selection:bg-[#D54000] selection:text-white relative overflow-x-hidden">

  <!-- Background Cinematic Image with Luxury Dark Overlays -->
  <div class="fixed inset-0 z-0 pointer-events-none">
    <img 
      src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=2000&q=80" 
      alt="Vehículo de Lujo" 
      class="w-full h-full object-cover opacity-25 filter scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-[#0a0f1d]/90 via-[#0a0f1d]/80 to-[#0a0f1d]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-orange-600/10 via-transparent to-transparent"></div>
  </div>

  <!-- Header Branding -->
  <header class="relative z-10 w-full max-w-7xl mx-auto px-6 py-6 sm:py-8 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-full bg-[#D54000] flex items-center justify-center text-white font-black text-lg shadow-lg shadow-orange-900/40">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 17a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4zM5 11l1.5-4.5A2 2 0 018.4 5h7.2a2 2 0 011.9 1.5L19 11M3 11h18v6H3v-6z"></path>
        </svg>
      </div>
      <div class="flex flex-col">
        <span class="text-2xl font-black tracking-tight uppercase text-white leading-none">
          TUCARRO<span class="text-[#D54000]">YMAS</span>
        </span>
        <span class="text-[9px] uppercase tracking-widest text-slate-400 font-bold mt-1">
          República Dominicana
        </span>
      </div>
    </div>

    <!-- Official Badge -->
    <div class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-white/5 border border-white/10 text-slate-300 backdrop-blur-md">
      <span class="w-2 h-2 rounded-full bg-[#D54000] animate-pulse"></span>
      <span>Lanzamiento Oficial 2026</span>
    </div>
  </header>

  <!-- Hero Content Center -->
  <main class="relative z-10 max-w-4xl mx-auto px-6 py-12 text-center my-auto flex flex-col items-center">
    
    <!-- Status Pill -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-xs font-bold uppercase tracking-widest bg-orange-500/10 text-[#D54000] border border-orange-500/30 mb-6 backdrop-blur-md">
      <i class="fa-solid fa-screwdriver-wrench text-xs"></i>
      <span>Estamos Preparando Algo Extraordinario</span>
    </div>

    <!-- Main Heading -->
    <h1 class="text-4xl sm:text-6xl md:text-7xl font-black text-white tracking-tight uppercase leading-[1.08] mb-6">
      Gran Apertura <br class="hidden sm:inline" />
      <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-slate-200 to-orange-400">
        Próximamente
      </span>
    </h1>

    <p class="text-base sm:text-lg text-slate-300 font-normal max-w-2xl mx-auto mb-10 leading-relaxed">
      La plataforma automotriz, de concesionarios oficiales, compra, venta e inventario multicategoría más moderna y rápida de República Dominicana está a punto de encender motores.
    </p>

    <!-- Countdown Timer -->
    <div class="grid grid-cols-4 gap-3 sm:gap-6 max-w-lg w-full mb-12">
      <div class="bg-slate-900/80 border border-white/10 backdrop-blur-md rounded-lg p-3 sm:p-4 text-center shadow-xl">
        <span id="days" class="block text-2xl sm:text-4xl font-black text-white font-mono">14</span>
        <span class="text-[10px] sm:text-xs uppercase font-bold text-slate-400 tracking-wider">Días</span>
      </div>
      <div class="bg-slate-900/80 border border-white/10 backdrop-blur-md rounded-lg p-3 sm:p-4 text-center shadow-xl">
        <span id="hours" class="block text-2xl sm:text-4xl font-black text-white font-mono">08</span>
        <span class="text-[10px] sm:text-xs uppercase font-bold text-slate-400 tracking-wider">Horas</span>
      </div>
      <div class="bg-slate-900/80 border border-white/10 backdrop-blur-md rounded-lg p-3 sm:p-4 text-center shadow-xl">
        <span id="minutes" class="block text-2xl sm:text-4xl font-black text-white font-mono">42</span>
        <span class="text-[10px] sm:text-xs uppercase font-bold text-slate-400 tracking-wider">Min</span>
      </div>
      <div class="bg-slate-900/80 border border-white/10 backdrop-blur-md rounded-lg p-3 sm:p-4 text-center shadow-xl">
        <span id="seconds" class="block text-2xl sm:text-4xl font-black text-[#D54000] font-mono">19</span>
        <span class="text-[10px] sm:text-xs uppercase font-bold text-slate-400 tracking-wider">Seg</span>
      </div>
    </div>

    <!-- Notification Subscription Box -->
    <div class="w-full max-w-md bg-white/5 border border-white/10 backdrop-blur-md p-2 rounded-lg shadow-2xl mb-6">
      <form id="notify-form" class="flex flex-col sm:flex-row gap-2">
        <input 
          type="email" 
          id="notify-email"
          placeholder="Ingresa tu correo electrónico..." 
          class="w-full bg-slate-950/80 text-white placeholder-slate-400 text-xs sm:text-sm px-4 py-3 rounded-md border border-white/10 focus:outline-none focus:border-[#D54000] focus:ring-1 focus:ring-[#D54000]"
          required
        />
        <button 
          type="submit" 
          class="bg-[#D54000] hover:bg-[#b83600] text-white font-black text-xs uppercase px-6 py-3 rounded-md tracking-wider transition-all whitespace-nowrap shadow-lg shadow-orange-900/30 flex items-center justify-center gap-1.5 cursor-pointer"
        >
          <span>Avisarme</span>
          <i class="fa-solid fa-bell text-xs"></i>
        </button>
      </form>
      <p id="notify-success" class="hidden text-xs text-emerald-400 font-semibold py-2">
        ✓ ¡Gracias! Te avisaremos en el momento exacto del lanzamiento.
      </p>
    </div>

    <p class="text-xs text-slate-400">
      ¿Eres concesionario o dealer y deseas registrar tu inventario prioritario? 
      <a href="https://wa.me/18295550199?text=Hola%2C%20deseo%20registrar%20mi%20dealer%20en%20TuCarroYMas" target="_blank" class="text-[#D54000] hover:underline font-bold inline-flex items-center gap-1">
        <i class="fa-brands fa-whatsapp"></i> Hablar con Soporte
      </a>
    </p>

  </main>

  <!-- Footer -->
  <footer class="relative z-10 w-full max-w-7xl mx-auto px-6 py-6 text-center text-xs text-slate-500 border-t border-white/5">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
      <p>© 2026 TuCarroYMas. Todos los derechos reservados. República Dominicana.</p>
      <div class="flex items-center gap-4 text-slate-400">
        <span class="hover:text-white transition-colors cursor-pointer"><i class="fa-brands fa-facebook text-sm"></i></span>
        <span class="hover:text-white transition-colors cursor-pointer"><i class="fa-brands fa-instagram text-sm"></i></span>
        <span class="hover:text-white transition-colors cursor-pointer"><i class="fa-brands fa-tiktok text-sm"></i></span>
        <span class="hover:text-white transition-colors cursor-pointer"><i class="fa-brands fa-youtube text-sm"></i></span>
      </div>
    </div>
  </footer>

  <!-- Script: Countdown Timer & Email Form -->
  <script>
    // Configuración de la fecha de lanzamiento (14 días desde hoy)
    const launchDate = new Date();
    launchDate.setDate(launchDate.getDate() + 14);

    function updateCountdown() {
      const now = new Date().getTime();
      const distance = launchDate.getTime() - now;

      if (distance < 0) return;

      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);

      const daysEl = document.getElementById("days");
      const hoursEl = document.getElementById("hours");
      const minsEl = document.getElementById("minutes");
      const secsEl = document.getElementById("seconds");

      if (daysEl) daysEl.innerText = String(days).padStart(2, "0");
      if (hoursEl) hoursEl.innerText = String(hours).padStart(2, "0");
      if (minsEl) minsEl.innerText = String(minutes).padStart(2, "0");
      if (secsEl) secsEl.innerText = String(seconds).padStart(2, "0");
    }

    setInterval(updateCountdown, 1000);
    updateCountdown();

    // Formulario de notificación
    const form = document.getElementById("notify-form");
    const successMsg = document.getElementById("notify-success");
    const emailInput = document.getElementById("notify-email") as HTMLInputElement;

    if (form && successMsg && emailInput) {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = emailInput.value.trim();
        if (email) {
          try {
            const list = JSON.parse(localStorage.getItem("tucarroymas_subscribers") || "[]");
            list.push({ email, date: new Date().toISOString() });
            localStorage.setItem("tucarroymas_subscribers", JSON.stringify(list));
          } catch(err) {}

          form.classList.add("hidden");
          successMsg.classList.remove("hidden");
        }
      });
    }
  </script>

</body>
</html>

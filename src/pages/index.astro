---
import Layout from '../layouts/Layout.astro';
import VehicleSidebar from '../components/VehicleSidebar.astro';
import BookingModal from '../components/BookingModal.astro';
---

<Layout title="Tu Carro y Más Rent A Car | Alquiler de Autos en Santo Domingo">

    <!-- HERO CAROUSEL SECTION (100vh with carousel slide) -->
    <section class="relative p-0 overflow-hidden bg-black">
        <div class="relative w-full h-[90vh] min-h-[520px]">
            
            <!-- Slides Container -->
            <div id="hero-slider" class="relative w-full h-full">
                <!-- Slide 1 -->
                <div class="hero-item absolute inset-0 transition-opacity duration-700 opacity-100">
                    <img 
                        src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1920&q=80" 
                        alt="Carretera libre para viajar" 
                        class="w-full h-full object-cover filter brightness-[0.45]"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white px-4">
                        <span class="px-3.5 py-1 bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-sm">
                            Tu Carro y Más • Santo Domingo Este
                        </span>
                        <h1 class="text-3xl sm:text-5xl md:text-6xl font-black mb-4 drop-shadow-md leading-tight max-w-4xl font-['Outfit',sans-serif] uppercase tracking-tight">
                            Alquiler de Autos y SUVs en Santo Domingo
                        </h1>
                        <p class="text-base sm:text-xl md:text-2xl max-w-3xl mb-8 leading-relaxed drop-shadow font-light text-gray-100">
                            Experimenta la emoción de viajar seguro con nuestra flota premium verificada y reserva directa por WhatsApp.
                        </p>
                        <div class="flex flex-wrap justify-center gap-3">
                            <a href="#fleet" class="px-7 py-3.5 bg-[#1d4ed8] hover:bg-[#1e40af] text-white text-xs font-bold uppercase tracking-wider luxury-btn shadow-md">
                                Ver Autos en Renta
                            </a>
                            <a href="/publicar" class="px-7 py-3.5 bg-white/15 hover:bg-white/25 border border-white/40 text-white text-xs font-bold uppercase tracking-wider luxury-btn backdrop-blur-sm">
                                Publicar Mi Auto
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="hero-item absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                    <img 
                        src="https://images.unsplash.com/photo-1570737543098-0983d88f796d?q=80&w=1286&auto=format&fit=crop" 
                        alt="Carretera tropical en República Dominicana" 
                        class="w-full h-full object-cover filter brightness-[0.45]"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white px-4">
                        <span class="px-3.5 py-1 bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-sm">
                            Alquiler Seguro y Sin Intermediarios
                        </span>
                        <h2 class="text-3xl sm:text-5xl md:text-6xl font-black mb-4 drop-shadow-md leading-tight max-w-4xl font-['Outfit',sans-serif] uppercase tracking-tight">
                            Tu Viaje Comienza Aquí
                        </h2>
                        <p class="text-base sm:text-xl md:text-2xl max-w-3xl mb-8 leading-relaxed drop-shadow font-light text-gray-100">
                            Libertad para moverte por República Dominicana con comodidad, cobertura total y soporte 24/7.
                        </p>
                        <div>
                            <a href="#fleet" class="px-7 py-3.5 bg-[#1d4ed8] hover:bg-[#1e40af] text-white text-xs font-bold uppercase tracking-wider luxury-btn shadow-md">
                                Reservar Ahora
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="hero-item absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                    <img 
                        src="https://images.unsplash.com/photo-1485291571150-772bcfc10da5?auto=format&fit=crop&w=1920&q=80" 
                        alt="Auto de lujo interior" 
                        class="w-full h-full object-cover filter brightness-[0.45]"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white px-4">
                        <span class="px-3.5 py-1 bg-white/10 border border-white/20 text-white text-xs font-semibold uppercase tracking-widest mb-4 backdrop-blur-sm">
                            Conexión Directa por WhatsApp
                        </span>
                        <h2 class="text-3xl sm:text-5xl md:text-6xl font-black mb-4 drop-shadow-md leading-tight max-w-4xl font-['Outfit',sans-serif] uppercase tracking-tight">
                            Elegancia y Confort en Cada Kilómetro
                        </h2>
                        <p class="text-base sm:text-xl md:text-2xl max-w-3xl mb-8 leading-relaxed drop-shadow font-light text-gray-100">
                            SUVs y Jeepetas seleccionadas para quienes exigen excelencia, limpieza y puntualidad.
                        </p>
                        <div>
                            <a href="#fleet" class="px-7 py-3.5 bg-[#1d4ed8] hover:bg-[#1e40af] text-white text-xs font-bold uppercase tracking-wider luxury-btn shadow-md">
                                Ver Flota
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Left & Right Arrow Navigation -->
            <button id="slider-prev" type="button" aria-label="Anterior" class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-colors">
                <i class="fas fa-chevron-left text-base"></i>
            </button>
            <button id="slider-next" type="button" aria-label="Siguiente" class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 bg-black/40 hover:bg-black/70 text-white flex items-center justify-center transition-colors">
                <i class="fas fa-chevron-right text-base"></i>
            </button>

            <!-- Bottom Slide Indicators -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2">
                <button class="slide-dot w-8 h-1 bg-white transition-all duration-300" data-idx="0"></button>
                <button class="slide-dot w-3 h-1 bg-white/50 transition-all duration-300" data-idx="1"></button>
                <button class="slide-dot w-3 h-1 bg-white/50 transition-all duration-300" data-idx="2"></button>
            </div>

        </div>
    </section>

    <!-- SECTION: BUSCADOR DINÁMICO DE RENTA (Estilo JetBooking) -->
    <div class="relative z-30 max-w-[1240px] mx-auto px-4 -mt-16 mb-6">
        <div class="bg-white border-2 border-slate-900 shadow-2xl p-6 sm:p-8 luxury-card">
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-end">
                <!-- Location Field -->
                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-2" for="search-location">
                        <i class="fas fa-map-marker-alt text-[#1d4ed8] me-1"></i> Lugar de Entrega
                    </label>
                    <select id="search-location" class="w-full text-xs font-semibold p-3.5 bg-slate-50 border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                        <option value="all">Cualquier Zona (Santo Domingo)</option>
                        <option value="sde">Santo Domingo Este</option>
                        <option value="sdq">Aeropuerto Las Américas (SDQ)</option>
                        <option value="dn">Distrito Nacional</option>
                    </select>
                </div>

                <!-- Pick-up Date -->
                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-2" for="search-date-start">
                        <i class="fas fa-calendar-alt text-[#1d4ed8] me-1"></i> Fecha de Entrega
                    </label>
                    <input 
                        type="date" 
                        id="search-date-start" 
                        class="w-full text-xs font-semibold p-3 bg-slate-50 border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8]"
                    />
                </div>

                <!-- Drop-off Date -->
                <div>
                    <label class="block text-[11px] font-bold uppercase tracking-wider text-slate-700 mb-2" for="search-date-end">
                        <i class="fas fa-calendar-check text-[#1d4ed8] me-1"></i> Devolución
                    </label>
                    <input 
                        type="date" 
                        id="search-date-end" 
                        class="w-full text-xs font-semibold p-3 bg-slate-50 border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8]"
                    />
                </div>

                <!-- Action CTA -->
                <div>
                    <button 
                        type="button" 
                        id="search-submit-btn" 
                        class="w-full py-4 px-6 bg-[#1d4ed8] hover:bg-[#1e40af] text-white font-bold text-xs uppercase tracking-wider luxury-btn shadow-md flex items-center justify-center gap-2"
                    >
                        <i class="fas fa-search"></i>
                        <span>Buscar Autos</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION: ¿POR QUÉ ELEGIRNOS? -->
    <section id="features" class="py-16 bg-[#f8fafc] border-b border-slate-200">
        <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <span class="text-xs font-bold uppercase tracking-widest text-[#1d4ed8] mb-2 block">Ventajas de Nuestra Plataforma</span>
            <h2 class="text-3xl font-bold text-[#0f172a] mb-12 uppercase font-['Outfit',sans-serif]">¿Por Qué Elegirnos?</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Feature 1 -->
                <div class="bg-white p-8 border border-slate-200 shadow-xs hover:border-[#1d4ed8] transition-colors text-center luxury-card">
                    <i class="fas fa-calendar-check text-4xl text-[#1d4ed8] mb-4"></i>
                    <h3 class="text-lg font-bold text-[#0f172a] mb-2 uppercase">Reserva Fácil</h3>
                    <p class="text-slate-500 text-xs leading-relaxed">Reserva tu auto en segundos comunicándote de forma directa con el dueño por WhatsApp.</p>
                </div>

                <!-- Feature 2 -->
                <div class="bg-white p-8 border border-slate-200 shadow-xs hover:border-[#1d4ed8] transition-colors text-center luxury-card">
                    <i class="fas fa-shield-alt text-4xl text-[#1d4ed8] mb-4"></i>
                    <h3 class="text-lg font-bold text-[#0f172a] mb-2 uppercase">Seguro Completo</h3>
                    <p class="text-slate-500 text-xs leading-relaxed">Nuestros vehículos cuentan con cobertura incluida para viajar seguro por todo el país.</p>
                </div>

                <!-- Feature 3 -->
                <div class="bg-white p-8 border border-slate-200 shadow-xs hover:border-[#1d4ed8] transition-colors text-center luxury-card">
                    <i class="fas fa-headset text-4xl text-[#1d4ed8] mb-4"></i>
                    <h3 class="text-lg font-bold text-[#0f172a] mb-2 uppercase">Soporte 24/7</h3>
                    <p class="text-slate-500 text-xs leading-relaxed">Asistencia continua y apoyo local en Santo Domingo Este ante cualquier emergencia.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION: NUESTRA FLOTA PREMIUM (Realtime Firestore Grid) -->
    <section id="fleet" class="py-16 bg-white">
        <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <span class="text-xs font-bold uppercase tracking-widest text-[#1d4ed8] mb-1 block">Vehículos Verificados</span>
                <h2 class="text-3xl font-bold text-[#0f172a] mb-2 uppercase font-['Outfit',sans-serif]">Nuestra Flota Premium</h2>
                <p class="text-slate-500 text-sm">Las mejores SUVs y Jeepetas en Santo Domingo.</p>
            </div>

            <!-- FILTROS FACETADOS ESTILO JETSMARTFILTERS -->
            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 mb-8 pb-4 border-b border-slate-100">
                <!-- Category Tabs -->
                <div class="flex flex-wrap gap-2" id="filter-category-container">
                    <button type="button" class="filter-cat-btn px-4 py-2 text-xs font-bold uppercase tracking-wider bg-[#0f172a] text-white luxury-btn" data-category="all">
                        Todos
                    </button>
                    <button type="button" class="filter-cat-btn px-4 py-2 text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-700 hover:bg-slate-200 luxury-btn" data-category="SUV">
                        SUVs / Jeepetas
                    </button>
                    <button type="button" class="filter-cat-btn px-4 py-2 text-xs font-bold uppercase tracking-wider bg-slate-100 text-slate-700 hover:bg-slate-200 luxury-btn" data-category="Premium">
                        Alta Gama
                    </button>
                </div>

                <!-- Sort Dropdown -->
                <div class="flex items-center gap-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-slate-400">Ordenar:</span>
                    <select id="filter-sort" class="text-xs font-semibold p-2 bg-slate-50 border border-slate-200 text-slate-700 focus:outline-none focus:border-[#1d4ed8]">
                        <option value="recent">Más recientes</option>
                        <option value="price-asc">Precio: Menor a Mayor</option>
                        <option value="price-desc">Precio: Mayor a Menor</option>
                    </select>
                </div>
            </div>

            <!-- Vehicles Dynamic Grid (Realtime from Firestore) -->
            <div id="fleet-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full">
                <!-- Loading Skeletons -->
                <div class="bg-white border border-slate-200 p-4 animate-pulse space-y-4">
                    <div class="h-64 bg-slate-100"></div>
                    <div class="h-6 bg-slate-100 w-1/2"></div>
                    <div class="h-4 bg-slate-100 w-1/3"></div>
                </div>
                <div class="bg-white border border-slate-200 p-4 animate-pulse space-y-4">
                    <div class="h-64 bg-slate-100"></div>
                    <div class="h-6 bg-slate-100 w-1/2"></div>
                    <div class="h-4 bg-slate-100 w-1/3"></div>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="text-center mt-12 flex flex-wrap justify-center gap-4">
                <a href="/flota" class="px-7 py-3.5 bg-[#1d4ed8] hover:bg-[#1e40af] text-white text-xs font-bold uppercase tracking-wider luxury-btn shadow-sm">
                    <i class="fas fa-car me-1.5"></i> Ver Toda la Flota
                </a>
                <a href="/publicar" class="px-7 py-3.5 border border-slate-300 text-slate-700 hover:text-[#1d4ed8] hover:border-[#1d4ed8] text-xs font-bold uppercase tracking-wider luxury-btn">
                    <i class="fas fa-plus me-1.5"></i> Publicar Mi Auto
                </a>
            </div>

        </div>
    </section>

    <!-- SECTION: PREGUNTAS FRECUENTES (FAQ & AEO Structured Engine) -->
    <section class="py-16 bg-[#f8fafc] border-t border-slate-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <span class="text-xs font-bold uppercase tracking-widest text-[#1d4ed8] mb-1 block">Claridad Total</span>
                <h2 class="text-3xl font-black text-[#0f172a] uppercase font-['Outfit',sans-serif] tracking-tight">Preguntas Frecuentes</h2>
                <p class="text-slate-500 text-sm mt-2">Todo lo que necesitas saber antes de rentar tu vehículo con nosotros.</p>
            </div>

            <div class="space-y-4">
                <!-- FAQ 1 -->
                <div class="bg-white border border-slate-200 p-6 shadow-xs">
                    <h3 class="font-bold text-base text-[#0f172a] flex items-center gap-3">
                        <i class="fas fa-id-card text-[#1d4ed8]"></i>
                        ¿Cuáles son los requisitos para alquilar un vehículo?
                    </h3>
                    <p class="text-slate-600 text-sm mt-3 leading-relaxed">
                        Solo necesitas tu licencia de conducir vigente (nacional o de tu país de origen), documento de identidad o pasaporte, y ser mayor de 21 años. El proceso de verificación es rápido y sin papeleos engorrosos.
                    </p>
                </div>

                <!-- FAQ 2 -->
                <div class="bg-white border border-slate-200 p-6 shadow-xs">
                    <h3 class="font-bold text-base text-[#0f172a] flex items-center gap-3">
                        <i class="fas fa-plane-arrival text-[#1d4ed8]"></i>
                        ¿Hacen entregas en el Aeropuerto Internacional Las Américas (SDQ)?
                    </h3>
                    <p class="text-slate-600 text-sm mt-3 leading-relaxed">
                        Sí. Coordinamos la entrega y recepción directamente en el aeropuerto SDQ o en cualquier punto de Santo Domingo Este para que tengas tu vehículo listo en cuanto aterrices.
                    </p>
                </div>

                <!-- FAQ 3 -->
                <div class="bg-white border border-slate-200 p-6 shadow-xs">
                    <h3 class="font-bold text-base text-[#0f172a] flex items-center gap-3">
                        <i class="fab fa-whatsapp text-[#15803d]"></i>
                        ¿Cómo funciona la reserva y confirmación por WhatsApp?
                    </h3>
                    <p class="text-slate-600 text-sm mt-3 leading-relaxed">
                        Al seleccionar el vehículo en nuestra plataforma y presionar el botón de WhatsApp, te comunicarás de forma directa con el propietario o administrador. Acuerdan las fechas, tarifas y entrega al instante sin comisiones ocultas.
                    </p>
                </div>

                <!-- FAQ 4 -->
                <div class="bg-white border border-slate-200 p-6 shadow-xs">
                    <h3 class="font-bold text-base text-[#0f172a] flex items-center gap-3">
                        <i class="fas fa-shield-alt text-[#1d4ed8]"></i>
                        ¿El alquiler incluye seguro y asistencia vial?
                    </h3>
                    <p class="text-slate-600 text-sm mt-3 leading-relaxed">
                        Todos nuestros vehículos cuentan con seguro de cobertura de ley al día y asistencia de soporte 24/7 en Santo Domingo y carreteras dominicanas.
                    </p>
                </div>
            </div>

            <!-- FAQ Schema JSON-LD for Search Engines and AI answers -->
            <script type="application/ld+json" set:html={JSON.stringify({
              "@context": "https://schema.org",
              "@type": "FAQPage",
              "mainEntity": [
                {
                  "@type": "Question",
                  "name": "¿Cuáles son los requisitos para alquilar un vehículo?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Licencia de conducir vigente, documento de identidad o pasaporte, y ser mayor de 21 años. El proceso de verificación es directo y sin burocracia."
                  }
                },
                {
                  "@type": "Question",
                  "name": "¿Hacen entregas en el Aeropuerto Internacional Las Américas (SDQ)?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Sí, coordinamos entregas y recepciones directas en el Aeropuerto Internacional Las Américas (SDQ) y en todo Santo Domingo Este."
                  }
                },
                {
                  "@type": "Question",
                  "name": "¿Cómo funciona la reserva y confirmación por WhatsApp?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Al presionar el botón de WhatsApp de cada vehículo te comunicas directamente con el dueño para convenir fechas y entrega al instante."
                  }
                },
                {
                  "@type": "Question",
                  "name": "¿El alquiler incluye seguro y asistencia vial?",
                  "acceptedAnswer": {
                    "@type": "Answer",
                    "text": "Todos los autos cuentan con seguro de cobertura de ley y soporte local 24/7."
                  }
                }
              ]
            })} />
        </div>
    </section>

    <!-- Interactive Sidebar Drawer & RentGo Modal Pop-up -->
    <VehicleSidebar />
    <BookingModal />

</Layout>

<script>
    import { collection, onSnapshot, query, orderBy, doc, getDoc } from "firebase/firestore";
    import { db } from "../lib/firebase/client";

    // CAROUSEL LOGIC
    const slides = document.querySelectorAll<HTMLElement>('.hero-item');
    const dots = document.querySelectorAll<HTMLElement>('.slide-dot');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    let currentIdx = 0;

    function goToSlide(idx: number) {
        slides.forEach((s, i) => {
            if (i === idx) {
                s.classList.remove('opacity-0', 'pointer-events-none');
                s.classList.add('opacity-100');
            } else {
                s.classList.remove('opacity-100');
                s.classList.add('opacity-0', 'pointer-events-none');
            }
        });
        dots.forEach((d, i) => {
            if (i === idx) {
                d.classList.remove('w-3', 'bg-white/50');
                d.classList.add('w-8', 'bg-white');
            } else {
                d.classList.remove('w-8', 'bg-white');
                d.classList.add('w-3', 'bg-white/50');
            }
        });
        currentIdx = idx;
    }

    prevBtn?.addEventListener('click', () => {
        goToSlide((currentIdx - 1 + slides.length) % slides.length);
    });
    nextBtn?.addEventListener('click', () => {
        goToSlide((currentIdx + 1) % slides.length);
    });
    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const i = parseInt(dot.getAttribute('data-idx') || '0', 10);
            goToSlide(i);
        });
    });

    setInterval(() => {
        goToSlide((currentIdx + 1) % slides.length);
    }, 3800);

    // RENTGO MODAL REFERENCES (JetPopup Pattern)
    const rentgoModal = document.getElementById('rentgo-booking-modal');
    const rentgoBackdrop = document.getElementById('rentgo-modal-backdrop');
    const rentgoCard = document.getElementById('rentgo-modal-card');
    const rentgoClose = document.getElementById('rentgo-modal-close');

    const mImg = document.getElementById('rentgo-modal-img') as HTMLImageElement;
    const mCategory = document.getElementById('rentgo-modal-category');
    const mTitle = document.getElementById('rentgo-modal-title');
    const mCity = document.getElementById('rentgo-modal-city');
    const mRate = document.getElementById('rentgo-modal-rate');
    const mSeats = document.getElementById('rentgo-modal-seats');
    const mLuggage = document.getElementById('rentgo-modal-luggage');
    const mTrans = document.getElementById('rentgo-modal-trans');
    const mFuel = document.getElementById('rentgo-modal-fuel');

    const mDateStart = document.getElementById('rentgo-date-start') as HTMLInputElement;
    const mDateEnd = document.getElementById('rentgo-date-end') as HTMLInputElement;
    const mDaysBadge = document.getElementById('rentgo-modal-days-badge');
    const mCalcText = document.getElementById('rentgo-modal-calc-text');
    const mTotal = document.getElementById('rentgo-modal-total');
    const mWhatsappBtn = document.getElementById('rentgo-modal-whatsapp-btn') as HTMLAnchorElement;
    const mBtnLabel = document.getElementById('rentgo-modal-btn-label');

    let activeModalPrice = 50;
    let activeModalTitle = 'Vehículo';
    let activeModalCleanPhone = '18499154010';

    function updateModalQuote() {
        if (!mDateStart || !mDateEnd || !mDaysBadge || !mCalcText || !mTotal || !mWhatsappBtn) return;
        const start = new Date(mDateStart.value);
        const end = new Date(mDateEnd.value);

        let diffDays = Math.ceil((end.getTime() - start.getTime()) / (1000 * 3600 * 24));
        if (isNaN(diffDays) || diffDays < 1) diffDays = 1;

        const total = diffDays * activeModalPrice;
        mDaysBadge.textContent = `${diffDays} día${diffDays > 1 ? 's' : ''}`;
        mCalcText.textContent = `$${activeModalPrice} USD x ${diffDays} día${diffDays > 1 ? 's' : ''}`;
        mTotal.textContent = `$${total} USD`;

        const datesFormatted = `desde ${mDateStart.value} hasta ${mDateEnd.value}`;
        const calculatedMsg = encodeURIComponent(
            `Hola Rent A Car, me interesa reservar la ${activeModalTitle} ${datesFormatted} (${diffDays} días). Total estimado: $${total} USD. ¿Tienen disponibilidad inmediata para entrega?`
        );
        mWhatsappBtn.href = `https://wa.me/${activeModalCleanPhone}?text=${calculatedMsg}`;
        if (mBtnLabel) mBtnLabel.textContent = `Confirmar Reserva (${diffDays} días: $${total} USD)`;
    }

    function openRentgoModal(vehicle: any, owner: any) {
        if (!rentgoModal || !rentgoBackdrop || !rentgoCard) return;

        activeModalPrice = vehicle.pricePerDay || vehicle.price || 50;
        activeModalTitle = vehicle.title;

        const rawPhone = owner?.whatsapp || owner?.phone || vehicle.ownerWhatsapp || '18499154010';
        activeModalCleanPhone = rawPhone.replace(/\D/g, '');

        if (mCategory) mCategory.textContent = vehicle.category || 'SUV';
        if (mImg) mImg.src = vehicle.title.includes("Honda") ? "/Honda.webp" : vehicle.title.includes("Jeep") ? "/Jeep.webp" : (vehicle.mainImage || "/Honda.webp");
        if (mTitle) mTitle.textContent = vehicle.title;
        if (mCity) mCity.querySelector('span')!.textContent = vehicle.city || 'Santo Domingo Este, República Dominicana';
        if (mRate) mRate.textContent = `$${activeModalPrice}`;
        if (mSeats) mSeats.textContent = `${vehicle.seats || 5} Plazas`;
        if (mLuggage) mLuggage.textContent = vehicle.luggage || (vehicle.seats > 5 ? '4-5 Maletas' : '3-4 Maletas');
        if (mTrans) mTrans.textContent = vehicle.transmission === 'manual' ? 'Manual' : 'Automática';
        if (mFuel) mFuel.textContent = vehicle.fuelType || 'Gasolina';

        if (mDateStart && searchStart) mDateStart.value = searchStart.value || formatInputDate(today);
        if (mDateEnd && searchEnd) mDateEnd.value = searchEnd.value || formatInputDate(futureDate);

        updateModalQuote();

        rentgoModal.classList.remove('pointer-events-none', 'opacity-0');
        rentgoModal.classList.add('pointer-events-auto', 'opacity-100');
        rentgoBackdrop.classList.remove('opacity-0');
        rentgoBackdrop.classList.add('opacity-100');
        rentgoCard.classList.remove('scale-95');
        rentgoCard.classList.add('scale-100');
        document.body.classList.add('overflow-hidden');
    }

    function closeRentgoModal() {
        if (!rentgoModal || !rentgoBackdrop || !rentgoCard) return;
        rentgoCard.classList.remove('scale-100');
        rentgoCard.classList.add('scale-95');
        rentgoBackdrop.classList.remove('opacity-100');
        rentgoBackdrop.classList.add('opacity-0');
        setTimeout(() => {
            rentgoModal.classList.remove('pointer-events-auto', 'opacity-100');
            rentgoModal.classList.add('pointer-events-none', 'opacity-0');
            document.body.classList.remove('overflow-hidden');
        }, 250);
    }

    mDateStart?.addEventListener('change', updateModalQuote);
    mDateEnd?.addEventListener('change', updateModalQuote);
    rentgoClose?.addEventListener('click', closeRentgoModal);
    rentgoBackdrop?.addEventListener('click', closeRentgoModal);

    // SIDEBAR REFERENCES
    const fleetGrid = document.getElementById('fleet-grid');
    const offcanvas = document.getElementById('vehicle-offcanvas');
    const backdrop = document.getElementById('offcanvas-backdrop');
    const panel = document.getElementById('offcanvas-panel');
    const closeBtn = document.getElementById('close-offcanvas-btn');

    const sCategory = document.getElementById('sidebar-category');
    const sMainImg = document.getElementById('sidebar-main-img') as HTMLImageElement;
    const sGalleryThumbs = document.getElementById('sidebar-gallery-thumbs');
    const sTitle = document.getElementById('sidebar-title');
    const sLocation = document.getElementById('sidebar-location');
    const sPrice = document.getElementById('sidebar-price');
    const sSeats = document.getElementById('sidebar-seats');
    const sLuggage = document.getElementById('sidebar-luggage');
    const sTransmission = document.getElementById('sidebar-transmission');
    const sFuel = document.getElementById('sidebar-fuel');
    const sDescription = document.getElementById('sidebar-description');
    const sOwnerName = document.getElementById('sidebar-owner-name');
    const sOwnerPhone = document.getElementById('sidebar-owner-phone');
    const sWhatsappBtn = document.getElementById('sidebar-whatsapp-btn') as HTMLAnchorElement;

    // Stream vehicles from Firestore & Filter Engine
    let allVehicles: any[] = [];
    let currentCategory = 'all';
    let currentSort = 'recent';

    // Date calculations state
    const today = new Date();
    const futureDate = new Date();
    futureDate.setDate(today.getDate() + 3);

    const formatInputDate = (d: Date) => d.toISOString().split('T')[0];

    const searchStart = document.getElementById('search-date-start') as HTMLInputElement;
    const searchEnd = document.getElementById('search-date-end') as HTMLInputElement;
    const searchSubmit = document.getElementById('search-submit-btn');

    if (searchStart && searchEnd) {
        searchStart.value = formatInputDate(today);
        searchEnd.value = formatInputDate(futureDate);
    }

    searchSubmit?.addEventListener('click', () => {
        const fleetSec = document.getElementById('fleet');
        fleetSec?.scrollIntoView({ behavior: 'smooth' });
    });

    // Calculator inputs inside Sidebar
    const sDateStart = document.getElementById('sidebar-date-start') as HTMLInputElement;
    const sDateEnd = document.getElementById('sidebar-date-end') as HTMLInputElement;
    const sDaysCount = document.getElementById('sidebar-days-count');
    const sRateBreakdown = document.getElementById('sidebar-rate-breakdown');
    const sTotalEstimate = document.getElementById('sidebar-total-estimate');

    let activeVehiclePrice = 50;
    let activeVehicleTitle = 'SUV';

    function updateRentalCalculation(cleanPhone: string) {
        if (!sDateStart || !sDateEnd || !sDaysCount || !sRateBreakdown || !sTotalEstimate) return;
        const start = new Date(sDateStart.value);
        const end = new Date(sDateEnd.value);

        let diffDays = Math.ceil((end.getTime() - start.getTime()) / (1000 * 3600 * 24));
        if (isNaN(diffDays) || diffDays < 1) diffDays = 1;

        const total = diffDays * activeVehiclePrice;
        sDaysCount.textContent = `${diffDays} día${diffDays > 1 ? 's' : ''}`;
        sRateBreakdown.textContent = `$${activeVehiclePrice} x ${diffDays} día${diffDays > 1 ? 's' : ''}`;
        sTotalEstimate.textContent = `$${total} USD`;

        const datesFormatted = `desde ${sDateStart.value} hasta ${sDateEnd.value}`;
        const calculatedMsg = encodeURIComponent(
            `Hola, me interesa reservar la ${activeVehicleTitle} ${datesFormatted} (${diffDays} días). Total estimado: $${total} USD. ¿Tienen disponibilidad?`
        );
        if (sWhatsappBtn) {
            sWhatsappBtn.href = `https://wa.me/${cleanPhone}?text=${calculatedMsg}`;
            sWhatsappBtn.querySelector('span')!.textContent = `Reservar (${diffDays} días: $${total} USD)`;
        }
    }

    function openSidebar(vehicle: any, owner: any) {
        if (!offcanvas || !panel || !backdrop) return;

        activeVehiclePrice = vehicle.pricePerDay || vehicle.price || 50;
        activeVehicleTitle = vehicle.title;

        if (sCategory) sCategory.textContent = vehicle.category || 'SUV';
        if (sMainImg) sMainImg.src = vehicle.title.includes("Honda") ? "/Honda.webp" : vehicle.title.includes("Jeep") ? "/Jeep.webp" : vehicle.mainImage;
        if (sTitle) sTitle.textContent = vehicle.title;
        if (sLocation) sLocation.querySelector('span')!.textContent = vehicle.city || 'Santo Domingo Este';
        if (sPrice) sPrice.textContent = `$${activeVehiclePrice}`;
        if (sSeats) sSeats.textContent = `${vehicle.seats || 5} Asientos`;
        if (sLuggage) sLuggage.textContent = vehicle.luggage || (vehicle.seats > 5 ? '4-5 Maletas' : '3-4 Maletas');
        if (sTransmission) sTransmission.textContent = vehicle.transmission === 'manual' ? 'Manual' : 'Automática';
        if (sFuel) sFuel.textContent = vehicle.fuelType || 'Gasolina';
        if (sDescription) sDescription.textContent = vehicle.description || `Vehículo ${vehicle.title} disponible para renta en Santo Domingo.`;

        const ownerName = owner?.fullName || vehicle.ownerName || 'Tu Carro y Más';
        const rawPhone = owner?.whatsapp || owner?.phone || vehicle.ownerWhatsapp || '18499154010';
        const cleanPhone = rawPhone.replace(/\D/g, '');

        if (sOwnerName) sOwnerName.textContent = ownerName;
        if (sOwnerPhone) sOwnerPhone.textContent = `+${cleanPhone}`;

        // Sync with Hero dates if present
        if (sDateStart && searchStart) sDateStart.value = searchStart.value || formatInputDate(today);
        if (sDateEnd && searchEnd) sDateEnd.value = searchEnd.value || formatInputDate(futureDate);

        updateRentalCalculation(cleanPhone);

        sDateStart?.addEventListener('change', () => updateRentalCalculation(cleanPhone));
        sDateEnd?.addEventListener('change', () => updateRentalCalculation(cleanPhone));

        // Thumbnails (SQUARE 1:1)
        if (sGalleryThumbs) {
            sGalleryThumbs.innerHTML = '';
            const imgs = vehicle.images && vehicle.images.length > 0 ? vehicle.images : [vehicle.mainImage];
            imgs.forEach((imgUrl: string) => {
                const thumb = document.createElement('img');
                thumb.src = vehicle.title.includes("Honda") ? "/Honda.webp" : vehicle.title.includes("Jeep") ? "/Jeep.webp" : imgUrl;
                thumb.className = 'w-16 h-16 object-contain bg-white border border-slate-200 hover:border-[#1d4ed8] cursor-pointer shrink-0';
                thumb.addEventListener('click', () => { if (sMainImg) sMainImg.src = thumb.src; });
                sGalleryThumbs.appendChild(thumb);
            });
        }

        offcanvas.classList.remove('pointer-events-none', 'opacity-0');
        offcanvas.classList.add('pointer-events-auto', 'opacity-100');
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        panel.classList.remove('translate-x-full');
        document.body.classList.add('overflow-hidden');
    }

    function renderFleet() {
        if (!fleetGrid) return;
        fleetGrid.innerHTML = '';

        let filtered = [...allVehicles];

        // Filter by category
        if (currentCategory !== 'all') {
            filtered = filtered.filter(v => (v.category || '').toLowerCase() === currentCategory.toLowerCase());
        }

        // Sort
        if (currentSort === 'price-asc') {
            filtered.sort((a, b) => (a.pricePerDay || a.price || 0) - (b.pricePerDay || b.price || 0));
        } else if (currentSort === 'price-desc') {
            filtered.sort((a, b) => (b.pricePerDay || b.price || 0) - (a.pricePerDay || a.price || 0));
        }

        if (filtered.length === 0) {
            fleetGrid.innerHTML = `
                <div class="col-span-full text-center py-12 bg-slate-50 border border-slate-200 p-8">
                    <i class="fas fa-car text-3xl text-slate-300 mb-3"></i>
                    <p class="text-sm font-bold text-slate-700 uppercase">No hay vehículos en esta categoría</p>
                    <p class="text-xs text-slate-500 mt-1">Prueba seleccionando "Todos" para ver todas las unidades disponibles.</p>
                </div>
            `;
            return;
        }

        filtered.forEach(({ v, ownerData }) => {
            const cleanPhone = (ownerData?.whatsapp || v.ownerWhatsapp || '18499154010').replace(/\D/g, '');
            const msg = encodeURIComponent(`Hola, me interesa reservar la ${v.title}`);
            const badgeColor = v.category === 'Premium' ? 'bg-[#0f172a] text-white' : 'bg-[#1d4ed8] text-white';
            const carImg = v.title.includes("Honda") ? "/Honda.webp" : v.title.includes("Jeep") ? "/Jeep.webp" : (v.mainImage || "/Honda.webp");
            const price = v.pricePerDay || v.price || 50;

            const card = document.createElement('div');
            card.className = "luxury-card flex flex-col justify-between overflow-hidden group";
            card.innerHTML = `
                <div>
                    <!-- Car Image Container with Agency Badges -->
                    <div class="car-image-container relative">
                        <img src="${carImg}" alt="${v.title}" />
                        <div class="absolute top-3 left-3 flex flex-col gap-1.5 z-10">
                            <span class="px-2.5 py-1 text-[10px] font-black uppercase tracking-wider ${badgeColor} shadow-md">
                                ${v.category || 'SUV'}
                            </span>
                            <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider bg-black/75 backdrop-blur-md text-emerald-400 border border-emerald-500/30">
                                <i class="fas fa-bolt me-1"></i> Reserva Inmediata
                            </span>
                        </div>
                        <div class="absolute bottom-3 right-3 px-3 py-1 bg-white/95 backdrop-blur-md border border-slate-200 text-slate-900 shadow-sm">
                            <span class="text-xs font-bold text-slate-400">DESDE</span>
                            <strong class="text-base font-black text-[#1d4ed8] font-mono">$${price}</strong>
                            <span class="text-[10px] font-bold text-slate-500 uppercase">/día</span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 sm:p-6">
                        <div class="flex justify-between items-start mb-1.5">
                            <h4 class="text-xl font-bold text-[#0f172a] tracking-tight group-hover:text-[#1d4ed8] transition-colors">${v.title}</h4>
                        </div>
                        <p class="text-xs text-slate-500 flex items-center gap-1 mb-3">
                            <i class="fas fa-map-marker-alt text-[#1d4ed8] text-[11px]"></i>
                            <span>${v.city || 'Santo Domingo Este'}</span>
                            <span class="mx-1">•</span>
                            <span class="text-emerald-700 font-semibold"><i class="fas fa-check-circle text-[10px]"></i> Verificado</span>
                        </p>
                        <p class="text-slate-500 text-xs mb-4 line-clamp-2 leading-relaxed">
                            ${v.description || 'Color ' + (v.color || 'Elegante') + '. Confort para familia o negocios.'}
                        </p>

                        <!-- RentGo Specs 4-Pill Row -->
                        <div class="grid grid-cols-4 gap-1.5 text-center text-xs text-slate-700 bg-slate-50 border border-slate-200 p-2.5 mb-5">
                            <div title="Capacidad de Pasajeros">
                                <i class="fas fa-user-friends text-[#1d4ed8] text-xs block mb-0.5"></i>
                                <span class="text-[10px] font-bold text-slate-800">${v.seats || 5}</span>
                            </div>
                            <div title="Espacio de Maletas">
                                <i class="fas fa-suitcase-rolling text-[#1d4ed8] text-xs block mb-0.5"></i>
                                <span class="text-[10px] font-bold text-slate-800">${v.seats > 5 ? '4-5' : '3-4'}</span>
                            </div>
                            <div title="Transmisión">
                                <i class="fas fa-cogs text-[#1d4ed8] text-xs block mb-0.5"></i>
                                <span class="text-[10px] font-bold text-slate-800">${(v.transmission || 'auto').slice(0, 4).toUpperCase()}</span>
                            </div>
                            <div title="Combustible">
                                <i class="fas fa-gas-pump text-[#1d4ed8] text-xs block mb-0.5"></i>
                                <span class="text-[10px] font-bold text-slate-800">${(v.fuelType || 'Gas').slice(0, 4)}</span>
                            </div>
                        </div>

                        <!-- CTA Actions (Double CTA: RentGo Booking Pop-up & Fast WhatsApp) -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                            <button 
                              type="button" 
                              class="open-modal-btn w-full py-3 px-3 bg-[#1d4ed8] hover:bg-[#1e40af] text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 luxury-btn shadow-sm"
                              style="border-radius: 0px !important;"
                            >
                                <i class="fas fa-calendar-check text-sm"></i>
                                <span>Cotizar / Reservar</span>
                            </button>
                            <a 
                              href="https://wa.me/${cleanPhone}?text=${msg}" 
                              target="_blank" 
                              rel="noopener noreferrer" 
                              class="whatsapp-btn w-full py-3 px-3 bg-[#15803d] hover:bg-[#166534] text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-1.5 transition-colors luxury-btn"
                              style="border-radius: 0px !important;"
                            >
                                <i class="fab fa-whatsapp text-base"></i>
                                <span>WhatsApp</span>
                            </a>
                        </div>
                        <button 
                          type="button" 
                          class="view-sidebar-btn w-full mt-2 py-1.5 text-[11px] text-slate-400 hover:text-slate-700 font-semibold text-center uppercase tracking-wider"
                        >
                            <i class="fas fa-info-circle me-1"></i> Ver Ficha Completa
                        </button>
                    </div>
                </div>
            `;

            // CTA Handlers
            const modalBtn = card.querySelector('.open-modal-btn');
            modalBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                openRentgoModal(v, ownerData);
            });

            const sidebarBtn = card.querySelector('.view-sidebar-btn');
            sidebarBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                openSidebar(v, ownerData);
            });

            card.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                if (target.closest('.whatsapp-btn') || target.closest('.open-modal-btn') || target.closest('.view-sidebar-btn')) return;
                openRentgoModal(v, ownerData);
            });

            fleetGrid.appendChild(card);
        });
    }

    // Category button clicks (JetSmartFilters UI)
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.filter-cat-btn');
    catButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            catButtons.forEach(b => {
                b.classList.remove('bg-[#0f172a]', 'text-white');
                b.classList.add('bg-slate-100', 'text-slate-700');
            });
            btn.classList.remove('bg-slate-100', 'text-slate-700');
            btn.classList.add('bg-[#0f172a]', 'text-white');
            currentCategory = btn.getAttribute('data-category') || 'all';
            renderFleet();
        });
    });

    // Sort changes
    const sortSelect = document.getElementById('filter-sort') as HTMLSelectElement;
    sortSelect?.addEventListener('change', () => {
        currentSort = sortSelect.value;
        renderFleet();
    });

    function closeSidebar() {
        if (!offcanvas || !panel || !backdrop) return;
        panel.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        setTimeout(() => {
            offcanvas.classList.remove('pointer-events-auto', 'opacity-100');
            offcanvas.classList.add('pointer-events-none', 'opacity-0');
            document.body.classList.remove('overflow-hidden');
        }, 300);
    }

    closeBtn?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', closeSidebar);
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSidebar(); });

    // Stream vehicles from Firestore
    const q = query(collection(db, "vehicles"), orderBy("createdAt", "desc"));
    onSnapshot(q, async (snap) => {
        allVehicles = [];

        for (const docSnap of snap.docs) {
            const v = docSnap.data();
            v.id = docSnap.id;

            let ownerData: any = null;
            if (v.ownerId) {
                try {
                    const uSnap = await getDoc(doc(db, "users", v.ownerId));
                    if (uSnap.exists()) ownerData = uSnap.data();
                } catch (e) {
                    console.warn(e);
                }
            }
            allVehicles.push({ v, ownerData });
        }

        renderFleet();
    });
</script>

---
import Layout from '../layouts/Layout.astro';
import VehicleSidebar from '../components/VehicleSidebar.astro';
---

<Layout title="Tu Carro y Más Rent A Car | Alquiler de Autos en Santo Domingo">

    <!-- HERO CAROUSEL SECTION (Identical visual structure and timing to tucarroymas.com) -->
    <section class="relative p-0 overflow-hidden bg-black">
        <div class="relative w-full h-[85vh] min-h-[500px]">
            
            <!-- Slides Container -->
            <div id="hero-slider" class="relative w-full h-full">
                <!-- Slide 1 -->
                <div class="hero-item absolute inset-0 transition-opacity duration-700 opacity-100">
                    <img 
                        src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=1920&q=80" 
                        alt="Carretera libre para viajar" 
                        class="w-full h-full object-cover filter brightness-50"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white px-4">
                        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold mb-4 drop-shadow-md leading-tight max-w-4xl">
                            Conduce lo Extraordinario
                        </h1>
                        <p class="text-base sm:text-xl md:text-2xl max-w-2xl mb-8 leading-relaxed drop-shadow font-normal text-gray-100">
                            Experimenta la emoción de la carretera con nuestros vehículos premium.
                        </p>
                        <div class="flex flex-wrap justify-center gap-3">
                            <a href="/flota" class="px-6 py-3 rounded-full bg-[#0d6efd] hover:bg-[#0b5ed7] text-white font-medium text-base transition-colors shadow">
                                Ver Autos
                            </a>
                            <a href="/nosotros" class="px-6 py-3 rounded-full bg-transparent hover:bg-white/20 border border-white text-white font-medium text-base transition-colors">
                                Más Info
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Slide 2 -->
                <div class="hero-item absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                    <img 
                        src="https://images.unsplash.com/photo-1570737543098-0983d88f796d?q=80&w=1286&auto=format&fit=crop" 
                        alt="Carretera tropical en República Dominicana" 
                        class="w-full h-full object-cover filter brightness-50"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white px-4">
                        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold mb-4 drop-shadow-md leading-tight max-w-4xl">
                            Tu Viaje Comienza Aquí
                        </h1>
                        <p class="text-base sm:text-xl md:text-2xl max-w-2xl mb-8 leading-relaxed drop-shadow font-normal text-gray-100">
                            Libertad para moverte por República Dominicana con comodidad y seguridad.
                        </p>
                        <div>
                            <a href="/flota" class="px-6 py-3 rounded-full bg-[#0d6efd] hover:bg-[#0b5ed7] text-white font-medium text-base transition-colors shadow">
                                Reservar Ahora
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Slide 3 -->
                <div class="hero-item absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                    <img 
                        src="https://images.unsplash.com/photo-1485291571150-772bcfc10da5?auto=format&fit=crop&w=1920&q=80" 
                        alt="Auto de lujo interior" 
                        class="w-full h-full object-cover filter brightness-50"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center items-center text-center text-white px-4">
                        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold mb-4 drop-shadow-md leading-tight max-w-4xl">
                            Elegancia en Cada Kilómetro
                        </h1>
                        <p class="text-base sm:text-xl md:text-2xl max-w-2xl mb-8 leading-relaxed drop-shadow font-normal text-gray-100">
                            Vehículos seleccionados para quienes exigen lo mejor.
                        </p>
                        <div>
                            <a href="/flota" class="px-6 py-3 rounded-full bg-[#0d6efd] hover:bg-[#0b5ed7] text-white font-medium text-base transition-colors shadow">
                                Ver Flota
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Left & Right Arrow Navigation -->
            <button id="slider-prev" type="button" aria-label="Anterior" class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/30 hover:bg-black/60 text-white flex items-center justify-center transition-colors">
                <i class="fas fa-chevron-left text-lg"></i>
            </button>
            <button id="slider-next" type="button" aria-label="Siguiente" class="absolute right-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full bg-black/30 hover:bg-black/60 text-white flex items-center justify-center transition-colors">
                <i class="fas fa-chevron-right text-lg"></i>
            </button>

            <!-- Bottom Slide Indicators -->
            <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-2">
                <button class="slide-dot w-8 h-1.5 bg-white rounded-full transition-all duration-300" data-idx="0"></button>
                <button class="slide-dot w-3 h-1.5 bg-white/50 rounded-full transition-all duration-300" data-idx="1"></button>
                <button class="slide-dot w-3 h-1.5 bg-white/50 rounded-full transition-all duration-300" data-idx="2"></button>
            </div>

        </div>
    </section>

    <!-- SECTION: ¿POR QUÉ ELEGIRNOS? (Identical to reference screenshot) -->
    <section class="py-16 bg-[#f8f9fa]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-3xl font-bold text-[#212529] mb-12">¿Por Qué Elegirnos?</h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Feature 1 -->
                <div class="bg-white p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
                    <i class="fas fa-calendar-check feature-icon-box"></i>
                    <h3 class="text-xl font-bold text-[#212529] mb-2">Reserva Fácil</h3>
                    <p class="text-gray-500 text-sm">Reserva tu auto en segundos por WhatsApp.</p>
                </div>

                <!-- Feature 2 -->
                <div class="bg-white p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
                    <i class="fas fa-shield-alt feature-icon-box"></i>
                    <h3 class="text-xl font-bold text-[#212529] mb-2">Seguro Completo</h3>
                    <p class="text-gray-500 text-sm">Nuestros vehículos cuentan con cobertura incluida.</p>
                </div>

                <!-- Feature 3 -->
                <div class="bg-white p-8 rounded-lg shadow-sm hover:shadow-md transition-shadow text-center">
                    <i class="fas fa-headset feature-icon-box"></i>
                    <h3 class="text-xl font-bold text-[#212529] mb-2">Soporte 24/7</h3>
                    <p class="text-gray-500 text-sm">Estamos aquí para ayudarte ante cualquier emergencia.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION: NUESTRA FLOTA PREMIUM (Identical design to user screenshot) -->
    <section class="py-16 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2 class="text-3xl font-bold text-[#212529] mb-2">Nuestra Flota Premium</h2>
                <p class="text-gray-500 text-base">Las mejores SUVs y Jeepetas en Santo Domingo.</p>
            </div>

            <!-- Vehicles Dynamic Grid (Realtime from Firestore) -->
            <div id="fleet-grid" class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
                <!-- Loading Skeletons -->
                <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-4 animate-pulse">
                    <div class="h-64 bg-gray-100 rounded mb-4"></div>
                    <div class="h-6 bg-gray-100 rounded w-1/2 mb-2"></div>
                    <div class="h-4 bg-gray-100 rounded w-1/3 mb-4"></div>
                    <div class="h-10 bg-gray-100 rounded"></div>
                </div>
                <div class="bg-white rounded-lg border border-gray-100 shadow-sm p-4 animate-pulse">
                    <div class="h-64 bg-gray-100 rounded mb-4"></div>
                    <div class="h-6 bg-gray-100 rounded w-1/2 mb-2"></div>
                    <div class="h-4 bg-gray-100 rounded w-1/3 mb-4"></div>
                    <div class="h-10 bg-gray-100 rounded"></div>
                </div>
            </div>

            <!-- Botón Ver Toda la Flota y Publicar -->
            <div class="text-center mt-12 flex flex-wrap justify-center gap-4">
                <a href="/flota" class="inline-flex items-center gap-2 px-8 py-3 rounded-full bg-[#0d6efd] hover:bg-[#0b5ed7] text-white font-semibold text-sm transition-colors shadow">
                    <i class="fas fa-car"></i> Ver Toda la Flota
                </a>
                <a href="/publicar" class="inline-flex items-center gap-2 px-8 py-3 rounded-full border border-[#0d6efd] text-[#0d6efd] hover:bg-[#0d6efd] hover:text-white font-semibold text-sm transition-colors">
                    <i class="fas fa-plus-circle"></i> Publicar Mi Auto
                </a>
            </div>

        </div>
    </section>

    <!-- Interactive Sidebar Drawer -->
    <VehicleSidebar />

</Layout>

<script>
    import { collection, onSnapshot, query, orderBy, doc, getDoc } from "firebase/firestore";
    import { db } from "../lib/firebase/client";

    // CAROUSEL LOGIC (3500ms like original bootstrap config)
    const slides = document.querySelectorAll<HTMLElement>('.hero-item');
    const dots = document.querySelectorAll<HTMLElement>('.slide-dot');
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    let currentIdx = 0;

    function goToSlide(idx: number) {
        slides.forEach((s, i) => {
            if (i === idx) {
                s.classList.remove('opacity-0', 'pointer-events-none');
                s.classList.add('opacity-100');
            } else {
                s.classList.remove('opacity-100');
                s.classList.add('opacity-0', 'pointer-events-none');
            }
        });
        dots.forEach((d, i) => {
            if (i === idx) {
                d.classList.remove('w-3', 'bg-white/50');
                d.classList.add('w-8', 'bg-white');
            } else {
                d.classList.remove('w-8', 'bg-white');
                d.classList.add('w-3', 'bg-white/50');
            }
        });
        currentIdx = idx;
    }

    prevBtn?.addEventListener('click', () => {
        goToSlide((currentIdx - 1 + slides.length) % slides.length);
    });
    nextBtn?.addEventListener('click', () => {
        goToSlide((currentIdx + 1) % slides.length);
    });
    dots.forEach((dot) => {
        dot.addEventListener('click', () => {
            const i = parseInt(dot.getAttribute('data-idx') || '0', 10);
            goToSlide(i);
        });
    });

    setInterval(() => {
        goToSlide((currentIdx + 1) % slides.length);
    }, 3500);

    // REALTIME VEHICLES STREAM & SIDEBAR BINDING
    const fleetGrid = document.getElementById('fleet-grid');

    // Sidebar references
    const offcanvas = document.getElementById('vehicle-offcanvas');
    const backdrop = document.getElementById('offcanvas-backdrop');
    const panel = document.getElementById('offcanvas-panel');
    const closeBtn = document.getElementById('close-offcanvas-btn');

    const sCategory = document.getElementById('sidebar-category');
    const sMainImg = document.getElementById('sidebar-main-img') as HTMLImageElement;
    const sGalleryThumbs = document.getElementById('sidebar-gallery-thumbs');
    const sTitle = document.getElementById('sidebar-title');
    const sLocation = document.getElementById('sidebar-location');
    const sPrice = document.getElementById('sidebar-price');
    const sSeats = document.getElementById('sidebar-seats');
    const sLuggage = document.getElementById('sidebar-luggage');
    const sTransmission = document.getElementById('sidebar-transmission');
    const sFuel = document.getElementById('sidebar-fuel');
    const sDescription = document.getElementById('sidebar-description');
    const sOwnerPhoto = document.getElementById('sidebar-owner-photo') as HTMLImageElement;
    const sOwnerName = document.getElementById('sidebar-owner-name');
    const sOwnerPhone = document.getElementById('sidebar-owner-phone');
    const sWhatsappBtn = document.getElementById('sidebar-whatsapp-btn') as HTMLAnchorElement;

    function openSidebar(vehicle: any, owner: any) {
        if (!offcanvas || !panel || !backdrop) return;

        if (sCategory) sCategory.textContent = vehicle.category || 'SUV';
        if (sMainImg) sMainImg.src = vehicle.mainImage || '/Honda.webp';
        if (sTitle) sTitle.textContent = vehicle.title;
        if (sLocation) sLocation.querySelector('span')!.textContent = vehicle.city || 'Santo Domingo Este';
        if (sPrice) sPrice.textContent = `$${vehicle.pricePerDay || vehicle.price || 0}`;
        if (sSeats) sSeats.textContent = `${vehicle.seats || 5} Asientos`;
        if (sLuggage) sLuggage.textContent = vehicle.luggage || (vehicle.seats > 5 ? '4-5 Maletas' : '3-4 Maletas');
        if (sTransmission) sTransmission.textContent = vehicle.transmission === 'manual' ? 'Manual' : 'Automática';
        if (sFuel) sFuel.textContent = vehicle.fuelType || 'Gasolina';
        if (sDescription) sDescription.textContent = vehicle.description || `Vehículo ${vehicle.title} disponible para renta en Santo Domingo.`;

        const ownerName = owner?.fullName || vehicle.ownerName || 'Tu Carro y Más';
        const rawPhone = owner?.whatsapp || owner?.phone || vehicle.ownerWhatsapp || '18499154010';
        const cleanPhone = rawPhone.replace(/\D/g, '');
        const photoUrl = owner?.photoUrl || vehicle.ownerPhoto || 'https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&w=400&q=80';

        if (sOwnerName) sOwnerName.textContent = ownerName;
        if (sOwnerPhone) sOwnerPhone.textContent = `+${cleanPhone}`;
        if (sOwnerPhoto) sOwnerPhoto.src = photoUrl;

        const defaultMsg = encodeURIComponent(`Hola, me interesa reservar la ${vehicle.title}`);
        if (sWhatsappBtn) {
            sWhatsappBtn.href = `https://wa.me/${cleanPhone}?text=${defaultMsg}`;
            sWhatsappBtn.querySelector('span')!.textContent = `Reservar ${vehicle.model || vehicle.title} por WhatsApp`;
        }

        // Thumbnails
        if (sGalleryThumbs) {
            sGalleryThumbs.innerHTML = '';
            const imgs = vehicle.images && vehicle.images.length > 0 ? vehicle.images : [vehicle.mainImage];
            imgs.forEach((imgUrl: string) => {
                const thumb = document.createElement('img');
                thumb.src = imgUrl;
                thumb.className = 'w-16 h-12 object-cover rounded border border-gray-200 hover:border-[#0d6efd] cursor-pointer shrink-0';
                thumb.addEventListener('click', () => { if (sMainImg) sMainImg.src = imgUrl; });
                sGalleryThumbs.appendChild(thumb);
            });
        }

        offcanvas.classList.remove('pointer-events-none', 'opacity-0');
        offcanvas.classList.add('pointer-events-auto', 'opacity-100');
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        panel.classList.remove('translate-x-full');
        document.body.classList.add('overflow-hidden');
    }

    function closeSidebar() {
        if (!offcanvas || !panel || !backdrop) return;
        panel.classList.add('translate-x-full');
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        setTimeout(() => {
            offcanvas.classList.remove('pointer-events-auto', 'opacity-100');
            offcanvas.classList.add('pointer-events-none', 'opacity-0');
            document.body.classList.remove('overflow-hidden');
        }, 300);
    }

    closeBtn?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', closeSidebar);
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeSidebar(); });

    // Stream vehicles from Firestore
    const q = query(collection(db, "vehicles"), orderBy("createdAt", "desc"));
    onSnapshot(q, async (snap) => {
        if (!fleetGrid) return;
        fleetGrid.innerHTML = '';

        for (const docSnap of snap.docs) {
            const v = docSnap.data();
            v.id = docSnap.id;

            let ownerData: any = null;
            if (v.ownerId) {
                try {
                    const uSnap = await getDoc(doc(db, "users", v.ownerId));
                    if (uSnap.exists()) ownerData = uSnap.data();
                } catch (e) {
                    console.warn(e);
                }
            }

            const cleanPhone = (ownerData?.whatsapp || v.ownerWhatsapp || '18499154010').replace(/\D/g, '');
            const msg = encodeURIComponent(`Hola, me interesa reservar la ${v.title}`);
            const badgeColor = v.category === 'Premium' ? 'bg-[#212529] text-white' : 'bg-[#0d6efd] text-white';

            const card = document.createElement('div');
            card.className = "card-clean bg-white flex flex-col justify-between overflow-hidden cursor-pointer";
            card.innerHTML = `
                <div>
                    <!-- Car Image Container (Exact style) -->
                    <div class="car-image-container">
                        <img src="${v.mainImage}" alt="${v.title}" />
                    </div>

                    <!-- Card Body -->
                    <div class="p-6">
                        <div class="flex justify-between items-center mb-2">
                            <h4 class="text-xl font-bold text-[#212529] mb-0">${v.title}</h4>
                            <span class="px-2.5 py-0.5 rounded text-xs font-semibold ${badgeColor}">
                                ${v.category || 'SUV'}
                            </span>
                        </div>
                        <p class="text-gray-500 text-sm mb-4 leading-normal">
                            ${v.description || 'Color ' + (v.color || 'Elegante') + '. Confort para familia o negocios.'}
                        </p>

                        <!-- Specs Row -->
                        <div class="grid grid-cols-2 text-center text-sm text-[#333] border-t border-b border-gray-100 py-3 mb-5">
                            <div class="border-r border-gray-200">
                                <i class="fas fa-user text-[#0d6efd] me-1"></i> ${v.seats || 5} Asientos
                            </div>
                            <div>
                                <i class="fas fa-suitcase text-[#0d6efd] me-1"></i> ${v.luggage || (v.seats > 5 ? '4-5 Maletas' : '3-4 Maletas')}
                            </div>
                        </div>

                        <!-- Direct WhatsApp Button (Exact green from original site) -->
                        <div class="space-y-2">
                            <a href="https://wa.me/${cleanPhone}?text=${msg}" target="_blank" rel="noopener noreferrer" class="whatsapp-btn w-full py-3 px-4 rounded-lg bg-[#198754] hover:bg-[#157347] text-white font-semibold text-base flex items-center justify-center gap-2 transition-colors">
                                <i class="fab fa-whatsapp text-lg"></i>
                                <span>Reservar ${v.model || v.title}</span>
                            </a>
                            <button type="button" class="view-details-btn w-full py-2 text-xs text-gray-500 hover:text-[#0d6efd] font-medium text-center">
                                <i class="fas fa-info-circle me-1"></i> Ver Ficha Técnica y Propietario
                            </button>
                        </div>
                    </div>
                </div>
            `;

            // Click card or "Ver Ficha" opens sidebar
            card.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                if (target.closest('.whatsapp-btn')) return; // let direct link work
                openSidebar(v, ownerData);
            });

            fleetGrid.appendChild(card);
        }
    });
</script>

---
import Layout from "../layouts/Layout.astro";
import { TRANSPORT_TYPES } from "../lib/carDealerData";
import { DEMO_VEHICLES_SEED } from "../lib/carDealerSeed";
import { ALL_DOMINICAN_BRANDS } from "../lib/brandsData";
import { VEHICLE_STYLES } from "../lib/vehicleStyles";

// 6 Anuncios Recientes
const recentAds = DEMO_VEHICLES_SEED.slice(0, 6);

// 3 Anuncios VIP (Sección oscura)
const vipAds = [
  DEMO_VEHICLES_SEED[2], // Toyota RAV4
  DEMO_VEHICLES_SEED[0], // Toyota Camry
  DEMO_VEHICLES_SEED[1]  // Tesla Model 3
];

// Marcas populares en portada (15 marcas líderes de RD para cuadrícula perfecta de 5 columnas x 3 filas)
const popularBrandsHomepage = ALL_DOMINICAN_BRANDS.slice(0, 15);

// Duplicamos los estilos para un loop infinito suave sin saltos
const loopedVehicleStyles = [...VEHICLE_STYLES, ...VEHICLE_STYLES];
---

<Layout title="TuCarroYMas | Compra. Vende. Intercambia Vehículos en República Dominicana">
  
  <!-- 1. HERO SECTION: "Compra. Vende. Intercambia" con buscador Crocoblock exacto en español -->
  <section class="relative min-h-[440px] flex items-center justify-center py-16 px-4 bg-slate-900 overflow-hidden">
    <!-- Hero Car Dashboard Background -->
    <div class="absolute inset-0 z-0">
      <img 
        src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=2000&q=80" 
        alt="Tablero de Vehículo" 
        class="w-full h-full object-cover opacity-60"
      />
      <div class="absolute inset-0 bg-slate-950/40"></div>
    </div>

    <div class="relative z-10 max-w-6xl mx-auto w-full">
      <h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight mb-8">
        Compra. Vende. Intercambia
      </h1>

      <!-- Barra de Filtros CarDealer: 4 selectores superiores + 3 sliders inferiores + Botón naranja "Buscar" -->
      <div class="bg-slate-900/70 backdrop-blur-md p-6 border border-white/10 rounded-sm shadow-2xl">
        <form action="/vehiculos" method="GET">
          <!-- Fila 1: 4 Selectores (Tipo de Transporte, Marca, Modelo, Carrocería) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
            <div>
              <label class="block text-[11px] uppercase tracking-wider font-bold text-slate-300 mb-1.5">
                Tipo de Transporte
              </label>
              <select name="type" class="w-full bg-white text-slate-800 text-xs py-2 px-3 rounded-sm border-0 focus:ring-2 focus:ring-[#D54000]">
                <option value="">Todos (Autos, Botes, Camiones...)</option>
                {TRANSPORT_TYPES.map(t => (
                  <option value={t.id}>{t.nameEs}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-[11px] uppercase tracking-wider font-bold text-slate-300 mb-1.5">
                Marca
              </label>
              <select name="make" class="w-full bg-white text-slate-800 text-xs py-2 px-3 rounded-sm border-0 focus:ring-2 focus:ring-[#D54000]">
                <option value="">Todas</option>
                {ALL_DOMINICAN_BRANDS.map(b => (
                  <option value={b.name}>{b.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-[11px] uppercase tracking-wider font-bold text-slate-300 mb-1.5">
                Modelo
              </label>
              <input 
                type="text" 
                name="model" 
                placeholder="Ej. Camry, RAV4, Cascadia..."
                class="w-full bg-white text-slate-800 text-xs py-2 px-3 rounded-sm border-0 focus:ring-2 focus:ring-[#D54000]"
              />
            </div>

            <div>
              <label class="block text-[11px] uppercase tracking-wider font-bold text-slate-300 mb-1.5">
                Carrocería / Estilo
              </label>
              <select name="body" class="w-full bg-white text-slate-800 text-xs py-2 px-3 rounded-sm border-0 focus:ring-2 focus:ring-[#D54000]">
                <option value="">Cualquiera</option>
                <option value="sedan">Sedán</option>
                <option value="suv">SUV / Jeepeta</option>
                <option value="camioneta">Camioneta / Pickup</option>
                <option value="boats">Bote / Lancha Marina</option>
                <option value="pesado">Cabezote / 18-Wheeler</option>
                <option value="deportivo">Coupé / Deportivo</option>
              </select>
            </div>
          </div>

          <!-- Fila 2: 3 Sliders (Precio, Año, Cilindrada) + Botón Naranja "Buscar" -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 items-end">
            <div>
              <div class="flex justify-between text-[11px] font-bold text-slate-300 mb-1">
                <span>Precio (USD)</span>
                <span class="text-white font-mono">$10,000 - $150,000</span>
              </div>
              <input type="range" name="maxPrice" min="10000" max="150000" value="150000" class="w-full accent-[#D54000] h-1.5 bg-slate-700 rounded-lg cursor-pointer" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] font-bold text-slate-300 mb-1">
                <span>Año de Fabricación</span>
                <span class="text-white font-mono">1990 - 2026</span>
              </div>
              <input type="range" min="1990" max="2026" value="2026" class="w-full accent-[#D54000] h-1.5 bg-slate-700 rounded-lg cursor-pointer" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] font-bold text-slate-300 mb-1">
                <span>Cilindrada / Motor</span>
                <span class="text-white font-mono">0.6 - 15.0 L</span>
              </div>
              <input type="range" min="6" max="150" value="150" class="w-full accent-[#D54000] h-1.5 bg-slate-700 rounded-lg cursor-pointer" />
            </div>

            <div>
              <button 
                type="submit" 
                class="w-full bg-[#D54000] hover:bg-[#b83600] text-white font-bold text-xs uppercase py-2.5 px-4 rounded-sm tracking-wider shadow transition-all flex items-center justify-center gap-1.5 cursor-pointer"
              >
                Buscar
              </button>
            </div>
          </div>
        </form>
      </div>

    </div>
  </section>

  <!-- 2. EXPLORAR POR ESTILO / TIPO DE VEHÍCULO (Carrusel Sin Bordes / Borde Eliminado con Autoplay Infinito y Pausa on Hover) -->
  <section class="py-12 px-4 bg-white border-b border-slate-100 relative">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-6">
        <div>
          <h2 class="text-xl font-black text-slate-900">
            Explorar Vehículos por Estilo
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Encuentra el vehículo perfecto según su tipo de carrocería, botes y tracción.</p>
        </div>
        <div class="flex items-center gap-2">
          <!-- Controles manuales opcionales -->
          <button 
            id="styles-prev-btn" 
            type="button" 
            aria-label="Anterior estilo"
            class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#D54000] hover:text-white hover:bg-[#D54000] text-slate-600 flex items-center justify-center transition-all cursor-pointer shadow-sm"
          >
            &larr;
          </button>
          <button 
            id="styles-next-btn" 
            type="button" 
            aria-label="Siguiente estilo"
            class="w-8 h-8 rounded-full border border-slate-200 hover:border-[#D54000] hover:text-white hover:bg-[#D54000] text-slate-600 flex items-center justify-center transition-all cursor-pointer shadow-sm"
          >
            &rarr;
          </button>
        </div>
      </div>

      <!-- Carrusel Track: SIN BORDER/STROKE EN LAS TARJETAS (Completamente limpio) -->
      <div 
        id="styles-carousel-track" 
        class="flex items-stretch gap-6 overflow-x-auto pb-4 pt-1 no-scrollbar select-none"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {loopedVehicleStyles.map(style => (
          <a 
            href={style.id === "boats" ? "/vehiculos?type=water-transport" : `/vehiculos?body=${style.id}`}
            class="style-card shrink-0 w-[180px] sm:w-[200px] flex flex-col items-center justify-between p-2 rounded-sm transition-transform duration-200 hover:-translate-y-1 text-center cursor-pointer bg-transparent border-0"
          >
            <!-- Graphic Image (SVGs exactos con círculo azul claro detrás, sin bordes en el cuadro) -->
            <div class="w-full h-24 flex items-center justify-center mb-2">
              <img 
                src={style.image} 
                alt={style.nameEs} 
                class="w-full max-h-20 object-contain hover:scale-105 transition-transform duration-200 pointer-events-none" 
                loading="lazy"
              />
            </div>
            
            <div class="mt-1 w-full">
              <span class="block text-xs font-bold text-slate-800 hover:text-[#D54000] transition-colors leading-tight truncate">
                {style.nameEs}
              </span>
              <span class="text-[10px] text-slate-400 font-medium truncate block">
                {style.name}
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. ANUNCIOS RECIENTES (Tarjetas blancas con precio naranja e iconos de especificaciones) -->
  <section class="py-12 px-4 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl font-black text-slate-900">
          Anuncios Recientes
        </h2>
        <a href="/vehiculos" class="text-xs font-bold text-blue-500 hover:text-blue-600 flex items-center gap-1">
          Ver más &rarr;
        </a>
      </div>

      <!-- Grid 3x2 -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {recentAds.map(item => (
          <div class="bg-white border border-slate-200 rounded-sm overflow-hidden hover:shadow-lg transition-all flex flex-col justify-between group">
            <div>
              <div class="relative h-44 overflow-hidden bg-slate-100">
                <img 
                  src={item.imageUrl} 
                  alt={item.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <button type="button" class="absolute top-2.5 right-2.5 w-7 h-7 bg-white/90 rounded-sm flex items-center justify-center text-slate-700 shadow-sm hover:bg-white">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"></path></svg>
                </button>
              </div>

              <div class="p-4">
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700 truncate">
                  {item.title}
                </h3>
                
                <div class="mt-1 text-base font-black text-[#D54000]">
                  ${item.price.toLocaleString()} <span class="text-xs font-normal text-slate-400">USD</span>
                </div>

                <div class="mt-3 pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
                    {item.transmission.split(" ")[0]}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                    {item.fuelType}
                  </span>
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    {item.mileageOrHours.split(" ")[0]}
                  </span>
                </div>
              </div>
            </div>

            <div class="p-4 pt-0">
              <a 
                href={`/vehiculo/${item.id}`}
                class="w-full bg-[#D54000] hover:bg-[#b83600] text-white font-bold text-xs py-2 px-3 rounded-sm flex items-center justify-center transition-colors text-center cursor-pointer"
              >
                Ver más
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. ANUNCIOS VIP (Sección oscura en #1c120b con badge VIP amarillo) -->
  <section class="py-14 px-4 bg-[#1c120b] text-white">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <h2 class="text-xl font-black text-white">
          Anuncios VIP
        </h2>
        <a href="/vehiculos" class="text-xs font-bold text-orange-400 hover:text-orange-300 flex items-center gap-1">
          Ver más &rarr;
        </a>
      </div>

      <div class="relative">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {vipAds.map(item => (
            <div class="bg-[#291b11] border border-orange-950/60 rounded-sm overflow-hidden flex flex-col justify-between group">
              <div>
                <div class="relative h-44 overflow-hidden bg-slate-900">
                  <img 
                    src={item.imageUrl} 
                    alt={item.title} 
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                  <div class="absolute top-2.5 left-2.5 bg-[#f59e0b] text-slate-950 font-black text-[10px] uppercase px-2 py-0.5 rounded-sm flex items-center gap-1 shadow-sm">
                    <span>★</span> VIP
                  </div>
                </div>

                <div class="p-4">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-white truncate">
                    {item.title}
                  </h3>
                  
                  <div class="mt-1 text-base font-black text-[#f59e0b]">
                    ${item.price.toLocaleString()} <span class="text-xs font-normal text-slate-400">USD</span>
                  </div>

                  <div class="mt-3 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-400">
                    <span class="flex items-center gap-1">{item.transmission.split(" ")[0]}</span>
                    <span class="flex items-center gap-1">{item.fuelType}</span>
                    <span class="flex items-center gap-1">{item.mileageOrHours.split(" ")[0]}</span>
                  </div>
                </div>
              </div>

              <div class="p-4 pt-0">
                <a 
                  href={`/vehiculo/${item.id}`}
                  class="w-full bg-[#D54000] hover:bg-[#b83600] text-white font-bold text-xs py-2 px-3 rounded-sm flex items-center justify-center transition-colors text-center cursor-pointer"
                >
                  Ver más
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 5. MARCAS POPULARES DE VEHÍCULOS (Con logos SVG nítidos y enlace a /brands) -->
  <section class="py-14 px-4 bg-white border-b border-slate-100">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center justify-between mb-8">
        <div>
          <h2 class="text-xl font-black text-slate-900">
            Marcas Populares de Vehículos
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">Marcas líderes con presencia oficial y repuestos en República Dominicana.</p>
        </div>
        <a href="/brands" class="text-xs font-bold text-blue-500 hover:text-blue-600 flex items-center gap-1">
          Ver todas las marcas &rarr;
        </a>
      </div>

      <!-- 15 marcas populares en cuadrícula exacta de 5 columnas -->
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4 sm:gap-6 text-center">
        {popularBrandsHomepage.map(b => (
          <a 
            href={`/vehiculos?make=${encodeURIComponent(b.name)}`} 
            class="flex flex-col items-center justify-center p-5 sm:p-6 border border-slate-200 hover:border-[#D54000] hover:shadow-xl rounded-sm transition-all group bg-white"
          >
            <div class="w-20 h-20 sm:w-24 sm:h-24 flex items-center justify-center mb-3">
              <img 
                src={b.logo} 
                alt={b.name} 
                class="max-w-[64px] max-h-[64px] sm:max-w-[72px] sm:max-h-[72px] object-contain opacity-85 group-hover:opacity-100 group-hover:scale-110 transition-all duration-200" 
                loading="lazy"
              />
            </div>
            <span class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-[#D54000] transition-colors leading-tight">
              {b.name}
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. BOLETÍN DE NOVEDADES (Sección azul marino oscuro con campo y botón naranja) -->
  <section class="py-14 px-4 bg-[#0d1424] text-white text-center">
    <div class="max-w-xl mx-auto">
      <h2 class="text-2xl font-black mb-1">
        ¡No te pierdas nuestras novedades!
      </h2>
      <p class="text-xs text-slate-400 mb-6">
        Recibe las últimas publicaciones de vehículos, precios actualizados del mercado y ofertas de concesionarios directamente en tu correo.
      </p>

      <form class="flex flex-col sm:flex-row items-center gap-2 max-w-md mx-auto">
        <input 
          type="email" 
          placeholder="Ingresa tu correo electrónico" 
          class="w-full bg-white text-slate-800 text-xs py-2.5 px-4 rounded-sm focus:outline-none"
          required
        />
        <button 
          type="submit" 
          class="w-full sm:w-auto bg-[#D54000] hover:bg-[#b83600] text-white font-bold text-xs uppercase py-2.5 px-6 rounded-sm whitespace-nowrap shadow transition-all cursor-pointer"
        >
          Suscribirme
        </button>
      </form>
    </div>
  </section>

</Layout>

<script>
  // Carrusel Infinito Continuo con Autoplay y Pausa on Hover
  const track = document.getElementById("styles-carousel-track");
  const prevBtn = document.getElementById("styles-prev-btn") as HTMLButtonElement;
  const nextBtn = document.getElementById("styles-next-btn") as HTMLButtonElement;

  if (track) {
    let isPaused = false;
    const speed = 1.2; // Velocidad suave continua para lectura cómoda

    // Intervalo de auto-scroll continuo (loop infinito)
    const timer = setInterval(() => {
      if (!isPaused) {
        track.scrollLeft += speed;
        // Cuando llega a la mitad del contenido duplicado, reinicia suavemente a 0
        if (track.scrollLeft >= track.scrollWidth / 2) {
          track.scrollLeft = 0;
        }
      }
    }, 25); // ~40 FPS para fluidez total

    // Pausa inmediata en Mouse Over y reanudación en Mouse Leave
    track.addEventListener("mouseenter", () => {
      isPaused = true;
    });

    track.addEventListener("mouseleave", () => {
      isPaused = false;
    });

    // Soporte táctil en móvil: pausar al tocar
    track.addEventListener("touchstart", () => {
      isPaused = true;
    }, { passive: true });

    track.addEventListener("touchend", () => {
      setTimeout(() => { isPaused = false; }, 2000);
    });

    // Controles manuales por si el usuario desea avanzar/retroceder manualmente
    if (prevBtn && nextBtn) {
      prevBtn.addEventListener("click", () => {
        track.scrollBy({ left: -260, behavior: "smooth" });
      });

      nextBtn.addEventListener("click", () => {
        track.scrollBy({ left: 260, behavior: "smooth" });
      });
    }
  }
</script>

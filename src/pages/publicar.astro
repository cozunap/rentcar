---
import Layout from '../layouts/Layout.astro';
import { DOMINICAN_PROVINCES, VEHICLE_BRANDS, VEHICLE_BODY_TYPES, FUEL_TYPES, TRANSMISSION_TYPES, DRIVETRAINS } from '../lib/constants';
---

<Layout 
  title="Publicar Vehículo en Venta o Renta | TuCarroYMás RD" 
  description="Publica tu vehículo gratis en República Dominicana para venta o renta. Conecta directamente con compradores y arrendatarios vía WhatsApp sin comisiones."
>
    <div class="py-12 bg-[#f8fafc] min-h-screen">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-400 mb-6">
                <a href="/" class="hover:text-[#1d4ed8]">Inicio</a>
                <span>/</span>
                <a href="/panel" class="hover:text-[#1d4ed8]">Mi Panel</a>
                <span>/</span>
                <span class="text-slate-800">Publicar Vehículo</span>
            </nav>

            <div class="bg-white border-2 border-slate-900 shadow-2xl overflow-hidden" style="border-radius: 0px !important;">
                
                <!-- Header Banner -->
                <div class="bg-[#0f172a] text-white p-8 sm:p-10 border-b border-slate-800">
                    <div class="flex flex-wrap items-center justify-between gap-3 mb-3">
                        <span class="px-3 py-1 bg-[#1d4ed8] text-white text-[10px] font-black uppercase tracking-widest">
                            Marketplace TuCarroYMás RD
                        </span>
                        <span class="px-2.5 py-1 bg-[#15803d] text-white text-[10px] font-bold uppercase tracking-wider">
                            <i class="fas fa-check-circle me-1"></i> Publicación 100% Gratuita
                        </span>
                    </div>
                    <h1 class="text-2xl sm:text-4xl font-black tracking-tight uppercase font-['Outfit',sans-serif]">
                        Publicar Vehículo en República Dominicana
                    </h1>
                    <p class="text-slate-300 text-sm mt-2 leading-relaxed max-w-2xl">
                        Vende tu carro o publícalo para renta en minutos. Nuestro sistema optimiza y cuadra automáticamente todas las fotos en formato WebP de alta definición (1500x1500px).
                    </p>
                </div>

                <!-- Formulario Dinámico (JetFormBuilder Pattern) -->
                <form id="vehicle-form" class="p-6 sm:p-10 space-y-8">
                    
                    <div id="form-alert" class="hidden p-4 text-xs font-medium border text-center"></div>

                    <!-- TIPO DE LISTADO: VENTA O RENTA -->
                    <div class="bg-slate-50 border border-slate-200 p-5 space-y-3">
                        <label class="block text-xs font-black uppercase tracking-wider text-[#0f172a]">
                            ¿Qué deseas hacer con tu vehículo? *
                        </label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <label class="cursor-pointer border-2 p-4 flex items-center gap-3.5 transition-all bg-white border-[#1d4ed8]" id="label-type-sale">
                                <input type="radio" name="listingType" value="sale" checked class="w-4 h-4 text-[#1d4ed8]" />
                                <div>
                                    <strong class="text-sm font-bold text-slate-900 block">Vender Mi Vehículo</strong>
                                    <span class="text-xs text-slate-500">Publicar en el catálogo de compra y venta gratuito de RD.</span>
                                </div>
                            </label>

                            <label class="cursor-pointer border-2 p-4 flex items-center gap-3.5 transition-all bg-white border-slate-200 hover:border-slate-300" id="label-type-rent">
                                <input type="radio" name="listingType" value="rent" class="w-4 h-4 text-[#1d4ed8]" />
                                <div>
                                    <strong class="text-sm font-bold text-slate-900 block">Poner en Renta (Rent A Car)</strong>
                                    <span class="text-xs text-slate-500">Alquiler por día con reservas directas vía WhatsApp.</span>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- PASO 1: FOTOS DEL VEHÍCULO -->
                    <div class="space-y-4">
                        <div class="border-b border-slate-200 pb-3">
                            <h2 class="text-sm font-black uppercase tracking-wider text-[#0f172a] flex items-center gap-2">
                                <i class="fas fa-camera text-[#1d4ed8]"></i>
                                <span>1. Fotos del Vehículo (Cuadradas 1500x1500px WebP)</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Cualquier imagen que subas se encuadrará automáticamente sin cortar esquinas.</p>
                        </div>

                        <!-- Foto Principal -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                <i class="fas fa-star text-amber-500 me-1"></i> Foto de Portada Principal *
                            </label>
                            <div id="main-dropzone" class="border-2 border-dashed border-slate-300 hover:border-[#1d4ed8] p-6 text-center cursor-pointer transition-colors bg-slate-50 hover:bg-blue-50/20">
                                <input type="file" id="main-image-input" accept="image/*" class="hidden" required />
                                <div id="main-prompt" class="space-y-2">
                                    <div class="w-12 h-12 bg-white text-[#1d4ed8] border border-slate-200 flex items-center justify-center mx-auto text-xl shadow-xs">
                                        <i class="fas fa-cloud-arrow-up"></i>
                                    </div>
                                    <p class="text-xs font-bold uppercase tracking-wider text-slate-700">Seleccionar Foto Principal</p>
                                    <p class="text-[11px] text-slate-400">JPG, PNG o WEBP. Conversión a 1500x1500px.</p>
                                </div>
                                <div id="main-preview-box" class="hidden space-y-3">
                                    <div class="w-48 h-48 mx-auto bg-white border border-slate-200 p-2 shadow-sm">
                                        <img id="main-preview-img" src="" alt="Vista previa principal" class="w-full h-full object-contain" />
                                    </div>
                                    <span id="main-status-text" class="text-xs font-bold text-emerald-700 block"></span>
                                    <button type="button" id="btn-change-main" class="px-3 py-1.5 text-[11px] font-bold uppercase tracking-wider text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 luxury-btn">
                                        Cambiar Foto
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Galería de Fotos Cuadradas -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                <i class="fas fa-images text-[#1d4ed8] me-1"></i> Galería Completa (Interior, motor, lateral, tablero - hasta 8 fotos)
                            </label>
                            <div class="flex items-center gap-3">
                                <label for="gallery-input" class="cursor-pointer inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-slate-300 text-slate-700 hover:text-[#1d4ed8] hover:border-[#1d4ed8] text-xs font-bold uppercase tracking-wider luxury-btn">
                                    <i class="fas fa-plus"></i> Añadir Fotos
                                </label>
                                <span id="gallery-count" class="text-xs text-slate-400 font-medium">0 fotos añadidas</span>
                                <input type="file" id="gallery-input" accept="image/*" multiple class="hidden" />
                            </div>
                            <div id="gallery-thumbs-grid" class="grid grid-cols-3 sm:grid-cols-6 gap-3 mt-4"></div>
                        </div>
                    </div>

                    <!-- PASO 2: ESPECIFICACIONES TÉCNICAS (ESTILO CARDEALER Y SUPERCARROS) -->
                    <div class="space-y-4 pt-4 border-t border-slate-200">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-sm font-black uppercase tracking-wider text-[#0f172a] flex items-center gap-2">
                                <i class="fas fa-sliders text-[#1d4ed8]"></i>
                                <span>2. Ficha Técnica y Especificaciones del Vehículo</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Los compradores en RD buscan principalmente motor, tracción, transmisión y kilometraje.</p>
                        </div>

                        <!-- Marca / Modelo / Año -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-brand">
                                    <i class="fas fa-certificate text-[#1d4ed8] me-1"></i> Marca *
                                </label>
                                <select id="v-brand" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    <option value="">Selecciona Marca</option>
                                    {VEHICLE_BRANDS.map(b => <option value={b}>{b}</option>)}
                                    <option value="Otra">Otra Marca</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-model">
                                    <i class="fas fa-car-side text-[#1d4ed8] me-1"></i> Modelo *
                                </label>
                                <input type="text" id="v-model" required placeholder="Ej: RAV4, CR-V, Hilux, Tucson" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-year">
                                    <i class="fas fa-calendar-alt text-[#1d4ed8] me-1"></i> Año *
                                </label>
                                <input type="number" id="v-year" required min="1995" max="2027" value="2021" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                        </div>

                        <!-- Tipo de Carrocería / Condición / Provincia -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-category">
                                    <i class="fas fa-shapes text-[#1d4ed8] me-1"></i> Tipo de Carrocería *
                                </label>
                                <select id="v-category" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    {VEHICLE_BODY_TYPES.map(t => <option value={t}>{t}</option>)}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-condition">
                                    <i class="fas fa-award text-[#1d4ed8] me-1"></i> Condición *
                                </label>
                                <select id="v-condition" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    <option value="Usado Importado (Recién Importado)">Usado Importado (Recién Importado)</option>
                                    <option value="Usado Local">Usado Local (Placa Dominicana)</option>
                                    <option value="Nuevo de Agencia">Nuevo de Agencia (0 Km)</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-province">
                                    <i class="fas fa-map-marker-alt text-[#1d4ed8] me-1"></i> Provincia / Ubicación *
                                </label>
                                <select id="v-province" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    {DOMINICAN_PROVINCES.map(p => <option value={p.name}>{p.name}</option>)}
                                </select>
                            </div>
                        </div>

                        <!-- MOTOR, KILOMETRAJE Y TRACCIÓN (Nivel SuperCarros & Cars.com) -->
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 bg-slate-50 p-4 border border-slate-200">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-engine">
                                    <i class="fas fa-gears text-[#1d4ed8] me-1"></i> Motor / Cilindrada *
                                </label>
                                <input type="text" id="v-engine" required placeholder="Ej: 2.0L 4 Cilindros Turbo / 3.5L V6" class="w-full px-4 py-2.5 bg-white border border-slate-300 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-mileage">
                                    <i class="fas fa-gauge-high text-[#1d4ed8] me-1"></i> Kilometraje / Millas *
                                </label>
                                <div class="flex">
                                    <input type="number" id="v-mileage" required min="0" placeholder="Ej: 45000" class="w-full px-4 py-2.5 bg-white border border-slate-300 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                                    <select id="v-mileage-unit" class="bg-slate-200 px-3 text-xs font-bold text-slate-700 border border-l-0 border-slate-300">
                                        <option value="mi">Millas</option>
                                        <option value="km">Km</option>
                                    </select>
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-drivetrain">
                                    <i class="fas fa-arrows-split-up-and-left text-[#1d4ed8] me-1"></i> Tracción *
                                </label>
                                <select id="v-drivetrain" class="w-full px-4 py-2.5 bg-white border border-slate-300 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    {DRIVETRAINS.map(d => <option value={d}>{d}</option>)}
                                </select>
                            </div>
                        </div>

                        <!-- Transmisión / Combustible / Colores -->
                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-transmission">
                                    <i class="fas fa-gear text-[#1d4ed8] me-1"></i> Transmisión *
                                </label>
                                <select id="v-transmission" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    {TRANSMISSION_TYPES.map(t => <option value={t}>{t}</option>)}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-fuel">
                                    <i class="fas fa-gas-pump text-[#1d4ed8] me-1"></i> Combustible *
                                </label>
                                <select id="v-fuel" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    {FUEL_TYPES.map(f => <option value={f}>{f}</option>)}
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-color-ext">
                                    <i class="fas fa-palette text-[#1d4ed8] me-1"></i> Color Exterior
                                </label>
                                <input type="text" id="v-color-ext" placeholder="Ej: Blanco Perla, Gris, Negro" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-color-int">
                                    <i class="fas fa-couch text-[#1d4ed8] me-1"></i> Color Interior
                                </label>
                                <input type="text" id="v-color-int" placeholder="Ej: Cuero Negro, Beige" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                        </div>

                        <!-- PRECIO Y MONEDA (VENTA O RENTA) -->
                        <div class="bg-blue-50/50 p-5 border border-blue-200 grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div id="box-sale-price">
                                <label class="block text-xs font-black uppercase tracking-wider text-slate-800 mb-1" for="v-price-sale">
                                    <i class="fas fa-dollar-sign text-[#1d4ed8] me-1"></i> Precio de Venta *
                                </label>
                                <div class="flex">
                                    <select id="v-currency" class="bg-white px-3 text-xs font-black text-[#1d4ed8] border border-r-0 border-slate-300">
                                        <option value="USD">USD ($)</option>
                                        <option value="DOP">DOP (RD$)</option>
                                    </select>
                                    <input type="number" id="v-price-sale" min="500" placeholder="Ej: 24500" class="w-full px-4 py-3 bg-white border border-slate-300 text-base font-bold text-slate-900 focus:outline-none focus:border-[#1d4ed8]" />
                                </div>
                            </div>

                            <div id="box-rent-price" class="opacity-50">
                                <label class="block text-xs font-black uppercase tracking-wider text-slate-800 mb-1" for="v-price-rent">
                                    <i class="fas fa-key text-[#1d4ed8] me-1"></i> Tarifa de Renta por Día (USD)
                                </label>
                                <input type="number" id="v-price-rent" min="15" placeholder="Ej: 55" class="w-full px-4 py-3 bg-white border border-slate-300 text-base font-bold text-slate-900 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                        </div>

                        <!-- Descripción Detallada -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-desc">
                                <i class="fas fa-align-left text-[#1d4ed8] me-1"></i> Descripción Completa del Vehículo
                            </label>
                            <textarea id="v-desc" rows="4" placeholder="Detalla equipamiento: pantalla táctil, cámara de reversa, sunroof, condiciones de mantenimiento, financiamiento disponible, etc..." class="w-full p-4 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]"></textarea>
                        </div>
                    </div>

                    <!-- PASO 3: CONTACTO Y WHATSAPP DIRECTO -->
                    <div class="space-y-4 pt-4 border-t border-slate-200">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-sm font-black uppercase tracking-wider text-[#0f172a] flex items-center gap-2">
                                <i class="fab fa-whatsapp text-emerald-600"></i>
                                <span>3. Datos del Vendedor / Dealer para Contacto Directo</span>
                            </h2>
                            <p class="text-xs text-slate-400 mt-1">Los compradores en TuCarroYMás te contactarán directamente a tu WhatsApp.</p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-owner-whatsapp">
                                    <i class="fab fa-whatsapp text-emerald-600 me-1"></i> Número de WhatsApp *
                                </label>
                                <input type="tel" id="v-owner-whatsapp" required placeholder="Ej: 8091234567 o 8499154010" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-owner-name">
                                    <i class="fas fa-user-check text-[#1d4ed8] me-1"></i> Nombre o Nombre del Dealer *
                                </label>
                                <input type="text" id="v-owner-name" required placeholder="Tu Nombre o Concesionario" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-seller-type">
                                    <i class="fas fa-briefcase text-[#1d4ed8] me-1"></i> Tipo de Vendedor
                                </label>
                                <select id="v-seller-type" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    <option value="particular">Vendedor Particular</option>
                                    <option value="dealer">Dealer / Concesionario Autorizado</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- BOTÓN DE PUBLICACIÓN GRATUITA -->
                    <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <p class="text-xs text-slate-500 flex items-center gap-2">
                            <i class="fas fa-shield-halved text-emerald-600 text-base"></i>
                            <span>Publicación instantánea visible en toda la República Dominicana sin costos ni comisiones.</span>
                        </p>
                        <button 
                            type="submit" 
                            id="submit-btn" 
                            class="w-full sm:w-auto px-8 py-4 bg-[#15803d] hover:bg-[#166534] text-white text-xs font-black uppercase tracking-wider luxury-btn shadow-xl flex items-center justify-center gap-2"
                            style="border-radius: 0px !important;"
                        >
                            <i class="fas fa-cloud-arrow-up"></i>
                            <span id="submit-text">Publicar Vehículo Gratis</span>
                        </button>
                    </div>

                </form>

            </div>
        </div>
    </div>
</Layout>

<script>
    import { collection, addDoc, serverTimestamp } from "firebase/firestore";
    import { ref, uploadBytes, getDownloadURL } from "firebase/storage";
    import { db, storage, auth } from "../lib/firebase/client";
    import { optimizeToSquareWebp } from "../lib/imageOptimizer";

    // Toggle entre Venta y Renta
    const radioSale = document.querySelector<HTMLInputElement>('input[value="sale"]');
    const radioRent = document.querySelector<HTMLInputElement>('input[value="rent"]');
    const labelSale = document.getElementById('label-type-sale');
    const labelRent = document.getElementById('label-type-rent');
    const boxSalePrice = document.getElementById('box-sale-price');
    const boxRentPrice = document.getElementById('box-rent-price');
    const inputSalePrice = document.getElementById('v-price-sale') as HTMLInputElement;
    const inputRentPrice = document.getElementById('v-price-rent') as HTMLInputElement;

    function syncListingType() {
        if (radioSale?.checked) {
            labelSale?.classList.add('border-[#1d4ed8]');
            labelSale?.classList.remove('border-slate-200');
            labelRent?.classList.remove('border-[#1d4ed8]');
            labelRent?.classList.add('border-slate-200');
            boxSalePrice?.classList.remove('opacity-50');
            boxRentPrice?.classList.add('opacity-50');
            if (inputSalePrice) inputSalePrice.required = true;
            if (inputRentPrice) inputRentPrice.required = false;
        } else {
            labelRent?.classList.add('border-[#1d4ed8]');
            labelRent?.classList.remove('border-slate-200');
            labelSale?.classList.remove('border-[#1d4ed8]');
            labelSale?.classList.add('border-slate-200');
            boxRentPrice?.classList.remove('opacity-50');
            boxSalePrice?.classList.add('opacity-50');
            if (inputRentPrice) inputRentPrice.required = true;
            if (inputSalePrice) inputSalePrice.required = false;
        }
    }

    radioSale?.addEventListener('change', syncListingType);
    radioRent?.addEventListener('change', syncListingType);

    // URL Param Init (?tipo=venta o ?tipo=renta)
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('tipo') === 'renta' && radioRent) {
        radioRent.checked = true;
        syncListingType();
    }

    // Manejo de Fotos Cuadradas 1500x1500px
    let mainSquareBlob: Blob | null = null;
    let galleryBlobs: Blob[] = [];

    const mainInput = document.getElementById('main-image-input') as HTMLInputElement;
    const mainDropzone = document.getElementById('main-dropzone');
    const mainPrompt = document.getElementById('main-prompt');
    const mainPreviewBox = document.getElementById('main-preview-box');
    const mainPreviewImg = document.getElementById('main-preview-img') as HTMLImageElement;
    const mainStatusText = document.getElementById('main-status-text');
    const btnChangeMain = document.getElementById('btn-change-main');

    mainDropzone?.addEventListener('click', (e) => {
        if (e.target !== btnChangeMain && mainPreviewBox && !mainPreviewBox.classList.contains('hidden')) return;
        mainInput?.click();
    });
    btnChangeMain?.addEventListener('click', (e) => {
        e.stopPropagation();
        mainInput?.click();
    });

    mainInput?.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        if (mainPrompt) mainPrompt.classList.add('hidden');
        if (mainPreviewBox) mainPreviewBox.classList.remove('hidden');
        if (mainStatusText) mainStatusText.textContent = "Procesando y centrando a Cuadrado 1500x1500px WebP...";

        try {
            mainSquareBlob = await optimizeToSquareWebp(file, 1500);
            mainPreviewImg.src = URL.createObjectURL(mainSquareBlob);
            if (mainStatusText) mainStatusText.textContent = "✓ Imagen cuadrada 1500x1500px lista";
        } catch (err) {
            console.error(err);
            if (mainStatusText) mainStatusText.textContent = "Error al procesar la imagen.";
        }
    });

    // Galería
    const galleryInput = document.getElementById('gallery-input') as HTMLInputElement;
    const galleryCount = document.getElementById('gallery-count');
    const galleryGrid = document.getElementById('gallery-thumbs-grid');

    galleryInput?.addEventListener('change', async (e) => {
        const files = Array.from((e.target as HTMLInputElement).files || []);
        if (!files.length) return;

        for (const f of files) {
            if (galleryBlobs.length >= 8) break;
            try {
                const blob = await optimizeToSquareWebp(f, 1500);
                galleryBlobs.push(blob);
                
                const thumb = document.createElement('div');
                thumb.className = "w-full aspect-square bg-white border border-slate-300 p-1 relative shadow-xs";
                thumb.innerHTML = `
                    <img src="${URL.createObjectURL(blob)}" class="w-full h-full object-contain" />
                `;
                galleryGrid?.appendChild(thumb);
            } catch (err) {
                console.error(err);
            }
        }
        if (galleryCount) galleryCount.textContent = `${galleryBlobs.length} fotos añadidas`;
    });

    // Envío del Formulario a Firebase
    const form = document.getElementById('vehicle-form') as HTMLFormElement;
    const alertBox = document.getElementById('form-alert');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const submitText = document.getElementById('submit-text');

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!mainSquareBlob) {
            if (alertBox) {
                alertBox.className = "p-4 text-xs font-bold border border-red-200 bg-red-50 text-red-700 text-center block";
                alertBox.textContent = "Por favor selecciona la foto de portada principal del vehículo.";
            }
            return;
        }

        if (submitBtn) submitBtn.disabled = true;
        if (submitText) submitText.textContent = "Publicando vehículo...";

        try {
            const isSale = radioSale?.checked ?? true;
            const listingType = isSale ? 'sale' : 'rent';
            const brand = (document.getElementById('v-brand') as HTMLSelectElement).value;
            const model = (document.getElementById('v-model') as HTMLInputElement).value;
            const year = parseInt((document.getElementById('v-year') as HTMLInputElement).value, 10);
            const category = (document.getElementById('v-category') as HTMLSelectElement).value;
            const condition = (document.getElementById('v-condition') as HTMLSelectElement).value;
            const province = (document.getElementById('v-province') as HTMLSelectElement).value;
            const engine = (document.getElementById('v-engine') as HTMLInputElement).value;
            const mileage = parseInt((document.getElementById('v-mileage') as HTMLInputElement).value, 10) || 0;
            const mileageUnit = (document.getElementById('v-mileage-unit') as HTMLSelectElement).value;
            const drivetrain = (document.getElementById('v-drivetrain') as HTMLSelectElement).value;
            const transmission = (document.getElementById('v-transmission') as HTMLSelectElement).value;
            const fuelType = (document.getElementById('v-fuel') as HTMLSelectElement).value;
            const extColor = (document.getElementById('v-color-ext') as HTMLInputElement).value;
            const intColor = (document.getElementById('v-color-int') as HTMLInputElement).value;
            const currency = (document.getElementById('v-currency') as HTMLSelectElement).value;
            const priceSale = parseFloat(inputSalePrice.value) || 0;
            const priceRent = parseFloat(inputRentPrice.value) || 0;
            const description = (document.getElementById('v-desc') as HTMLTextAreaElement).value;
            const ownerWhatsapp = (document.getElementById('v-owner-whatsapp') as HTMLInputElement).value;
            const ownerName = (document.getElementById('v-owner-name') as HTMLInputElement).value;
            const sellerType = (document.getElementById('v-seller-type') as HTMLSelectElement).value;

            const fullTitle = `${brand} ${model} ${year}`;
            const fileId = `${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;

            // Subir foto principal
            let mainImageUrl = "/Honda.webp";
            try {
                const mainRef = ref(storage, `vehicles/${fileId}/main.webp`);
                await uploadBytes(mainRef, mainSquareBlob, { contentType: 'image/webp' });
                mainImageUrl = await getDownloadURL(mainRef);
            } catch (storageErr) {
                console.warn("Storage upload fallback:", storageErr);
            }

            // Subir galería
            const galleryUrls: string[] = [];
            for (let i = 0; i < galleryBlobs.length; i++) {
                try {
                    const galRef = ref(storage, `vehicles/${fileId}/gallery_${i}.webp`);
                    await uploadBytes(galRef, galleryBlobs[i], { contentType: 'image/webp' });
                    const url = await getDownloadURL(galRef);
                    galleryUrls.push(url);
                } catch (gErr) {
                    console.warn(gErr);
                }
            }

            // Guardar documento en Firestore (rent-car-rd)
            const vehicleDoc = {
                title: fullTitle,
                brand,
                model,
                year,
                listingType,
                category,
                condition,
                province,
                city: province,
                engine,
                mileage,
                mileageUnit,
                drivetrain,
                transmission,
                fuelType,
                color: extColor,
                exteriorColor: extColor,
                interiorColor: intColor,
                price: priceSale,
                pricePerDay: priceRent || 50,
                currency,
                description,
                mainImage: mainImageUrl,
                images: galleryUrls.length > 0 ? galleryUrls : [mainImageUrl],
                ownerId: auth.currentUser?.uid || "guest_dealer",
                ownerName,
                ownerWhatsapp,
                sellerType,
                status: "active",
                createdAt: serverTimestamp()
            };

            await addDoc(collection(db, "vehicles"), vehicleDoc);

            if (alertBox) {
                alertBox.className = "p-4 text-xs font-bold border border-emerald-300 bg-emerald-50 text-emerald-800 text-center block";
                alertBox.textContent = "¡Vehículo publicado exitosamente en TuCarroYMás! Redirigiendo...";
            }

            setTimeout(() => {
                window.location.href = isSale ? "/vehiculos" : "/flota";
            }, 1200);

        } catch (err: any) {
            console.error(err);
            if (alertBox) {
                alertBox.className = "p-4 text-xs font-bold border border-red-200 bg-red-50 text-red-700 text-center block";
                alertBox.textContent = `Error al publicar: ${err.message || 'Verifique su conexión'}`;
            }
            if (submitBtn) submitBtn.disabled = false;
            if (submitText) submitText.textContent = "Publicar Vehículo Gratis";
        }
    });
</script>

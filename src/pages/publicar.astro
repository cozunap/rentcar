---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Publicar Mi Vehículo | Tu Carro y Más Rent A Car">
    <div class="py-12 bg-slate-50 min-h-screen">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-2 text-xs font-semibold text-slate-500 mb-6">
                <a href="/" class="hover:text-[#0d6efd]">Inicio</a>
                <span>/</span>
                <a href="/panel" class="hover:text-[#0d6efd]">Mi Panel</a>
                <span>/</span>
                <span class="text-slate-800">Publicar Vehículo</span>
            </nav>

            <div class="bg-white rounded-3xl shadow-xl border border-slate-200/80 overflow-hidden">
                
                <!-- Header Banner -->
                <div class="bg-[#0d1f3c] text-white p-8 sm:p-10 relative">
                    <div class="max-w-2xl relative z-10">
                        <span class="px-3 py-1 rounded-full bg-[#0d6efd]/30 text-blue-300 text-xs font-bold uppercase tracking-wider mb-3 inline-block">
                            Convertidor Automático WebP 1500px Activo
                        </span>
                        <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight">Publicar Nuevo Vehículo</h1>
                        <p class="text-slate-300 text-sm mt-2 leading-relaxed">
                            Completa los datos de tu vehículo y sube tus fotos. Nuestro sistema convertirá automáticamente todas las imágenes a formato WebP optimizado en 1500x1500px para máxima velocidad y fidelidad.
                        </p>
                    </div>
                </div>

                <!-- Form Section -->
                <form id="vehicle-form" class="p-8 sm:p-10 space-y-8">
                    
                    <div id="form-alert" class="hidden p-4 rounded-xl text-xs font-medium border text-center"></div>

                    <!-- STEP 1: FOTOS DEL VEHÍCULO -->
                    <div class="space-y-4">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-base font-bold text-[#0d1f3c] flex items-center gap-2">
                                <i class="fas fa-camera text-[#0d6efd]"></i>
                                <span>1. Fotos del Vehículo (Conversión WebP Automática)</span>
                            </h2>
                            <p class="text-xs text-slate-500 mt-0.5">Sube la foto principal y fotos adicionales. Se redimensionarán a 1500x1500px sin perder calidad.</p>
                        </div>

                        <!-- Dropzone for Main Photo -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Foto Principal del Auto * (Portada en el catálogo)
                            </label>
                            <div id="main-dropzone" class="border-2 border-dashed border-slate-300 hover:border-[#0d6efd] rounded-2xl p-6 text-center cursor-pointer transition-colors bg-slate-50/50 hover:bg-blue-50/20 relative">
                                <input type="file" id="main-image-input" accept="image/*" class="hidden" required />
                                <div id="main-upload-prompt" class="space-y-2">
                                    <div class="w-12 h-12 rounded-full bg-blue-100 text-[#0d6efd] flex items-center justify-center mx-auto text-xl">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                    </div>
                                    <p class="text-sm font-semibold text-slate-700">Haz clic o arrastra la foto principal aquí</p>
                                    <p class="text-xs text-slate-400">JPG, PNG o WEBP. Se convertirá automáticamente a 1500px WebP</p>
                                </div>
                                <div id="main-preview-container" class="hidden relative">
                                    <img id="main-preview-img" src="" alt="Vista previa principal" class="w-full max-h-80 object-cover rounded-xl shadow-md mx-auto" />
                                    <div id="main-badge-info" class="mt-2 text-xs font-semibold text-emerald-600"></div>
                                    <button type="button" id="btn-change-main" class="mt-2 px-3 py-1 bg-white border border-slate-200 text-xs font-semibold rounded-lg text-slate-700 hover:bg-slate-100">
                                        Cambiar Foto
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Extra Gallery Photos -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-2">
                                Galería Adicional (Opcional - hasta 6 fotos)
                            </label>
                            <div class="flex items-center gap-3">
                                <label for="gallery-input" class="cursor-pointer inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-slate-300 hover:border-[#0d6efd] bg-white text-slate-700 hover:text-[#0d6efd] text-xs font-bold transition-all shadow-sm">
                                    <i class="fas fa-images"></i> Seleccionar Fotos Adicionales
                                </label>
                                <span id="gallery-status-text" class="text-xs text-slate-400">0 fotos agregadas</span>
                                <input type="file" id="gallery-input" accept="image/*" multiple class="hidden" />
                            </div>
                            <!-- Gallery Preview Grid -->
                            <div id="gallery-preview-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-4"></div>
                        </div>
                    </div>

                    <!-- STEP 2: ESPECIFICACIONES DEL VEHÍCULO -->
                    <div class="space-y-4 pt-4">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-base font-bold text-[#0d1f3c] flex items-center gap-2">
                                <i class="fas fa-car text-[#0d6efd]"></i>
                                <span>2. Datos y Especificaciones del Vehículo</span>
                            </h2>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-brand">Marca *</label>
                                <input type="text" id="v-brand" required placeholder="Ej: Honda, Jeep, Toyota" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-model">Modelo *</label>
                                <input type="text" id="v-model" required placeholder="Ej: CR-V EX, Cherokee" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-year">Año *</label>
                                <input type="number" id="v-year" required min="1995" max="2030" value="2020" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-category">Categoría *</label>
                                <select id="v-category" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]">
                                    <option value="SUV">SUV</option>
                                    <option value="Premium">Premium</option>
                                    <option value="Sedán">Sedán</option>
                                    <option value="Camioneta">Camioneta 4x4</option>
                                    <option value="Económico">Económico</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-price">Precio por Día (USD) *</label>
                                <div class="relative">
                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold">$</span>
                                    <input type="number" id="v-price" required min="10" max="5000" placeholder="55" class="w-full pl-8 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-transmission">Transmisión *</label>
                                <select id="v-transmission" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]">
                                    <option value="automatic">Automática</option>
                                    <option value="manual">Manual</option>
                                </select>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-seats">Pasajeros</label>
                                <input type="number" id="v-seats" min="2" max="15" value="5" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-fuel">Combustible</label>
                                <select id="v-fuel" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]">
                                    <option value="Gasolina">Gasolina</option>
                                    <option value="Diesel">Diesel</option>
                                    <option value="Híbrido">Híbrido</option>
                                    <option value="Eléctrico">Eléctrico</option>
                                    <option value="Gas / GLP">Gas / GLP</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-city">Ciudad / Ubicación</label>
                                <input type="text" id="v-city" value="Santo Domingo Este" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-description">
                                Descripción Detallada del Vehículo
                            </label>
                            <textarea id="v-description" rows="3" placeholder="Indica el color, equipamiento, condiciones de entrega o requisitos para rentar..." class="w-full p-4 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]"></textarea>
                        </div>
                    </div>

                    <!-- STEP 3: INFORMACIÓN DE CONTACTO / WHATSAPP -->
                    <div class="space-y-4 pt-4">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-base font-bold text-[#0d1f3c] flex items-center gap-2">
                                <i class="fab fa-whatsapp text-emerald-500"></i>
                                <span>3. Contacto Directo del Propietario</span>
                            </h2>
                            <p class="text-xs text-slate-500 mt-0.5">Los clientes que vean este vehículo se comunicarán directamente con este número de WhatsApp.</p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-owner-whatsapp">
                                    Número de WhatsApp Independiente *
                                </label>
                                <div class="relative">
                                    <i class="fab fa-whatsapp absolute left-4 top-1/2 -translate-y-1/2 text-emerald-500 text-base"></i>
                                    <input type="tel" id="v-owner-whatsapp" required placeholder="8499154010" class="w-full pl-11 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="v-owner-name">
                                    Nombre a Mostrar
                                </label>
                                <input type="text" id="v-owner-name" placeholder="Tu Nombre o Agencia" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-[#0d6efd]" />
                            </div>
                        </div>
                    </div>

                    <!-- SUBMIT BUTTON -->
                    <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <p class="text-xs text-slate-400">
                            <i class="fas fa-shield-alt text-[#0d6efd] me-1"></i> Publicación instantánea visible en el catálogo principal.
                        </p>
                        <button 
                            type="submit" 
                            id="btn-publish-submit" 
                            class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#0d6efd] hover:bg-[#0b5ed7] text-white font-extrabold text-xs uppercase tracking-wider shadow-lg hover:shadow-blue-500/30 transition-all flex items-center justify-center gap-2"
                        >
                            <span id="btn-publish-text">Publicar Vehículo Ahora</span>
                            <i id="btn-publish-spinner" class="fas fa-circle-notch fa-spin hidden"></i>
                        </button>
                    </div>

                </form>

            </div>

        </div>
    </div>
</Layout>

<script>
    import { onAuthStateChanged } from "firebase/auth";
    import { doc, getDoc, setDoc, serverTimestamp } from "firebase/firestore";
    import { ref, uploadBytes, getDownloadURL } from "firebase/storage";
    import { auth, db, storage } from "../lib/firebase/client";
    import { convertToWebP } from "../lib/imageOptimizer";

    let currentUser: any = null;
    let mainOptimizedWebp: { dataUrl: string; blob: Blob; file: File; width: number; height: number; newSize: number } | null = null;
    let galleryOptimizedWebp: Array<{ dataUrl: string; blob: Blob; file: File; width: number; height: number }> = [];

    const formAlert = document.getElementById('form-alert');
    function showAlert(msg: string, isError = true) {
        if (!formAlert) return;
        formAlert.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border-red-200', 'bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
        formAlert.classList.add(isError ? 'bg-red-50' : 'bg-emerald-50', isError ? 'text-red-700' : 'text-emerald-700', isError ? 'border-red-200' : 'border-emerald-200');
        formAlert.innerHTML = msg;
    }

    // Require Auth
    onAuthStateChanged(auth, async (user) => {
        if (!user) {
            window.location.href = '/auth';
            return;
        }
        currentUser = user;

        // Auto-fill owner info from user profile
        try {
            const uSnap = await getDoc(doc(db, "users", user.uid));
            if (uSnap.exists()) {
                const uData = uSnap.data();
                const whatsappInput = document.getElementById('v-owner-whatsapp') as HTMLInputElement;
                const nameInput = document.getElementById('v-owner-name') as HTMLInputElement;
                if (whatsappInput && uData.whatsapp) whatsappInput.value = uData.whatsapp;
                if (nameInput && uData.fullName) nameInput.value = uData.fullName;
            }
        } catch (e) {
            console.warn("Could not prefill user data", e);
        }
    });

    // 1. MAIN IMAGE HANDLERS
    const mainDropzone = document.getElementById('main-dropzone');
    const mainInput = document.getElementById('main-image-input') as HTMLInputElement;
    const mainPrompt = document.getElementById('main-upload-prompt');
    const mainPreviewContainer = document.getElementById('main-preview-container');
    const mainPreviewImg = document.getElementById('main-preview-img') as HTMLImageElement;
    const mainBadgeInfo = document.getElementById('main-badge-info');
    const btnChangeMain = document.getElementById('btn-change-main');

    mainDropzone?.addEventListener('click', (e) => {
        if (e.target !== btnChangeMain && mainPreviewContainer?.classList.contains('hidden')) {
            mainInput?.click();
        }
    });
    btnChangeMain?.addEventListener('click', () => mainInput?.click());

    mainInput?.addEventListener('change', async () => {
        const file = mainInput.files?.[0];
        if (!file) return;

        try {
            showAlert('Optimizando y convirtiendo a formato WebP 1500px...', false);
            // Convert to 1500x1500px WebP
            mainOptimizedWebp = await convertToWebP(file, 1500, 1500, 0.88);
            
            if (mainPreviewImg && mainPreviewContainer && mainPrompt && mainBadgeInfo) {
                mainPreviewImg.src = mainOptimizedWebp.dataUrl;
                mainPrompt.classList.add('hidden');
                mainPreviewContainer.classList.remove('hidden');
                const kb = Math.round(mainOptimizedWebp.newSize / 1024);
                mainBadgeInfo.textContent = `✓ Convertida a WebP 1500px (${mainOptimizedWebp.width}x${mainOptimizedWebp.height}px, ${kb} KB)`;
            }
            if (formAlert) formAlert.classList.add('hidden');
        } catch (err: any) {
            showAlert('Error al procesar la imagen: ' + err.message, true);
        }
    });

    // 2. GALLERY IMAGES HANDLERS
    const galleryInput = document.getElementById('gallery-input') as HTMLInputElement;
    const galleryStatus = document.getElementById('gallery-status-text');
    const galleryGrid = document.getElementById('gallery-preview-grid');

    galleryInput?.addEventListener('change', async () => {
        const files = galleryInput.files;
        if (!files || files.length === 0) return;

        showAlert('Procesando imágenes de galería a WebP 1500px...', false);
        galleryOptimizedWebp = [];
        if (galleryGrid) galleryGrid.innerHTML = '';

        for (let i = 0; i < Math.min(files.length, 6); i++) {
            const f = files[i];
            try {
                const opt = await convertToWebP(f, 1500, 1500, 0.85);
                galleryOptimizedWebp.push(opt);

                const card = document.createElement('div');
                card.className = "relative h-28 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 group";
                card.innerHTML = `
                    <img src="${opt.dataUrl}" class="w-full h-full object-cover" />
                    <span class="absolute bottom-1 right-1 text-[9px] bg-black/60 text-white px-1.5 py-0.5 rounded font-mono">WebP</span>
                `;
                galleryGrid?.appendChild(card);
            } catch (e) {
                console.error("Gallery conversion error:", e);
            }
        }

        if (galleryStatus) galleryStatus.textContent = `${galleryOptimizedWebp.length} fotos optimizadas`;
        if (formAlert) formAlert.classList.add('hidden');
    });

    // 3. SUBMIT VEHICLE FORM
    const form = document.getElementById('vehicle-form') as HTMLFormElement;
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        if (!currentUser) {
            window.location.href = '/auth';
            return;
        }

        if (!mainOptimizedWebp) {
            showAlert('Debes subir la foto principal del vehículo.', true);
            return;
        }

        const brand = (document.getElementById('v-brand') as HTMLInputElement).value.trim();
        const model = (document.getElementById('v-model') as HTMLInputElement).value.trim();
        const year = parseInt((document.getElementById('v-year') as HTMLInputElement).value, 10);
        const category = (document.getElementById('v-category') as HTMLSelectElement).value;
        const pricePerDay = parseFloat((document.getElementById('v-price') as HTMLInputElement).value);
        const transmission = (document.getElementById('v-transmission') as HTMLSelectElement).value;
        const seats = parseInt((document.getElementById('v-seats') as HTMLInputElement).value, 10) || 5;
        const fuelType = (document.getElementById('v-fuel') as HTMLSelectElement).value;
        const city = (document.getElementById('v-city') as HTMLInputElement).value.trim() || 'Santo Domingo Este';
        const description = (document.getElementById('v-description') as HTMLTextAreaElement).value.trim();
        const ownerWhatsappRaw = (document.getElementById('v-owner-whatsapp') as HTMLInputElement).value.trim();
        const digits = ownerWhatsappRaw.replace(/\D/g, '');
        const ownerWhatsapp = digits.startsWith('1') ? `+${digits}` : `+1${digits}`;

        const title = `${brand} ${model} ${year}`;
        const vehicleId = `v-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`;

        const btnText = document.getElementById('btn-publish-text');
        const spinner = document.getElementById('btn-publish-spinner');
        btnText?.classList.add('hidden');
        spinner?.classList.remove('hidden');
        showAlert('Subiendo fotos optimizadas y registrando vehículo...', false);

        try {
            // A. Upload Main Image to Firebase Storage
            const mainFileRef = ref(storage, `vehicles/${vehicleId}/main_${Date.now()}.webp`);
            await uploadBytes(mainFileRef, mainOptimizedWebp.blob, { contentType: 'image/webp' });
            const mainImageUrl = await getDownloadURL(mainFileRef);

            // B. Upload Gallery Images
            const galleryUrls: string[] = [mainImageUrl];
            for (let i = 0; i < galleryOptimizedWebp.length; i++) {
                const gRef = ref(storage, `vehicles/${vehicleId}/gallery_${i}_${Date.now()}.webp`);
                await uploadBytes(gRef, galleryOptimizedWebp[i].blob, { contentType: 'image/webp' });
                const gUrl = await getDownloadURL(gRef);
                galleryUrls.push(gUrl);
            }

            // C. Save Vehicle in Firestore
            const vehicleDoc = {
                ownerId: currentUser.uid,
                ownerWhatsapp: ownerWhatsapp,
                title: title,
                brand: brand,
                model: model,
                year: year,
                pricePerDay: pricePerDay,
                price: pricePerDay,
                mainImage: mainImageUrl,
                images: galleryUrls,
                description: description || `Vehículo ${title} disponible para renta en ${city}.`,
                category: category,
                transmission: transmission,
                seats: seats,
                fuelType: fuelType,
                city: city,
                isAvailable: true,
                featured: false,
                createdAt: serverTimestamp()
            };

            await setDoc(doc(db, "vehicles", vehicleId), vehicleDoc);

            showAlert('¡Vehículo publicado con éxito! Redirigiendo a tu panel...', false);
            setTimeout(() => {
                window.location.href = '/panel';
            }, 800);
        } catch (err: any) {
            btnText?.classList.remove('hidden');
            spinner?.classList.add('hidden');
            showAlert('Error al publicar: ' + err.message, true);
        }
    });
</script>

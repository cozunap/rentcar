---
import Layout from "../layouts/Layout.astro";
import { TRANSPORT_TYPES, DOMINICAN_PROVINCES } from "../lib/carDealerData";
---

<Layout title="Publicar Anuncio | TuCarroYMas">
  <div class="bg-[#f8fafc] text-slate-800 min-h-screen py-12 px-4 sm:px-8">
    <div class="max-w-4xl mx-auto">
      
      <!-- Wizard Header -->
      <div class="border-b border-slate-200 pb-6 mb-8 text-center sm:text-left">
        <span class="text-blue-600 font-bold uppercase tracking-widest text-xs">Directorio de Concesionarios y Particulares</span>
        <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-slate-900 mt-1">
          Publicar Vehículo o Maquinaria (Gratis)
        </h1>
        <p class="text-sm text-slate-500 mt-2 font-medium">
          Completa la ficha técnica según el tipo de transporte. Las fotografías son optimizadas a 1500x1500px WebP para garantizar máxima velocidad y nitidez sin distorsión.
        </p>
      </div>

      <!-- FORM BUILDER (Ozuna Engine Pattern - Clean White Surface) -->
      <form id="publish-form" class="bg-white border border-slate-200 p-6 sm:p-10 shadow-sm space-y-8">
        
        <!-- Step 1: Transport Category Selection -->
        <div>
          <h2 class="text-sm font-black uppercase tracking-wider text-blue-600 mb-4 pb-2 border-b border-slate-200 flex items-center gap-2">
            <span>1.</span> Selecciona el Tipo de Transporte
          </h2>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {TRANSPORT_TYPES.map(cat => (
              <label class="border border-slate-200 p-3 flex flex-col justify-between hover:border-blue-500 cursor-pointer bg-slate-50 hover:bg-white has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/50 transition-all">
                <input type="radio" name="transportType" value={cat.id} required class="sr-only" />
                <span class="font-bold text-xs text-slate-900 uppercase">{cat.nameEs}</span>
                <span class="text-[10px] text-slate-500 mt-1">{cat.name}</span>
              </label>
            ))}
          </div>
        </div>

        <!-- Step 2: Basic Vehicle Information -->
        <div>
          <h2 class="text-sm font-black uppercase tracking-wider text-blue-600 mb-4 pb-2 border-b border-slate-200 flex items-center gap-2">
            <span>2.</span> Información General y Técnica
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Título del Anuncio *</label>
              <input type="text" id="title" required placeholder="Ej. Toyota Camry SE 2023 / Cat 320D" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Marca Fabricante *</label>
              <input type="text" id="make" required placeholder="Ej. Toyota, Freightliner, Caterpillar..." class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Modelo *</label>
              <input type="text" id="model" required placeholder="Ej. Camry SE, Cascadia 126, MT-09..." class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Año de Fabricación *</label>
              <input type="number" id="year" required min="1950" max="2027" value="2023" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Condición *</label>
              <select id="condition" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium cursor-pointer">
                <option value="usado">Usado Certificado</option>
                <option value="nuevo">Nuevo de Agencia (0 Km)</option>
              </select>
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Precio de Venta (USD) *</label>
              <input type="number" id="price" required placeholder="25000" min="500" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Kilometraje o Horas Operativas *</label>
              <input type="text" id="mileageOrHours" required placeholder="Ej. 19,400 mi / 3,100 Horas" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Provincia *</label>
              <select id="location" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium cursor-pointer">
                {DOMINICAN_PROVINCES.map(p => (
                  <option value={p}>{p}</option>
                ))}
              </select>
            </div>
          </div>

          <div class="mt-4">
            <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Descripción Completa del Anuncio</label>
            <textarea id="description" rows="4" placeholder="Detalles de mantenimiento, extras, accesorios, historial..." class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium"></textarea>
          </div>
        </div>

        <!-- Step 3: Client-side Image Squaring (Optimización Visual) -->
        <div>
          <h2 class="text-sm font-black uppercase tracking-wider text-blue-600 mb-4 pb-2 border-b border-slate-200 flex items-center gap-2">
            <span>3.</span> Fotografía Principal (Optimización Cuadrada WebP 1500x1500px)
          </h2>

          <div class="border-2 border-dashed border-slate-300 p-6 text-center bg-slate-50 hover:border-blue-500 transition-colors">
            <input type="file" id="image-file" accept="image/*" class="hidden" />
            <label for="image-file" class="cursor-pointer flex flex-col items-center">
              <svg class="w-10 h-10 text-blue-600 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <span class="text-xs font-bold text-slate-900 uppercase">Seleccionar Imagen desde tu Dispositivo</span>
              <span class="text-[11px] text-slate-500 mt-1">El optimizador la convertirá automáticamente a formato cuadrado WebP</span>
            </label>
            <div id="image-preview-container" class="hidden mt-4">
              <img id="image-preview" src="" alt="Vista previa" class="w-32 h-32 object-cover mx-auto border border-slate-200 shadow-md" />
              <p id="image-status" class="text-xs text-emerald-600 mt-2 font-mono font-bold"></p>
            </div>
          </div>
        </div>

        <!-- Step 4: Seller Direct Contact Info -->
        <div>
          <h2 class="text-sm font-black uppercase tracking-wider text-blue-600 mb-4 pb-2 border-b border-slate-200 flex items-center gap-2">
            <span>4.</span> Datos de Contacto Directo
          </h2>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Nombre del Vendedor / Dealer *</label>
              <input type="text" id="sellerName" required placeholder="Tu Nombre o Concesionario" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>

            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-1.5">Teléfono WhatsApp Dominicano *</label>
              <input type="text" id="sellerWhatsapp" required placeholder="8295550199 (Sin guiones)" class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-blue-600 font-medium" />
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-slate-500 font-medium">
            Al publicar confirmas que la unidad es legítima y verificable.
          </p>
          <button 
            type="submit" 
            id="submit-btn"
            class="w-full sm:w-auto bg-blue-600 hover:bg-blue-700 text-white font-black text-xs uppercase py-3.5 px-8 tracking-wider shadow-md shadow-blue-600/30 transition-all cursor-pointer"
          >
            Publicar Anuncio Ahora
          </button>
        </div>

        <div id="form-alert" class="hidden p-4 text-xs font-bold uppercase"></div>
      </form>

    </div>
  </div>
</Layout>

<script>
  import { optimizeToSquareWebp } from "../lib/imageOptimizer";

  const fileInput = document.getElementById("image-file") as HTMLInputElement;
  const preview = document.getElementById("image-preview") as HTMLImageElement;
  const previewContainer = document.getElementById("image-preview-container");
  const status = document.getElementById("image-status");
  const form = document.getElementById("publish-form");
  const formAlert = document.getElementById("form-alert");

  let optimizedBlob: Blob | null = null;

  fileInput?.addEventListener("change", async (e: any) => {
    const file = e.target.files?.[0];
    if (!file) return;

    if (status) status.innerText = "Optimizando a cuadrado WebP 1500x1500px...";
    previewContainer?.classList.remove("hidden");

    try {
      optimizedBlob = await optimizeToSquareWebp(file, 1500);
      if (preview && optimizedBlob) {
        preview.src = URL.createObjectURL(optimizedBlob);
      }
      if (status) status.innerText = "✓ Imagen optimizada con éxito (1500x1500px WebP)";
    } catch (err) {
      if (status) status.innerText = "Error optimizando la imagen.";
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (formAlert) {
      formAlert.className = "p-4 text-xs font-bold uppercase bg-emerald-100 text-emerald-800 border border-emerald-300";
      formAlert.innerText = "✓ ¡Anuncio enviado con éxito al directorio! Será visible inmediatamente.";
      formAlert.classList.remove("hidden");
    }

    setTimeout(() => {
      window.location.href = "/vehiculos";
    }, 1500);
  });
</script>

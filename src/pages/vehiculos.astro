---
import Layout from "../layouts/Layout.astro";
import { DOMINICAN_PROVINCES } from "../lib/carDealerData";
import { DEMO_VEHICLES_SEED } from "../lib/carDealerSeed";
import { VEHICLE_STYLES } from "../lib/vehicleStyles";
---

<Layout title="Catálogo de Vehículos y Transporte en República Dominicana | TuCarroYMas">
  <div class="bg-[#f8fafc] text-slate-800 min-h-screen py-10 px-4 sm:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- Catalog Header -->
      <div class="border-b border-slate-200 pb-6 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-[#D54000] mb-2">
            <a href="/" class="hover:underline">Inicio</a>
            <span>/</span>
            <span>Inventario Multicategoría</span>
          </div>
          <h1 class="text-3xl sm:text-4xl font-black uppercase tracking-tight text-slate-900">
            Catálogo de Vehículos & Transporte
          </h1>
          <p class="text-xs sm:text-sm text-slate-500 mt-1 font-medium">
            Filtros facetados en tiempo real por tipo de transporte, condición, provincia y rango de precio.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <span class="text-xs text-slate-500 font-medium">Total listados:</span>
          <span id="vehicle-count-badge" class="px-3 py-1 bg-orange-50 border border-orange-200 text-[#D54000] font-mono font-bold text-xs">
            {DEMO_VEHICLES_SEED.length} Unidades
          </span>
        </div>
      </div>

      <!-- Main Layout: Sidebar Filters + Listings Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
        
        <!-- SIDEBAR FILTERS -->
        <aside class="lg:col-span-1 space-y-6">
          <div class="bg-white border border-slate-200 p-5 shadow-sm rounded-sm">
            
            <!-- Header de Filtros: "Filtrar" y "Limpiar Todo" -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-200 mb-5">
              <h2 class="text-sm font-black uppercase tracking-wider text-slate-900 flex items-center gap-2">
                <svg class="w-4 h-4 text-[#D54000]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
                Filtrar
              </h2>
              <button 
                id="reset-filters-btn"
                type="button" 
                class="text-[11px] font-bold text-slate-500 hover:text-[#D54000] underline uppercase cursor-pointer"
              >
                Limpiar Todo
              </button>
            </div>

            <!-- Search Keyword -->
            <div class="mb-5">
              <label class="block text-xs uppercase font-bold text-slate-700 mb-2">Palabra Clave</label>
              <div class="relative">
                <input 
                  type="text" 
                  id="search-input"
                  placeholder="Modelo, marca, motor..."
                  class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 pl-8 pr-3 focus:outline-none focus:border-[#D54000] focus:ring-1 focus:ring-[#D54000] font-medium placeholder:text-slate-400 rounded-sm"
                />
                <svg class="w-4 h-4 text-slate-400 absolute left-2.5 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              </div>
            </div>

            <!-- Filter: Tipo de Transporte (Dropdown Select con todas las categorías oficiales de portada) -->
            <div class="mb-5">
              <label class="block text-xs uppercase font-bold text-slate-700 mb-2">
                Tipo de Transporte
              </label>
              <select 
                id="transport-select" 
                class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-[#D54000] focus:ring-1 focus:ring-[#D54000] font-medium cursor-pointer rounded-sm"
              >
                <option value="all">Todos los Transportes</option>
                {VEHICLE_STYLES.map(style => (
                  <option value={style.id}>{style.nameEs}</option>
                ))}
              </select>
            </div>

            <!-- Filter: Condición (Nuevos, Usados y Certificados) -->
            <div class="mb-5">
              <label class="block text-xs uppercase font-bold text-slate-700 mb-2">Condición</label>
              <select 
                id="condition-select" 
                class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-[#D54000] focus:ring-1 focus:ring-[#D54000] font-medium cursor-pointer rounded-sm"
              >
                <option value="all">Todas las Condiciones</option>
                <option value="nuevo">Nuevos</option>
                <option value="usado">Usados</option>
                <option value="certificado">Certificados</option>
              </select>
            </div>

            <!-- Filter: Location / Province -->
            <div class="mb-5">
              <label class="block text-xs uppercase font-bold text-slate-700 mb-2">Provincia</label>
              <select 
                id="location-select" 
                class="w-full bg-slate-50 border border-slate-300 text-slate-900 text-xs py-2.5 px-3 focus:outline-none focus:border-[#D54000] focus:ring-1 focus:ring-[#D54000] font-medium cursor-pointer rounded-sm"
              >
                <option value="all">Todas las Provincias</option>
                {DOMINICAN_PROVINCES.map(p => (
                  <option value={p}>{p}</option>
                ))}
              </select>
            </div>

            <!-- Filter: Price Range -->
            <div>
              <label class="block text-xs uppercase font-bold text-slate-700 mb-2">Precio Máximo (USD)</label>
              <input 
                type="range" 
                id="price-range" 
                min="10000" 
                max="150000" 
                step="5000" 
                value="150000" 
                class="w-full accent-[#D54000] cursor-pointer"
              />
              <div class="flex items-center justify-between text-xs text-slate-500 font-mono mt-1">
                <span>$10,000</span>
                <span id="price-range-display" class="font-bold text-[#D54000]">$150,000 USD</span>
              </div>
            </div>

          </div>
        </aside>

        <!-- LISTINGS CONTENT -->
        <main class="lg:col-span-3">
          
          <!-- Top Sort & View Controls -->
          <div class="bg-white border border-slate-200 p-3 sm:px-5 mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs shadow-sm rounded-sm">
            <div class="text-slate-600">
              Mostrando <span id="visible-count" class="text-slate-900 font-bold">{DEMO_VEHICLES_SEED.length}</span> resultados filtrados
            </div>
            
            <div class="flex items-center gap-3">
              <label class="text-slate-600 font-medium">Ordenar por:</label>
              <select 
                id="sort-select" 
                class="bg-slate-50 border border-slate-300 text-slate-900 text-xs py-1.5 px-3 focus:outline-none focus:border-[#D54000] font-medium cursor-pointer rounded-sm"
              >
                <option value="featured">Destacados Primero</option>
                <option value="price-asc">Precio: Menor a Mayor</option>
                <option value="price-desc">Precio: Mayor a Menor</option>
                <option value="year-desc">Año: Más Reciente</option>
              </select>
            </div>
          </div>

          <!-- Listings Dynamic Grid -->
          <div id="fleet-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            <!-- Cards renderizadas dinámicamente -->
          </div>

          <!-- No Results Fallback -->
          <div id="no-results" class="hidden text-center py-16 bg-white border border-slate-200 p-8 shadow-sm rounded-sm">
            <div class="w-16 h-16 mx-auto mb-4 bg-orange-50 text-[#D54000] rounded-full flex items-center justify-center">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
            <h3 class="text-base font-black text-slate-900">No encontramos vehículos con estos criterios</h3>
            <p class="text-xs text-slate-500 mt-1 max-w-md mx-auto">
              Prueba cambiando el tipo de transporte, ajustando el rango de precio o buscando otra marca.
            </p>
          </div>

        </main>

      </div>

    </div>
  </div>
</Layout>

<script define:vars={{ seedData: DEMO_VEHICLES_SEED, stylesData: VEHICLE_STYLES }}>
  // Leer vehículos guardados dinámicamente por el usuario desde localStorage y combinarlos
  let userVehicles = [];
  try {
    const raw = localStorage.getItem("tucarroymas_user_published_vehicles_v1");
    if (raw) userVehicles = JSON.parse(raw);
  } catch (e) {
    console.error("Error cargando vehículos locales:", e);
  }

  let vehicles = [...userVehicles, ...seedData];

  // Actualizar badge de total con unidades reales
  const totalBadge = document.getElementById("vehicle-count-badge");
  if (totalBadge) {
    totalBadge.innerText = `${vehicles.length} Unidades`;
  }
  
  // URL Param Parsing
  const urlParams = new URLSearchParams(window.location.search);
  const initialType = urlParams.get("type");
  const initialBody = urlParams.get("body");
  const initialMake = urlParams.get("make");
  const initialLocation = urlParams.get("location");
  const initialCondition = urlParams.get("condition");
  const initialMaxPrice = urlParams.get("maxPrice");

  // Elements
  const fleetGrid = document.getElementById("fleet-grid");
  const noResults = document.getElementById("no-results");
  const visibleCount = document.getElementById("visible-count");
  const searchInput = document.getElementById("search-input");
  const transportSelect = document.getElementById("transport-select");
  const conditionSelect = document.getElementById("condition-select");
  const locationSelect = document.getElementById("location-select");
  const priceRange = document.getElementById("price-range");
  const priceDisplay = document.getElementById("price-range-display");
  const sortSelect = document.getElementById("sort-select");
  const resetBtn = document.getElementById("reset-filters-btn");

  // Set initial filter values from URL
  if (initialMake && searchInput) searchInput.value = initialMake;
  if (initialLocation && locationSelect) locationSelect.value = initialLocation;
  if (initialCondition && conditionSelect) conditionSelect.value = initialCondition;
  
  if (initialMaxPrice && priceRange) {
    priceRange.value = initialMaxPrice;
    if (priceDisplay) priceDisplay.innerText = `$${Number(initialMaxPrice).toLocaleString()} USD`;
  }
  
  // Sincronización del selector de tipo de transporte
  if (transportSelect) {
    if (initialBody) {
      transportSelect.value = initialBody;
    } else if (initialType) {
      if (initialType === "water-transport") transportSelect.value = "boats";
      else if (initialType === "machinery" || initialType === "special-machinery") transportSelect.value = "machinery";
      else if (initialType === "trucks-buses") transportSelect.value = "commercial";
      else if (initialType === "mototechnics") transportSelect.value = "coupes";
    }
  }

  function getCategoryLabel(v) {
    if (v.category) {
      const match = stylesData.find(s => s.id === v.category);
      if (match) return match.nameEs;
    }
    return v.transportType.replace("-", " ").toUpperCase();
  }

  function renderGrid(items) {
    if (!fleetGrid) return;
    fleetGrid.innerHTML = "";

    if (items.length === 0) {
      fleetGrid.classList.add("hidden");
      noResults?.classList.remove("hidden");
      if (visibleCount) visibleCount.innerText = "0";
      return;
    }

    fleetGrid.classList.remove("hidden");
    noResults?.classList.add("hidden");
    if (visibleCount) visibleCount.innerText = items.length.toString();

    items.forEach(v => {
      const card = document.createElement("div");
      card.className = "group bg-white border border-slate-200 hover:border-[#D54000] transition-all duration-300 shadow-sm hover:shadow-xl flex flex-col justify-between rounded-sm overflow-hidden";
      
      const conditionBadgeClass = v.condition === 'nuevo' 
        ? 'bg-blue-600 text-white' 
        : v.condition === 'certificado' 
        ? 'bg-emerald-600 text-white' 
        : 'bg-amber-600 text-white';

      const conditionText = v.condition === 'nuevo' 
        ? 'NUEVO' 
        : v.condition === 'certificado' 
        ? 'CERTIFICADO' 
        : 'USADO';

      card.innerHTML = `
        <div>
          <!-- Link to Details Page on Image -->
          <a href="/vehiculo/${v.id}" class="block relative h-48 overflow-hidden bg-slate-900 cursor-pointer">
            <img src="${v.imageUrl}" alt="${v.title}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute top-2.5 left-2.5 flex flex-col gap-1 z-10">
              <span class="px-2 py-0.5 text-[9px] font-black uppercase tracking-wider bg-slate-900/90 text-white shadow-sm rounded-xs">
                ${getCategoryLabel(v)}
              </span>
              <span class="px-2 py-0.5 text-[9px] font-bold uppercase tracking-wider ${conditionBadgeClass} shadow-sm rounded-xs">
                ${conditionText}
              </span>
            </div>
            <div class="absolute bottom-2.5 right-2.5 bg-white/95 px-2 py-0.5 text-[11px] font-mono font-bold text-slate-800 border border-slate-200 shadow-sm rounded-xs">
              ${v.location}
            </div>
          </a>

          <div class="p-4">
            <!-- Link to Details Page on Title -->
            <a href="/vehiculo/${v.id}">
              <h3 class="text-sm font-black text-slate-900 group-hover:text-[#D54000] transition-colors line-clamp-1 cursor-pointer">
                ${v.title}
              </h3>
            </a>

            <div class="mt-1.5 flex items-baseline gap-2">
              <span class="text-xl font-black text-[#D54000]">
                $${Number(v.price).toLocaleString()} <span class="text-xs text-slate-600 font-bold">${v.currency}</span>
              </span>
            </div>

            <div class="mt-3 grid grid-cols-2 gap-1.5 text-[11px] text-slate-700 py-2 border-y border-slate-200 bg-slate-50 px-2 rounded-xs">
              <div class="truncate"><span class="text-slate-500 font-medium">Uso:</span> <span class="font-bold text-slate-900">${v.mileageOrHours}</span></div>
              <div class="truncate"><span class="text-slate-500 font-medium">Trans:</span> <span class="font-bold text-slate-900">${v.transmission.split(" ")[0]}</span></div>
              <div class="truncate"><span class="text-slate-500 font-medium">Comb:</span> <span class="font-bold text-slate-900">${v.fuelType}</span></div>
              <div class="truncate"><span class="text-slate-500 font-medium">Año:</span> <span class="font-bold text-slate-900">${v.year}</span></div>
            </div>

            <div class="mt-3 flex items-center justify-between text-xs text-slate-500">
              <span class="text-slate-800 font-medium truncate text-[11px]">${v.seller.name}</span>
              <span class="text-[9px] text-emerald-700 font-bold uppercase">${v.seller.dealerType}</span>
            </div>
          </div>
        </div>

        <div class="p-4 pt-0 grid grid-cols-2 gap-2">
          <a 
            href="https://wa.me/${v.seller.whatsapp}?text=${encodeURIComponent("Hola, estoy interesado en el anuncio: " + v.title + " ($" + Number(v.price).toLocaleString() + " USD) en TuCarroYMas.")}"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-[#25D366] hover:bg-[#1ebd59] text-white font-bold text-xs uppercase py-2.5 px-2 flex items-center justify-center gap-1.5 transition-all text-center rounded-xs shadow-xs"
          >
            <i class="fa-brands fa-whatsapp text-sm"></i>
            WhatsApp
          </a>
          <!-- Direct Link to the Detailed Page -->
          <a 
            href="/vehiculo/${v.id}"
            class="bg-slate-900 hover:bg-[#D54000] text-white font-bold text-xs uppercase py-2.5 px-2 flex items-center justify-center transition-all text-center cursor-pointer rounded-xs"
          >
            Detalles
          </a>
        </div>
      `;
      fleetGrid.appendChild(card);
    });
  }

  function applyFilters() {
    const selectedCategory = transportSelect?.value || "all";
    const keyword = searchInput?.value.toLowerCase().trim() || "";
    const loc = locationSelect?.value || "all";
    const cond = conditionSelect?.value || "all";
    const maxP = Number(priceRange?.value || 150000);
    const sortBy = sortSelect?.value || "featured";

    let filtered = vehicles.filter(v => {
      // Filtrado por categoría de transporte (Dropdown con todos los estilos de portada)
      if (selectedCategory !== "all") {
        if (v.category) {
          if (v.category !== selectedCategory) return false;
        } else {
          // Fallback por transportType
          if (selectedCategory === "boats" && v.transportType !== "water-transport") return false;
          if (selectedCategory === "machinery" && v.transportType !== "machinery" && v.transportType !== "special-machinery") return false;
          if (selectedCategory === "commercial" && v.transportType !== "trucks-buses") return false;
        }
      }

      // Filtrado por condición (Nuevos, Usados, Certificados)
      if (cond !== "all" && v.condition !== cond) return false;

      // Filtrado por provincia
      if (loc !== "all" && v.location !== loc) return false;

      // Filtrado por precio
      if (Number(v.price) > maxP) return false;

      // Filtrado por palabra clave
      if (keyword) {
        const fullText = `${v.title} ${v.make} ${v.model} ${v.engine} ${v.description}`.toLowerCase();
        if (!fullText.includes(keyword)) return false;
      }

      return true;
    });

    // Sorting
    if (sortBy === "price-asc") {
      filtered.sort((a, b) => a.price - b.price);
    } else if (sortBy === "price-desc") {
      filtered.sort((a, b) => b.price - a.price);
    } else if (sortBy === "year-desc") {
      filtered.sort((a, b) => b.year - a.year);
    }

    renderGrid(filtered);
  }

  // Event Listeners
  searchInput?.addEventListener("input", applyFilters);
  transportSelect?.addEventListener("change", applyFilters);
  conditionSelect?.addEventListener("change", applyFilters);
  locationSelect?.addEventListener("change", applyFilters);
  sortSelect?.addEventListener("change", applyFilters);
  priceRange?.addEventListener("input", (e) => {
    if (priceDisplay) priceDisplay.innerText = `$${Number(e.target.value).toLocaleString()} USD`;
    applyFilters();
  });

  resetBtn?.addEventListener("click", () => {
    if (searchInput) searchInput.value = "";
    if (transportSelect) transportSelect.value = "all";
    if (conditionSelect) conditionSelect.value = "all";
    if (locationSelect) locationSelect.value = "all";
    if (priceRange) {
      priceRange.value = "150000";
      if (priceDisplay) priceDisplay.innerText = "$150,000 USD";
    }
    applyFilters();
  });

  // Initial render
  applyFilters();
</script>

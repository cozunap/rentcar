---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Anunciar Mi Negocio Automotriz | Tu Carro y Más RD">
    <div class="py-14 bg-[#f8fafc] min-h-screen">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Breadcrumbs -->
            <nav class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-slate-400 mb-6">
                <a href="/" class="hover:text-[#1d4ed8]">Inicio</a>
                <span>/</span>
                <a href="/directorio" class="hover:text-[#1d4ed8]">Directorio</a>
                <span>/</span>
                <span class="text-slate-800">Anunciar Negocio</span>
            </nav>

            <div class="bg-white border border-slate-200 shadow-xl overflow-hidden">
                
                <!-- Corporate Banner -->
                <div class="bg-[#0f172a] text-white p-8 sm:p-12 relative border-b border-slate-800">
                    <div class="inline-flex items-center gap-2 px-3 py-1 bg-amber-500/20 text-amber-400 border border-amber-500/30 text-[10px] font-black uppercase tracking-widest mb-4">
                        <i class="fas fa-gift"></i> Promoción Exclusiva • 1er Año 100% Gratis
                    </div>
                    <h1 class="text-3xl font-bold tracking-tight uppercase font-['Outfit',sans-serif]">
                        Anuncia tu Negocio Automotriz
                    </h1>
                    <p class="text-slate-300 text-sm mt-3 leading-relaxed max-w-2xl">
                        Llega a miles de conductores en República Dominicana. Publica tu taller mecánico, tienda de repuestos, autolavado o servicio automotriz. Tu anuncio creará automáticamente su categoría en el mega menú principal.
                    </p>
                </div>

                <!-- Registration Form -->
                <form id="business-form" class="p-8 sm:p-12 space-y-8">
                    
                    <div id="biz-alert" class="hidden p-4 text-xs font-medium border text-center"></div>

                    <!-- 1. DATOS DEL NEGOCIO -->
                    <div class="space-y-4">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-sm font-bold uppercase tracking-wider text-[#0f172a] flex items-center gap-2">
                                <i class="fas fa-store text-[#1d4ed8]"></i>
                                <span>1. Información del Negocio o Servicio</span>
                            </h2>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="biz-name">
                                Nombre de la Empresa / Negocio *
                            </label>
                            <input type="text" id="biz-name" required placeholder="Ej: Taller Mecánico Los Prados / Repuestos El Cibao" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8] focus:bg-white transition-colors" />
                        </div>

                        <!-- CATEGORY SELECTION + DYNAMIC CATEGORY CREATION -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="biz-category-select">
                                    Categoría / Renglón *
                                </label>
                                <select id="biz-category-select" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]">
                                    <option value="Talleres Mecánicos">Talleres Mecánicos</option>
                                    <option value="Venta de Repuestos">Venta de Repuestos</option>
                                    <option value="Detailing & Car Wash">Detailing & Car Wash</option>
                                    <option value="Grúas y Remolques">Grúas y Remolques</option>
                                    <option value="Electromecánica y Baterías">Electromecánica y Baterías</option>
                                    <option value="Gomerías y Alineación">Gomerías y Alineación</option>
                                    <option value="NEW_CATEGORY">+ Crear Nueva Categoría / Renglón...</option>
                                </select>
                            </div>

                            <!-- Input if user creates a brand new category -->
                            <div id="new-category-wrapper" class="hidden">
                                <label class="block text-xs font-bold uppercase tracking-wider text-amber-700 mb-1" for="biz-new-category">
                                    Nombre del Nuevo Renglón *
                                </label>
                                <input type="text" id="biz-new-category" placeholder="Ej: Polarizado de Cristales" class="w-full px-4 py-3 bg-amber-50/50 border border-amber-300 text-sm text-slate-800 focus:outline-none focus:border-amber-600" />
                                <p class="text-[10px] text-amber-700 mt-1">Esta nueva categoría se integrará al Mega Menú del Header.</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="biz-city">
                                    Ciudad / Municipio *
                                </label>
                                <input type="text" id="biz-city" required value="Santo Domingo Este" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="biz-address">
                                    Dirección Física
                                </label>
                                <input type="text" id="biz-address" placeholder="Av. San Vicente de Paúl #120" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                        </div>

                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="biz-desc">
                                Descripción de Servicios y Especialidades *
                            </label>
                            <textarea id="biz-desc" required rows="3" placeholder="Detalla los servicios que ofreces, marcas con las que trabajas, garantías o promociones para conductores..." class="w-full p-4 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]"></textarea>
                        </div>
                    </div>

                    <!-- 2. CONTACTO WHATSAPP DIRECTO -->
                    <div class="space-y-4 pt-4 border-t border-slate-100">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-sm font-bold uppercase tracking-wider text-[#0f172a] flex items-center gap-2">
                                <i class="fab fa-whatsapp text-emerald-600"></i>
                                <span>2. WhatsApp de Contacto para Clientes</span>
                            </h2>
                            <p class="text-xs text-slate-400">Los conductores que encuentren tu negocio te escribirán directamente a este número.</p>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="biz-whatsapp">
                                    Número de WhatsApp Directo *
                                </label>
                                <input type="tel" id="biz-whatsapp" required placeholder="8499154010" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1" for="biz-phone">
                                    Teléfono Fijo / Oficina (Opcional)
                                </label>
                                <input type="tel" id="biz-phone" placeholder="8095940000" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 text-sm text-slate-800 focus:outline-none focus:border-[#1d4ed8]" />
                            </div>
                        </div>
                    </div>

                    <!-- 3. FOTO / LOGOTIPO DEL NEGOCIO (CONVERTIDO A WEBP 1500PX) -->
                    <div class="space-y-4 pt-4 border-t border-slate-100">
                        <div class="border-b border-slate-100 pb-3">
                            <h2 class="text-sm font-bold uppercase tracking-wider text-[#0f172a] flex items-center gap-2">
                                <i class="fas fa-camera text-[#1d4ed8]"></i>
                                <span>3. Foto de Fachada o Logotipo (WebP 1500px)</span>
                            </h2>
                        </div>

                        <div>
                            <input type="file" id="biz-image-input" accept="image/*" class="w-full text-xs text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:border-0 file:text-xs file:font-bold file:uppercase file:bg-[#0f172a] file:text-white hover:file:bg-[#1d4ed8] file:cursor-pointer" />
                            <div id="biz-image-status" class="mt-2 text-xs font-semibold text-emerald-600 hidden"></div>
                        </div>
                    </div>

                    <!-- SUBMIT BANNER -->
                    <div class="pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <div class="text-xs text-slate-500">
                            <span class="font-bold text-emerald-700">✓ 1er Año Gratis:</span> Sin cobros iniciales ni comisiones.
                        </div>

                        <button 
                            type="submit" 
                            id="btn-biz-submit" 
                            class="w-full sm:w-auto px-8 py-3.5 bg-[#1d4ed8] hover:bg-[#1e40af] text-white font-bold text-xs uppercase tracking-wider transition-colors luxury-btn flex items-center justify-center gap-2 shadow-sm"
                        >
                            <span id="btn-biz-text">Publicar Negocio en el Directorio</span>
                            <i id="btn-biz-spinner" class="fas fa-circle-notch fa-spin hidden"></i>
                        </button>
                    </div>

                </form>

            </div>

        </div>
    </div>
</Layout>

<script>
    import { onAuthStateChanged } from "firebase/auth";
    import { doc, getDoc, setDoc, serverTimestamp } from "firebase/firestore";
    import { ref, uploadBytes, getDownloadURL } from "firebase/storage";
    import { auth, db, storage } from "../lib/firebase/client";
    import { convertToWebP } from "../lib/imageOptimizer";

    let currentUser: any = null;
    let optimizedBizImage: any = null;

    const selectEl = document.getElementById('biz-category-select') as HTMLSelectElement;
    const newCatWrapper = document.getElementById('new-category-wrapper');
    const newCatInput = document.getElementById('biz-new-category') as HTMLInputElement;

    selectEl?.addEventListener('change', () => {
        if (selectEl.value === 'NEW_CATEGORY') {
            newCatWrapper?.classList.remove('hidden');
            newCatInput?.setAttribute('required', 'true');
        } else {
            newCatWrapper?.classList.add('hidden');
            newCatInput?.removeAttribute('required');
        }
    });

    onAuthStateChanged(auth, async (user) => {
        if (!user) {
            window.location.href = '/auth';
            return;
        }
        currentUser = user;

        // Prefill whatsapp
        try {
            const uSnap = await getDoc(doc(db, "users", user.uid));
            if (uSnap.exists()) {
                const u = uSnap.data();
                const wInput = document.getElementById('biz-whatsapp') as HTMLInputElement;
                if (wInput && u.whatsapp) wInput.value = u.whatsapp;
            }
        } catch (e) {
            console.warn(e);
        }
    });

    // Image conversion to WebP 1500px
    const imgInput = document.getElementById('biz-image-input') as HTMLInputElement;
    const imgStatus = document.getElementById('biz-image-status');
    imgInput?.addEventListener('change', async () => {
        const file = imgInput.files?.[0];
        if (!file) return;

        try {
            if (imgStatus) {
                imgStatus.classList.remove('hidden');
                imgStatus.textContent = 'Procesando y convirtiendo imagen a WebP 1500px...';
            }
            optimizedBizImage = await convertToWebP(file, 1500, 1500, 0.88);
            if (imgStatus) {
                const kb = Math.round(optimizedBizImage.newSize / 1024);
                imgStatus.textContent = `✓ Imagen optimizada a WebP 1500px (${optimizedBizImage.width}x${optimizedBizImage.height}px, ${kb} KB)`;
            }
        } catch (e: any) {
            alert("Error al procesar imagen: " + e.message);
        }
    });

    const form = document.getElementById('business-form') as HTMLFormElement;
    const alertBox = document.getElementById('biz-alert');
    function showAlert(msg: string, isError = true) {
        if (!alertBox) return;
        alertBox.classList.remove('hidden', 'bg-red-50', 'text-red-700', 'border-red-200', 'bg-emerald-50', 'text-emerald-700', 'border-emerald-200');
        alertBox.classList.add(isError ? 'bg-red-50' : 'bg-emerald-50', isError ? 'text-red-700' : 'text-emerald-700', isError ? 'border-red-200' : 'border-emerald-200');
        alertBox.textContent = msg;
    }

    form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (!currentUser) {
            window.location.href = '/auth';
            return;
        }

        const name = (document.getElementById('biz-name') as HTMLInputElement).value.trim();
        let category = selectEl.value;
        if (category === 'NEW_CATEGORY') {
            category = newCatInput.value.trim();
        }
        const categorySlug = category.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-");

        const city = (document.getElementById('biz-city') as HTMLInputElement).value.trim() || 'Santo Domingo';
        const address = (document.getElementById('biz-address') as HTMLInputElement).value.trim();
        const description = (document.getElementById('biz-desc') as HTMLTextAreaElement).value.trim();

        const rawW = (document.getElementById('biz-whatsapp') as HTMLInputElement).value.trim();
        const digits = rawW.replace(/\D/g, '');
        const whatsapp = digits.startsWith('1') ? `+${digits}` : `+1${digits}`;
        const phone = (document.getElementById('biz-phone') as HTMLInputElement).value.trim();

        const btnText = document.getElementById('btn-biz-text');
        const spinner = document.getElementById('btn-biz-spinner');
        btnText?.classList.add('hidden');
        spinner?.classList.remove('hidden');
        showAlert('Registrando tu negocio...', false);

        try {
            const bizId = `biz-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`;
            let logoUrl = "https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?auto=format&fit=crop&w=800&q=80";

            if (optimizedBizImage) {
                const imgRef = ref(storage, `businesses/${bizId}/main_${Date.now()}.webp`);
                await uploadBytes(imgRef, optimizedBizImage.blob, { contentType: 'image/webp' });
                logoUrl = await getDownloadURL(imgRef);
            }

            const docData = {
                id: bizId,
                ownerId: currentUser.uid,
                name: name,
                category: category,
                categorySlug: categorySlug,
                city: city,
                address: address,
                description: description,
                whatsapp: whatsapp,
                phone: phone,
                logoUrl: logoUrl,
                isApproved: true,
                createdAt: serverTimestamp()
            };

            await setDoc(doc(db, "businesses", bizId), docData);

            showAlert('¡Tu negocio ha sido publicado con éxito! Ahora aparece en el directorio y en el Mega Menú.', false);
            setTimeout(() => {
                window.location.href = `/directorio?cat=${categorySlug}`;
            }, 1000);

        } catch (err: any) {
            btnText?.classList.remove('hidden');
            spinner?.classList.add('hidden');
            showAlert("Error al publicar: " + err.message, true);
        }
    });
</script>

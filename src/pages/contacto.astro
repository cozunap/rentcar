---
import Layout from '../layouts/Layout.astro';
---

<Layout 
    title="Contacto y Reservas | Tu Carro y Más Rent A Car Santo Domingo"
    description="Comunícate con Tu Carro y Más Rent A Car en Santo Domingo Este. Atención 24/7 directa por WhatsApp para cotizaciones de alquiler y reservas."
>
    <!-- Header Banner -->
    <div class="bg-[#0f172a] text-white py-16 text-center border-b border-slate-800">
        <div class="max-w-[1360px] mx-auto px-4 sm:px-6 lg:px-8">
            <span class="text-xs font-bold uppercase tracking-widest text-[#1d4ed8] mb-2 block">Atención Personalizada</span>
            <h1 class="text-3xl sm:text-5xl font-black mb-3 uppercase font-['Outfit',sans-serif] tracking-tight">Contacto Directo</h1>
            <p class="text-slate-300 text-sm max-w-2xl mx-auto">
                Estamos en Santo Domingo Este. Escríbenos o llámanos para cualquier consulta sobre reservas, traslados al aeropuerto o disponibilidad.
            </p>
        </div>
    </div>

    <!-- Contact Info and Map Area -->
    <section class="py-16 bg-[#f8fafc]">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                
                <!-- Info cards -->
                <div class="space-y-6">
                    <h2 class="text-2xl font-black text-[#0f172a] mb-4 uppercase font-['Outfit',sans-serif] tracking-tight">Información de Contacto</h2>
                    
                    <div class="flex items-start gap-4 p-6 bg-white border border-slate-200 luxury-card shadow-xs">
                        <div class="w-12 h-12 bg-blue-50 text-[#1d4ed8] border border-blue-100 flex items-center justify-center text-xl shrink-0">
                            <i class="fas fa-map-marker-alt"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-[#0f172a] text-base mb-1">Ubicación Principal</h3>
                            <p class="text-slate-600 text-sm">Santo Domingo Este y entregas en Aeropuerto Las Américas (SDQ), República Dominicana</p>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 p-6 bg-white border border-slate-200 luxury-card shadow-xs">
                        <div class="w-12 h-12 bg-emerald-50 text-[#15803d] border border-emerald-100 flex items-center justify-center text-xl shrink-0">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-[#0f172a] text-base mb-1">WhatsApp Directo 24/7</h3>
                            <p class="text-slate-600 text-sm mb-2">Respuesta en minutos para cotizaciones y disponibilidad inmediata.</p>
                            <a href="https://wa.me/18499154010" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-[#15803d] hover:text-[#166534]">
                                Enviar mensaje al (849) 915-4010 <i class="fas fa-arrow-right text-xs"></i>
                            </a>
                        </div>
                    </div>

                    <div class="flex items-start gap-4 p-6 bg-white border border-slate-200 luxury-card shadow-xs">
                        <div class="w-12 h-12 bg-blue-50 text-[#1d4ed8] border border-blue-100 flex items-center justify-center text-xl shrink-0">
                            <i class="fas fa-phone"></i>
                        </div>
                        <div>
                            <h3 class="font-bold text-[#0f172a] text-base mb-1">Teléfono Central</h3>
                            <a href="tel:+18499154010" class="text-slate-700 text-sm hover:text-[#1d4ed8] font-bold font-mono">(849) 915-4010</a>
                        </div>
                    </div>
                </div>

                <!-- Fast message box -->
                <div class="bg-white p-8 border border-slate-200 luxury-card shadow-xs flex flex-col justify-between">
                    <div>
                        <span class="text-xs font-bold uppercase tracking-widest text-[#1d4ed8] mb-1 block">Rápido y Sin Intermediarios</span>
                        <h3 class="text-2xl font-black text-[#0f172a] uppercase font-['Outfit',sans-serif] tracking-tight mb-4">¿Tienes alguna pregunta?</h3>
                        <p class="text-slate-600 text-sm mb-6 leading-relaxed">
                            Para máxima conveniencia, todas nuestras cotizaciones, confirmaciones de reserva y entregas se coordinan directamente a través de WhatsApp.
                        </p>
                    </div>
                    <div class="space-y-3 pt-4 border-t border-slate-100">
                        <a href="https://wa.me/18499154010?text=Hola,%20quisiera%20información%20sobre%20el%20alquiler%20de%20vehículos" target="_blank" rel="noopener noreferrer" class="w-full py-4 px-6 bg-[#15803d] hover:bg-[#166534] text-white font-bold text-xs uppercase tracking-wider text-center flex items-center justify-center gap-2 transition-colors luxury-btn shadow-sm">
                            <i class="fab fa-whatsapp text-lg"></i>
                            <span>Abrir Chat de WhatsApp</span>
                        </a>
                        <a href="/flota" class="w-full py-4 px-6 bg-[#0f172a] hover:bg-[#1d4ed8] text-white font-bold text-xs uppercase tracking-wider text-center block transition-colors luxury-btn">
                            Ver Vehículos Disponibles
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>
</Layout>

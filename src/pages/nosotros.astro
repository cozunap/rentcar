---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nosotros | Tu Carro y Más Rent A Car">
    <!-- Header Banner -->
    <div class="bg-[#212529] text-white py-16 text-center">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h1 class="text-3xl sm:text-4xl font-bold mb-3">Sobre Tu Carro y Más</h1>
            <p class="text-gray-400 text-base max-w-2xl mx-auto">
                Haciendo tu viaje cómodo, seguro y memorable en toda la República Dominicana.
            </p>
        </div>
    </div>

    <!-- Main About Content -->
    <section class="py-16 bg-white">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
                <div>
                    <span class="text-xs font-bold uppercase tracking-wider text-[#0d6efd] mb-2 block">Nuestra Misión</span>
                    <h2 class="text-3xl font-bold text-[#212529] mb-4">La Mejor Opción de Alquiler en Santo Domingo Este</h2>
                    <p class="text-gray-600 leading-relaxed mb-4">
                        En <strong>Tu Carro y Más Rent A Car</strong> nos especializamos en ofrecer vehículos confiables, limpios y completamente asegurados para que disfrutes de tu estadía en el país sin complicaciones.
                    </p>
                    <p class="text-gray-600 leading-relaxed mb-6">
                        Conectamos a clientes directamente con propietarios verificados a través de WhatsApp, eliminando burocracias y permitiendo una comunicación fluida, transparente y humana.
                    </p>
                    <a href="https://wa.me/18499154010" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#198754] hover:bg-[#157347] text-white font-semibold text-sm transition-colors">
                        <i class="fab fa-whatsapp text-lg"></i>
                        <span>Contactar por WhatsApp (849) 915-4010</span>
                    </a>
                </div>

                <div class="rounded-xl overflow-hidden shadow-lg border border-gray-100">
                    <img 
                        src="https://images.unsplash.com/photo-1570737543098-0983d88f796d?q=80&w=1286&auto=format&fit=crop" 
                        alt="República Dominicana Carretera" 
                        class="w-full h-80 object-cover"
                    />
                </div>
            </div>

            <!-- Features Highlights -->
            <div class="pt-10 border-t border-gray-100">
                <div class="text-center mb-10">
                    <h3 class="text-2xl font-bold text-[#212529]">Nuestros Pilares</h3>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
                    <div class="p-6 rounded-lg bg-[#f8f9fa] border border-gray-100">
                        <i class="fas fa-calendar-check text-4xl text-[#0d6efd] mb-3"></i>
                        <h4 class="font-bold text-lg text-[#212529] mb-2">Reserva Fácil</h4>
                        <p class="text-gray-500 text-sm">Reserva en minutos directo al WhatsApp del dueño.</p>
                    </div>
                    <div class="p-6 rounded-lg bg-[#f8f9fa] border border-gray-100">
                        <i class="fas fa-shield-alt text-4xl text-[#0d6efd] mb-3"></i>
                        <h4 class="font-bold text-lg text-[#212529] mb-2">Seguro Completo</h4>
                        <p class="text-gray-500 text-sm">Cobertura y asistencia vial en cada kilómetro.</p>
                    </div>
                    <div class="p-6 rounded-lg bg-[#f8f9fa] border border-gray-100">
                        <i class="fas fa-headset text-4xl text-[#0d6efd] mb-3"></i>
                        <h4 class="font-bold text-lg text-[#212529] mb-2">Soporte 24/7</h4>
                        <p class="text-gray-500 text-sm">Atención continua ante cualquier emergencia o duda.</p>
                    </div>
                </div>
            </div>

        </div>
    </section>
</Layout>

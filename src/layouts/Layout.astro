---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const currentPath = Astro.url.pathname;
const canonicalURL = Astro.props.canonical || new URL(currentPath, 'https://tucarroymas.com').href;

const { 
  title = "TuCarroYMás | Car Dealer & Marketplace Multicategoría República Dominicana", 
  description = "Portal de compra, venta e intercambio de vehículos, camiones, transporte acuático y maquinaria en República Dominicana.",
  ogImage = "https://tucarroymas.com/og-image.jpg"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Google Fonts: Inter & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="bg-white text-[#1e293b] font-['Inter',sans-serif] flex flex-col min-h-screen antialiased selection:bg-[#D54000] selection:text-white">
    <Header />
    <main class="flex-1">
        <slot />
    </main>
    <Footer />
</body>
</html>

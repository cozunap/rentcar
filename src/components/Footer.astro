                    <li><a href="/publicar" class="hover:text-white transition-colors">Publicar Mi Vehículo</a></li>
                    <li><a href="/auth" class="hover:text-white transition-colors">Iniciar Sesión / Registro</a></li>
                </ul>
            </div>

            <!-- Col 3: Contacto Directo -->
            <div>
                <h4 class="text-xs font-bold uppercase tracking-widest text-[#0d6efd] mb-4">Ubicación y Soporte</h4>
                <ul class="space-y-3 text-sm text-slate-300">
                    <li class="flex items-start gap-3">
                        <i class="fas fa-map-marker-alt text-[#0d6efd] mt-1 shrink-0"></i>
                        <span>Santo Domingo Este, República Dominicana</span>
                    </li>
                    <li class="flex items-center gap-3">
                        <i class="fas fa-phone text-[#0d6efd] shrink-0"></i>
                        <a href="tel:+18499154010" class="hover:text-white transition-colors">(849) 915-4010</a>

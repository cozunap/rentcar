                    </a>
                    <a href="tel:+18499154010" class="w-9 h-9 rounded-lg bg-white/10 text-white flex items-center justify-center hover:bg-[#0d6efd] transition-colors" title="Llamar">
                        <i class="fas fa-phone"></i>
                    </a>
                </div>
            </div>

            <!-- Col 2: Enlaces Rápidos -->
            <div>
                <h4 class="text-xs font-bold uppercase tracking-widest text-[#0d6efd] mb-4">Navegación</h4>
                <ul class="space-y-2.5 text-sm text-slate-300">

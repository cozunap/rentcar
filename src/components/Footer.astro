<footer id="contact" class="bg-[#0d1f3c] text-white pt-16 pb-10 border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
            
            <!-- Col 1: Brand Info -->
            <div class="md:col-span-2 space-y-4">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-[#0d6efd] text-white flex items-center justify-center shadow-lg">
                        <i class="fas fa-car-side text-lg"></i>
                    </div>
                    <span class="font-extrabold text-2xl tracking-tight text-white">
                        Tu Carro <span class="text-[#0d6efd]">y Más</span>
                    </span>
                </div>
                <p class="text-slate-300 text-sm leading-relaxed max-w-md">
                    Tu Carro y Más Rent A Car en Santo Domingo Este. Plataforma peer-to-peer de alquiler de vehículos y SUVs premium en República Dominicana. Conexión directa y transparente entre dueños de vehículos y arrendatarios vía WhatsApp.
                </p>
                <div class="flex items-center gap-3 pt-2">
                    <a href="https://wa.me/18499154010" target="_blank" rel="noopener noreferrer" class="w-9 h-9 rounded-lg bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center hover:bg-emerald-500 hover:text-white transition-colors" title="WhatsApp">

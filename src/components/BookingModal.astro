<!-- RentGo Style CTA Quick Booking Modal (JetPopup + JetBooking Pattern) -->
<div 
  id="rentgo-booking-modal" 
  class="fixed inset-0 z-50 pointer-events-none transition-all duration-300 opacity-0 flex items-center justify-center p-3 sm:p-4 md:p-6" 
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
>
    <!-- Backdrop Blur Overlay -->
    <div 
      id="rentgo-modal-backdrop" 
      class="absolute inset-0 bg-[#0f172a]/75 backdrop-blur-md transition-opacity duration-300 opacity-0 cursor-pointer"
    ></div>

    <!-- Modal Box (Strict 0px square, 3D Elevation, Executive Navy/Gold Finish) -->
    <div 
      id="rentgo-modal-card" 
      class="relative w-full max-w-2xl bg-white border-2 border-slate-900 shadow-2xl flex flex-col transform scale-95 transition-all duration-300 ease-out pointer-events-auto max-h-[92vh] overflow-hidden z-10"
      style="border-radius: 0px !important;"
    >
        <!-- Modal Top Bar -->
        <div class="px-5 py-3.5 bg-[#0f172a] text-white flex items-center justify-between border-b border-slate-800">
            <div class="flex items-center gap-2.5">
                <span class="px-2 py-0.5 text-[10px] font-black uppercase tracking-widest bg-[#1d4ed8] text-white">
                    RentGo Direct
                </span>
                <span id="rentgo-modal-badge" class="text-xs font-semibold text-slate-300 flex items-center gap-1.5">
                    <span class="w-2 h-2 bg-emerald-400 animate-pulse"></span>
                    Confirmación Inmediata
                </span>
            </div>
            <button 
              id="rentgo-modal-close" 
              type="button" 
              aria-label="Cerrar ventana" 
              class="w-8 h-8 bg-slate-800 hover:bg-red-600 text-slate-300 hover:text-white flex items-center justify-center transition-colors luxury-btn"
              style="border-radius: 0px !important;"
            >
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Scrollable Modal Body -->
        <div class="flex-1 overflow-y-auto p-5 sm:p-6 space-y-5">

            <!-- Car Hero Header -->
            <div class="flex flex-col sm:flex-row gap-4 items-center bg-slate-50 border border-slate-200 p-4">
                <div class="w-full sm:w-44 h-36 bg-white border border-slate-200 p-2 flex items-center justify-center shrink-0 overflow-hidden">
                    <img 
                      id="rentgo-modal-img" 
                      src="/Honda.webp" 
                      alt="Vehículo" 
                      class="w-full h-full object-contain transition-transform duration-300 hover:scale-105" 
                    />
                </div>
                <div class="flex-1 text-center sm:text-left w-full">
                    <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1">
                        <span id="rentgo-modal-category" class="px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider bg-blue-100 text-[#1d4ed8]">
                            SUV
                        </span>
                        <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 border border-emerald-200">
                            <i class="fas fa-shield-alt text-emerald-600 me-1"></i> Seguro Incluido
                        </span>
                    </div>
                    <h3 id="rentgo-modal-title" class="text-xl sm:text-2xl font-black text-[#0f172a] tracking-tight">
                        Cargando Vehículo...
                    </h3>
                    <p id="rentgo-modal-city" class="text-xs text-slate-500 mt-1 flex items-center justify-center sm:justify-start gap-1">
                        <i class="fas fa-map-marker-alt text-[#1d4ed8]"></i>
                        <span>Santo Domingo Este, República Dominicana</span>
                    </p>
                    <div class="mt-2 text-lg sm:text-xl font-black text-[#1d4ed8]">
                        <span id="rentgo-modal-rate">$50</span>
                        <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">/ día</span>
                    </div>
                </div>
            </div>

            <!-- Specs Grid (RentGo Standard) -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-xs">
                <div class="p-2.5 bg-slate-50 border border-slate-200">
                    <i class="fas fa-user-friends text-[#1d4ed8] text-sm mb-1 block"></i>
                    <span class="text-[10px] text-slate-400 uppercase block font-bold">Asientos</span>
                    <strong id="rentgo-modal-seats" class="text-slate-800 font-bold">5 Plazas</strong>
                </div>
                <div class="p-2.5 bg-slate-50 border border-slate-200">
                    <i class="fas fa-suitcase-rolling text-[#1d4ed8] text-sm mb-1 block"></i>
                    <span class="text-[10px] text-slate-400 uppercase block font-bold">Maletas</span>
                    <strong id="rentgo-modal-luggage" class="text-slate-800 font-bold">3-4 Maletas</strong>
                </div>
                <div class="p-2.5 bg-slate-50 border border-slate-200">
                    <i class="fas fa-cogs text-[#1d4ed8] text-sm mb-1 block"></i>
                    <span class="text-[10px] text-slate-400 uppercase block font-bold">Transmisión</span>
                    <strong id="rentgo-modal-trans" class="text-slate-800 font-bold">Automática</strong>
                </div>
                <div class="p-2.5 bg-slate-50 border border-slate-200">
                    <i class="fas fa-gas-pump text-[#1d4ed8] text-sm mb-1 block"></i>
                    <span class="text-[10px] text-slate-400 uppercase block font-bold">Combustible</span>
                    <strong id="rentgo-modal-fuel" class="text-slate-800 font-bold">Gasolina</strong>
                </div>
            </div>

            <!-- JetBooking Date Selection & Live Quote Engine -->
            <div class="bg-gradient-to-br from-slate-50 to-blue-50/40 p-4 sm:p-5 border-2 border-slate-200 space-y-3.5">
                <div class="flex items-center justify-between border-b border-slate-200 pb-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-[#0f172a] flex items-center gap-1.5">
                        <i class="fas fa-calendar-check text-[#1d4ed8]"></i> Fechas de Reserva
                    </span>
                    <span id="rentgo-modal-days-badge" class="text-xs font-bold bg-[#1d4ed8] text-white px-2.5 py-0.5">
                        3 días
                    </span>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-600 mb-1" for="rentgo-date-start">
                            <i class="fas fa-plane-arrival text-slate-400 me-1"></i> Recogida / Entrega
                        </label>
                        <input 
                            type="date" 
                            id="rentgo-date-start" 
                            class="w-full text-xs font-bold p-2.5 bg-white border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8] shadow-inner"
                            style="border-radius: 0px !important;"
                        />
                    </div>
                    <div>
                        <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-600 mb-1" for="rentgo-date-end">
                            <i class="fas fa-plane-departure text-slate-400 me-1"></i> Retorno / Devolución
                        </label>
                        <input 
                            type="date" 
                            id="rentgo-date-end" 
                            class="w-full text-xs font-bold p-2.5 bg-white border border-slate-300 text-slate-800 focus:outline-none focus:border-[#1d4ed8] shadow-inner"
                            style="border-radius: 0px !important;"
                        />
                    </div>
                </div>

                <!-- Live Price Calculation Breakdown -->
                <div class="bg-white p-3.5 border border-slate-200 flex items-center justify-between">
                    <div>
                        <span class="text-[10px] uppercase tracking-wider text-slate-400 font-semibold block">Total Estimado</span>
                        <span id="rentgo-modal-calc-text" class="text-xs text-slate-600 font-medium">$50 USD x 3 días</span>
                    </div>
                    <div class="text-right">
                        <span id="rentgo-modal-total" class="text-2xl font-black text-[#15803d] font-mono">$150 USD</span>
                    </div>
                </div>
            </div>

            <!-- RentGo Trust Badges -->
            <div class="grid grid-cols-3 gap-2 text-center text-[10px] text-slate-600 pt-1">
                <div class="flex items-center justify-center gap-1">
                    <i class="fas fa-check text-emerald-600"></i> Kilometraje Ilimitado
                </div>
                <div class="flex items-center justify-center gap-1">
                    <i class="fas fa-check text-emerald-600"></i> Asistencia Vial 24/7
                </div>
                <div class="flex items-center justify-center gap-1">
                    <i class="fas fa-check text-emerald-600"></i> Sin Cargos Ocultos
                </div>
            </div>

        </div>

        <!-- Sticky Modal Footer CTA -->
        <div class="p-4 sm:p-5 border-t border-slate-200 bg-white shadow-lg space-y-2">
            <a 
              id="rentgo-modal-whatsapp-btn" 
              href="#" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="w-full py-4 px-6 bg-[#15803d] hover:bg-[#166534] text-white font-black text-sm uppercase tracking-wider flex items-center justify-center gap-2.5 transition-all luxury-btn shadow-md"
              style="border-radius: 0px !important;"
            >
                <i class="fab fa-whatsapp text-2xl"></i>
                <span id="rentgo-modal-btn-label">Confirmar Reserva por WhatsApp</span>
            </a>
            <p class="text-[11px] text-center text-slate-400">
                Atención personalizada directa sin intermediarios. Entrega disponible en SDQ y Santo Domingo Este.
            </p>
        </div>

    </div>
</div>

---
// MegaMenu Header Component - Crocoblock Car Dealer New Pattern
import { TRANSPORT_TYPES } from "../lib/carDealerData";
---

<header class="sticky top-0 z-50 bg-[#070b16]/95 backdrop-blur-md border-b border-white/10 text-white">
  <!-- Top Utility Bar (CarDealer JetBlocks Pattern) -->
  <div class="border-b border-white/5 bg-[#040711] text-xs py-2 px-4 sm:px-8 hidden md:block">
    <div class="max-w-7xl mx-auto flex items-center justify-between text-slate-400">
      <div class="flex items-center gap-6">
        <span class="flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
          República Dominicana (Cobertura Nacional)
        </span>
        <span class="flex items-center gap-1.5 hover:text-white transition-colors">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          Soporte VIP: +1 (829) 555-0199
        </span>
        <span class="text-blue-400/90 font-medium">⚡ 0% Comisión al Vender</span>
      </div>
      <div class="flex items-center gap-4">
        <span class="text-slate-400">Plataforma Digital de Concesionarios</span>
        <a href="/auth" class="text-slate-300 hover:text-white flex items-center gap-1.5 transition-colors">
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
          Ingresar / Registro
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-3 group">
      <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center font-black text-xl text-white shadow-lg shadow-blue-500/20 group-hover:scale-105 transition-transform duration-200">
        TC
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-black tracking-wider uppercase text-white flex items-center gap-1">
          TuCarro<span class="text-blue-500">YMás</span>
        </span>
        <span class="text-[9px] uppercase tracking-widest text-slate-400 font-semibold -mt-1">
          Car Dealer & Marketplace
        </span>
      </div>
    </a>

    <!-- Desktop Mega Menu Navigation (JetMenu Crocoblock Pattern) -->
    <nav class="hidden lg:flex items-center gap-1">
      <a href="/" class="px-3.5 py-2 text-sm font-semibold text-slate-200 hover:text-white hover:bg-white/5 transition-all">
        Inicio
      </a>

      <!-- MEGA MENU: TIPOS DE TRANSPORTE (CarDealer Pattern) -->
      <div class="relative group">
        <button 
          id="mega-menu-btn"
          type="button" 
          class="px-3.5 py-2 text-sm font-semibold text-slate-200 hover:text-white flex items-center gap-1.5 group-hover:bg-white/5 transition-all"
        >
          <span class="text-blue-400 font-bold">Tipos de Transporte</span>
          <svg class="w-4 h-4 text-slate-400 group-hover:rotate-180 group-hover:text-white transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>

        <!-- Dropdown Mega Menu Container -->
        <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all duration-200 w-[920px]">
          <div class="bg-[#0b1329] border border-white/10 shadow-2xl p-6 grid grid-cols-3 gap-6 backdrop-blur-xl">
            <!-- Transport Categories List (6 Categories from Crocoblock Car Dealer New) -->
            <div class="col-span-2 grid grid-cols-2 gap-3 border-r border-white/10 pr-6">
              {TRANSPORT_TYPES.map(cat => (
                <a 
                  href={`/vehiculos?type=${cat.id}`}
                  class="flex items-start gap-3.5 p-3 hover:bg-white/5 transition-all border border-transparent hover:border-white/10 group/item"
                >
                  <div class="w-10 h-10 bg-blue-600/10 border border-blue-500/20 text-blue-400 flex items-center justify-center shrink-0 group-hover/item:bg-blue-600 group-hover/item:text-white transition-colors">
                    {cat.id === "cars" && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 17a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4zM5 11l1.5-4.5A2 2 0 018.4 5h7.2a2 2 0 011.9 1.5L19 11M3 11h18v6H3v-6z"></path></svg>}
                    {cat.id === "trucks-buses" && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10M13 16h8l2-4V9a1 1 0 00-1-1h-9M13 16H9m-4 0H3"></path></svg>}
                    {cat.id === "special-machinery" && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>}
                    {cat.id === "water-transport" && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>}
                    {cat.id === "mototechnics" && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path></svg>}
                    {cat.id === "machinery" && <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>}
                  </div>
                  <div>
                    <h4 class="font-bold text-sm text-white group-hover/item:text-blue-400 transition-colors">
                      {cat.nameEs}
                    </h4>
                    <p class="text-xs text-slate-400 line-clamp-1 mt-0.5 font-normal">
                      {cat.name} ({cat.description.split(",")[0]})
                    </p>
                  </div>
                </a>
              ))}
            </div>

            <!-- Featured Vehicle Preview inside Dropdown (JetMenu Listing Preview) -->
            <div class="flex flex-col justify-between bg-black/30 p-4 border border-white/5">
              <div>
                <span class="inline-block px-2 py-0.5 text-[10px] uppercase font-black tracking-wider bg-blue-600 text-white mb-2">
                  Destacado CarDealer
                </span>
                <h5 class="text-sm font-bold text-white">Directorio Dominicano Multicategoría</h5>
                <p class="text-xs text-slate-400 mt-1">
                  Encuentra desde automóviles y lanchas deportivas hasta camiones pesados 18-wheelers y maquinaria de construcción.
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-white/10">
                <a 
                  href="/vehiculos" 
                  class="w-full inline-flex items-center justify-center gap-2 py-2 px-3 text-xs font-bold uppercase tracking-wider bg-white/10 hover:bg-blue-600 text-white transition-all text-center"
                >
                  Ver Todo el Inventario
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a href="/vehiculos" class="px-3.5 py-2 text-sm font-semibold text-slate-200 hover:text-white hover:bg-white/5 transition-all">
        Inventario General
      </a>
      <a href="/nosotros" class="px-3.5 py-2 text-sm font-semibold text-slate-200 hover:text-white hover:bg-white/5 transition-all">
        Nosotros
      </a>
      <a href="/contacto" class="px-3.5 py-2 text-sm font-semibold text-slate-200 hover:text-white hover:bg-white/5 transition-all">
        Contacto
      </a>
    </nav>

    <!-- Right Side Actions: JetBlocks Login + JetFormBuilder Primary CTA -->
    <div class="flex items-center gap-3">
      <a 
        href="/publicar" 
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 text-xs font-black uppercase tracking-wider text-white bg-blue-600 hover:bg-blue-500 shadow-md shadow-blue-600/30 transition-all active:scale-95"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        Publicar Anuncio (GRATIS)
      </a>

      <!-- Mobile Hamburger Button -->
      <button 
        id="mobile-menu-btn"
        type="button" 
        aria-label="Abrir Menú Móvil"
        class="lg:hidden p-2 text-slate-300 hover:text-white hover:bg-white/5"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 bg-[#070b16] px-4 py-6 space-y-4">
    <div class="space-y-1">
      <a href="/" class="block py-2 text-base font-semibold text-white">Inicio</a>
      <a href="/vehiculos" class="block py-2 text-base font-semibold text-white">Inventario Completo</a>
      <div class="py-2">
        <span class="block text-xs uppercase tracking-wider text-blue-400 font-bold mb-2">Tipos de Transporte:</span>
        <div class="grid grid-cols-1 gap-1.5 pl-3 border-l-2 border-blue-500/30">
          {TRANSPORT_TYPES.map(cat => (
            <a href={`/vehiculos?type=${cat.id}`} class="py-1 text-sm text-slate-300 hover:text-white flex items-center justify-between">
              <span>{cat.nameEs}</span>
              <span class="text-xs text-slate-500">{cat.name}</span>
            </a>
          ))}
        </div>
      </div>
      <a href="/nosotros" class="block py-2 text-base font-semibold text-slate-300">Nosotros</a>
      <a href="/contacto" class="block py-2 text-base font-semibold text-slate-300">Contacto</a>
    </div>

    <div class="pt-4 border-t border-white/10 flex flex-col gap-2.5">
      <a 
        href="/publicar" 
        class="w-full py-2.5 text-center text-xs font-black uppercase tracking-wider text-white bg-blue-600 hover:bg-blue-500"
      >
        + Publicar Anuncio (Gratis)
      </a>
      <a 
        href="/auth" 
        class="w-full py-2.5 text-center text-xs font-bold uppercase tracking-wider text-slate-300 hover:text-white bg-white/5"
      >
        Ingresar a mi Cuenta
      </a>
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");

  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener("click", () => {
      mobileMenu.classList.toggle("hidden");
    });
  }
</script>

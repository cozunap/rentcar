---
const pathname = Astro.url.pathname;
const isCurrent = (path: string) => (pathname === path || (path !== '/' && pathname.startsWith(path)));
---

<header id="main-header" class="fixed top-0 left-0 w-full z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-all duration-300 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-[#0d6efd] text-white flex items-center justify-center shadow-md group-hover:bg-[#0b5ed7] transition-colors">
                <i class="fas fa-car-side text-lg"></i>
            </div>
            <div class="flex flex-col">
                <span class="font-extrabold text-lg sm:text-xl text-[#0d1f3c] tracking-tight leading-tight group-hover:text-[#0d6efd] transition-colors">
                    Tu Carro <span class="text-[#0d6efd] font-black">y Más</span>
                </span>
                <span class="text-[10px] uppercase tracking-widest text-slate-500 font-semibold">Rent A Car • RD</span>
            </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-8">
            <a href="/" class={`text-sm font-semibold transition-colors ${isCurrent('/') ? 'text-[#0d6efd]' : 'text-slate-600 hover:text-[#0d6efd]'}`}>
                Inicio
            </a>
            <a href="/#fleet" class="text-sm font-semibold text-slate-600 hover:text-[#0d6efd] transition-colors">
                Flota de Autos
            </a>
            <a href="/#features" class="text-sm font-semibold text-slate-600 hover:text-[#0d6efd] transition-colors">
                Por Qué Elegirnos
            </a>
            <a href="/#contact" class="text-sm font-semibold text-slate-600 hover:text-[#0d6efd] transition-colors">
                Contacto
            </a>
        </nav>

        <!-- Right Action Buttons -->
        <div class="hidden sm:flex items-center gap-3">
            <a href="/publicar" class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg border border-[#0d6efd] text-[#0d6efd] hover:bg-[#0d6efd] hover:text-white font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-sm">
                <i class="fas fa-plus-circle"></i>
                <span>Publicar Auto</span>
            </a>

            <!-- Auth Button (Client-side reactive) -->
            <div id="auth-header-slot">
                <a href="/auth" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-[#0d6efd] hover:bg-[#0b5ed7] text-white font-bold text-xs uppercase tracking-wider transition-all duration-200 shadow-md hover:shadow-lg">
                    <i class="fas fa-user-circle text-sm"></i>
                    <span>Ingresar</span>
                </a>
            </div>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <div class="flex items-center gap-2 md:hidden">
            <a href="/publicar" class="p-2 text-[#0d6efd] hover:bg-slate-100 rounded-lg text-sm" title="Publicar Auto">
                <i class="fas fa-plus-circle text-lg"></i>
            </a>
            <button id="mobile-menu-btn" type="button" aria-label="Abrir menú" class="w-10 h-10 flex items-center justify-center text-slate-700 hover:text-[#0d6efd] hover:bg-slate-100 rounded-lg transition-colors">
                <i class="fas fa-bars text-xl" id="menu-icon"></i>
            </button>
        </div>

    </div>

    <!-- Mobile Navigation Drawer -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-6 space-y-3 shadow-lg">
        <a href="/" class="block px-3 py-2 rounded-md font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#0d6efd]">
            <i class="fas fa-home w-6 text-slate-400"></i> Inicio
        </a>
        <a href="/#fleet" class="block px-3 py-2 rounded-md font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#0d6efd]">
            <i class="fas fa-car w-6 text-slate-400"></i> Ver Flota
        </a>
        <a href="/#features" class="block px-3 py-2 rounded-md font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#0d6efd]">
            <i class="fas fa-shield-alt w-6 text-slate-400"></i> Por Qué Elegirnos
        </a>
        <a href="/#contact" class="block px-3 py-2 rounded-md font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#0d6efd]">
            <i class="fas fa-phone-alt w-6 text-slate-400"></i> Contacto Directo
        </a>
        <div class="pt-3 border-t border-slate-100 flex flex-col gap-2">
            <a href="/publicar" class="w-full text-center py-2.5 rounded-lg border border-[#0d6efd] text-[#0d6efd] font-bold text-xs uppercase tracking-wider">
                <i class="fas fa-plus-circle me-1"></i> Publicar Mi Auto
            </a>
            <div id="mobile-auth-slot">
                <a href="/auth" class="w-full block text-center py-2.5 rounded-lg bg-[#0d6efd] text-white font-bold text-xs uppercase tracking-wider">
                    <i class="fas fa-user-circle me-1"></i> Iniciar Sesión / Registro
                </a>
            </div>
        </div>
    </div>
</header>

<div class="h-20"></div>

<script>
    import { onAuthStateChanged, signOut } from "firebase/auth";
    import { auth } from "../lib/firebase/client";

    // Mobile menu toggle
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    if (menuBtn && mobileMenu && menuIcon) {
        menuBtn.addEventListener('click', () => {
            const isHidden = mobileMenu.classList.contains('hidden');
            if (isHidden) {
                mobileMenu.classList.remove('hidden');
                menuIcon.classList.remove('fa-bars');
                menuIcon.classList.add('fa-times');
            } else {
                mobileMenu.classList.add('hidden');
                menuIcon.classList.remove('fa-times');
                menuIcon.classList.add('fa-bars');
            }
        });
    }

    // Reactive Auth status
    const desktopSlot = document.getElementById('auth-header-slot');
    const mobileSlot = document.getElementById('mobile-auth-slot');

    onAuthStateChanged(auth, (user) => {
        if (user) {
            const displayName = user.displayName || user.email?.split('@')[0] || 'Mi Perfil';
            const htmlDesktop = `
                <div class="flex items-center gap-2">
                    <a href="/panel" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs uppercase tracking-wider transition-colors">
                        <i class="fas fa-gauge text-[#0d6efd]"></i>
                        <span class="max-w-[120px] truncate">${displayName}</span>
                    </a>
                    <button id="logout-btn-header" title="Cerrar sesión" class="p-2 text-slate-400 hover:text-red-600 transition-colors">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            `;
            const htmlMobile = `
                <div class="flex gap-2">
                    <a href="/panel" class="flex-1 text-center py-2.5 rounded-lg bg-slate-100 text-slate-800 font-bold text-xs uppercase tracking-wider">
                        <i class="fas fa-gauge text-[#0d6efd] me-1"></i> Mi Panel (${displayName})
                    </a>
                    <button id="mobile-logout-btn" class="px-4 py-2.5 rounded-lg bg-red-50 text-red-600 font-bold text-xs">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            `;

            if (desktopSlot) desktopSlot.innerHTML = htmlDesktop;
            if (mobileSlot) mobileSlot.innerHTML = htmlMobile;

            document.getElementById('logout-btn-header')?.addEventListener('click', () => signOut(auth));
            document.getElementById('mobile-logout-btn')?.addEventListener('click', () => signOut(auth));
        }
    });
</script>

---
import { MARKETPLACE_CATEGORIES } from '../lib/constants';

const pathname = Astro.url.pathname;
const isCurrent = (path: string) => pathname === path || (path !== '/' && pathname.startsWith(path));
---

<header class="sticky top-0 z-50 bg-[#090e1a] border-b border-slate-800/80 shadow-2xl transition-all">
    <!-- Top Utility Bar: Marketplace Standard -->
    <div class="bg-[#040711] border-b border-slate-800/60 text-[11px] text-slate-400 py-1.5 hidden md:block">
        <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="text-slate-300 font-semibold flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    Dealer Digital Multi-Categoría • Carros, Camionetas, Motos, Botes y Pesados
                </span>
                <span class="text-slate-700">|</span>
                <span class="text-slate-400">Publicación 100% Gratuita para Particulares y Concesionarios</span>
            </div>
            <div class="flex items-center gap-4 text-slate-300">
                <a href="https://wa.me/18499154010" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-400 flex items-center gap-1.5 transition-colors">
                    <i class="fab fa-whatsapp text-emerald-400"></i> WhatsApp Dealers: +1 (849) 915-4010
                </a>
                <span class="text-slate-700">•</span>
                <span class="text-slate-400"><i class="fas fa-globe text-[#38bdf8] me-1"></i> Cobertura Nacional e Internacional</span>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-6">
        
        <!-- Brand Logo (High-End Automotive & Marine Portal) -->
        <a href="/" class="flex items-center gap-3.5 shrink-0 group">
            <div class="w-12 h-12 bg-gradient-to-br from-[#2563eb] to-[#1d4ed8] text-white flex items-center justify-center font-black text-xl shadow-lg border border-blue-400/30 group-hover:scale-105 transition-transform" style="border-radius: 0px !important;">
                <i class="fas fa-shield-halved text-xl"></i>
            </div>
            <div class="flex flex-col">
                <div class="flex items-baseline gap-1">
                    <span class="font-black text-2xl sm:text-[1.7rem] tracking-tight text-white uppercase font-['Outfit',sans-serif] leading-none">
                        TUCARRO<span class="text-[#38bdf8]">YMÁS</span>
                    </span>
                    <span class="text-[9px] font-black uppercase text-emerald-400 bg-emerald-950/80 border border-emerald-500/40 px-1 py-0.2">DEALER</span>
                </div>
                <span class="text-[9.5px] uppercase tracking-[0.24em] text-slate-400 font-bold block mt-1">
                    CARROS • CAMIONETAS • MOTOS • BOTES
                </span>
            </div>
        </a>

        <!-- Desktop Navigation Links (Direct Category Dropdown + Main Links) -->
        <nav class="hidden lg:flex items-center gap-8 text-[13px] font-bold uppercase tracking-wider">
            <!-- Categorías Dropdown -->
            <div class="relative group py-2">
                <button type="button" class="flex items-center gap-1.5 text-slate-200 hover:text-[#38bdf8] transition-colors">
                    <i class="fas fa-layer-group text-xs text-[#38bdf8]"></i>
                    <span>Categorías</span>
                    <i class="fas fa-chevron-down text-[9px] text-slate-400 group-hover:rotate-180 transition-transform"></i>
                </button>
                <div class="absolute top-full -left-4 w-72 bg-[#090e1a] border-2 border-slate-800 shadow-2xl p-3 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 space-y-1" style="border-radius: 0px !important;">
                    {MARKETPLACE_CATEGORIES.map(cat => (
                        <a href={`/vehiculos?categoria=${cat.id}`} class="flex items-center gap-3 p-2.5 text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">
                            <i class={`fas ${cat.icon} text-sm text-[#38bdf8] w-5 text-center`}></i>
                            <div>
                                <span class="block text-xs font-bold">{cat.name}</span>
                                <span class="block text-[10px] text-slate-400 font-normal lowercase">{cat.description}</span>
                            </div>
                        </a>
                    ))}
                </div>
            </div>

            <a 
              href="/vehiculos" 
              class={`py-2 transition-colors flex items-center gap-1.5 ${isCurrent('/vehiculos') ? 'text-[#38bdf8] border-b-2 border-[#38bdf8]' : 'text-slate-200 hover:text-[#38bdf8]'}`}
            >
                <i class="fas fa-car text-xs text-[#38bdf8]"></i>
                <span>Ver Inventario</span>
            </a>

            <a 
              href="/nosotros" 
              class={`py-2 transition-colors ${isCurrent('/nosotros') ? 'text-[#38bdf8] border-b-2 border-[#38bdf8]' : 'text-slate-200 hover:text-[#38bdf8]'}`}
            >
                Nosotros
            </a>

            <a 
              href="/contacto" 
              class={`py-2 transition-colors ${isCurrent('/contacto') ? 'text-[#38bdf8] border-b-2 border-[#38bdf8]' : 'text-slate-200 hover:text-[#38bdf8]'}`}
            >
                Contacto
            </a>
        </nav>

        <!-- Right Side Primary Action: Vender Vehículo (Gratis) + Auth -->
        <div class="hidden sm:flex items-center gap-3 shrink-0">
            <!-- Vender Vehículo -->
            <a 
              href="/publicar" 
              class="px-5 py-3 text-xs font-black uppercase tracking-wider bg-[#15803d] hover:bg-[#166534] text-white flex items-center gap-2 luxury-btn shadow-lg"
              style="border-radius: 0px !important;"
            >
                <i class="fas fa-plus-circle text-sm"></i>
                <span>Publicar Vehículo</span>
                <span class="bg-black/30 text-emerald-300 text-[9px] px-1.5 py-0.5 font-black">GRATIS</span>
            </a>

            <!-- User Auth -->
            <div id="auth-header-btn">
                <a 
                  href="/auth" 
                  class="px-4 py-3 bg-slate-800 hover:bg-slate-700 text-white text-xs font-bold uppercase tracking-wider border border-slate-700 luxury-btn"
                  style="border-radius: 0px !important;"
                >
                    <i class="fas fa-user-circle me-1.5 text-slate-400"></i> Mi Cuenta
                </a>
            </div>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <div class="flex items-center gap-2 lg:hidden">
            <a href="/publicar" class="px-3 py-1.5 text-xs font-black bg-[#15803d] text-white" style="border-radius: 0px !important;">
                Publicar
            </a>
            <button id="mobile-menu-btn" type="button" aria-label="Abrir menú" class="w-10 h-10 flex items-center justify-center text-white bg-slate-800 border border-slate-700" style="border-radius: 0px !important;">
                <i class="fas fa-bars text-base" id="menu-icon"></i>
            </button>
        </div>

    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-800 bg-[#090e1a] px-4 py-6 space-y-3 shadow-2xl">
        <a href="/" class="block py-2.5 text-sm font-bold text-white border-b border-slate-800">
            <i class="fas fa-home me-2 text-[#38bdf8]"></i> Inicio
        </a>
        <a href="/vehiculos" class="block py-2.5 text-sm font-bold text-white border-b border-slate-800">
            <i class="fas fa-car me-2 text-[#38bdf8]"></i> Todo el Inventario
        </a>
        <div class="py-2 border-b border-slate-800">
            <span class="text-[10px] font-black uppercase tracking-wider text-slate-500 block mb-2">Categorías</span>
            <div class="grid grid-cols-2 gap-2 text-xs">
                {MARKETPLACE_CATEGORIES.map(c => (
                    <a href={`/vehiculos?categoria=${c.id}`} class="p-2 bg-slate-900 text-slate-300 block">
                        <i class={`fas ${c.icon} me-1 text-[#38bdf8]`}></i> {c.name.split('&')[0]}
                    </a>
                ))}
            </div>
        </div>
        <a href="/publicar" class="block py-3 px-4 text-sm font-black uppercase tracking-wider bg-[#15803d] text-white text-center">
            <i class="fas fa-plus-circle me-1"></i> Publicar Mi Vehículo (Gratis)
        </a>
        <div class="pt-4 border-t border-slate-800 flex flex-col gap-2" id="mobile-auth-slot">
            <a href="/auth" class="w-full block py-2.5 text-center text-xs font-bold uppercase tracking-wider bg-slate-800 text-white">
                Iniciar Sesión / Registro
            </a>
        </div>
    </div>
</header>

<script>
    import { onAuthStateChanged, signOut } from "firebase/auth";
    import { auth } from "../lib/firebase/client";

    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    menuBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden');
        if (isHidden) {
            mobileMenu?.classList.remove('hidden');
            menuIcon?.classList.replace('fa-bars', 'fa-times');
        } else {
            mobileMenu?.classList.add('hidden');
            menuIcon?.classList.replace('fa-times', 'fa-bars');
        }
    });

    const authSlot = document.getElementById('auth-header-btn');
    const mobileAuthSlot = document.getElementById('mobile-auth-slot');

    onAuthStateChanged(auth, (user) => {
        if (user) {
            const name = user.displayName || user.email?.split('@')[0] || 'Mi Panel';
            const desktopContent = `
                <div class="flex items-center gap-2">
                    <a href="/panel" class="px-3.5 py-3 text-xs font-bold uppercase tracking-wider text-white bg-slate-800 hover:bg-slate-700 border border-slate-700 luxury-btn" style="border-radius: 0px !important;">
                        <i class="fas fa-gauge text-[#38bdf8] me-1"></i> ${name}
                    </a>
                    <button id="logout-btn" title="Salir" class="text-slate-400 hover:text-red-400 p-2 text-xs">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            `;
            const mobileContent = `
                <div class="flex gap-2">
                    <a href="/panel" class="flex-1 py-2.5 text-center text-xs font-bold uppercase tracking-wider bg-slate-800 text-white border border-slate-700">
                        Mi Panel (${name})
                    </a>
                    <button id="mobile-logout" class="px-3 py-2.5 text-red-400 bg-red-950/50 text-xs">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            `;
            if (authSlot) authSlot.innerHTML = desktopContent;
            if (mobileAuthSlot) mobileAuthSlot.innerHTML = mobileContent;
            document.getElementById('logout-btn')?.addEventListener('click', () => signOut(auth));
            document.getElementById('mobile-logout')?.addEventListener('click', () => signOut(auth));
        }
    });
</script>

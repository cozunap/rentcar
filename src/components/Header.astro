---
// Header matching exact Crocoblock Car Dealer New demo
import { TRANSPORT_TYPES } from "../lib/carDealerData";
---

<!-- Top Demo notice banner like in demo: "Full-access user profile is inside your demo space! Try to add your own listing using JetEngine and JetFormBuilder..." -->
<div class="bg-[#0f172a] text-slate-300 text-[11px] py-1.5 px-4 text-center font-medium border-b border-white/10 hidden sm:block">
  <span>Plataforma Car Dealer New de TuCarroYMás con arquitectura JetEngine y JetSmartFilters para República Dominicana.</span>
</div>

<header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 flex items-center justify-between">
    
    <!-- Logo with emerald green badge like CARDEALER demo -->
    <a href="/" class="flex items-center gap-2.5 group">
      <div class="w-9 h-9 rounded-full bg-[#00c982] flex items-center justify-center text-white font-black text-base shadow-sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 17a2 2 0 100 4 2 2 0 000-4zm10 0a2 2 0 100 4 2 2 0 000-4zM5 11l1.5-4.5A2 2 0 018.4 5h7.2a2 2 0 011.9 1.5L19 11M3 11h18v6H3v-6z"></path></svg>
      </div>
      <div class="flex flex-col">
        <span class="text-xl font-black tracking-tight uppercase text-slate-900 leading-none">
          CAR<span class="text-[#00c982]">DEALER</span>
        </span>
        <span class="text-[9px] uppercase tracking-widest text-slate-400 font-semibold mt-0.5">
          TuCarroYMás.com
        </span>
      </div>
    </a>

    <!-- Navigation links identical to Car Dealer demo: Add Listing, Shop & Ad, My Ads, Single Seller, Blog, Wishlist -->
    <nav class="hidden lg:flex items-center gap-7">
      <a href="/vehiculos" class="text-sm font-semibold text-slate-700 hover:text-[#00c982] transition-colors">
        Auto Listing
      </a>

      <!-- Types of transport dropdown -->
      <div class="relative group">
        <button type="button" class="text-sm font-semibold text-slate-700 hover:text-[#00c982] flex items-center gap-1 transition-colors">
          <span>Shop & Ad</span>
          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div class="absolute left-0 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all w-60 z-50">
          <div class="bg-white border border-slate-200 shadow-xl py-2">
            {TRANSPORT_TYPES.map(cat => (
              <a href={`/vehiculos?type=${cat.id}`} class="block px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#00c982]">
                {cat.nameEs}
              </a>
            ))}
          </div>
        </div>
      </div>

      <a href="/panel" class="text-sm font-semibold text-slate-700 hover:text-[#00c982] transition-colors">
        My Ads
      </a>
      <a href="/nosotros" class="text-sm font-semibold text-slate-700 hover:text-[#00c982] transition-colors">
        Single Seller
      </a>
      <a href="/contacto" class="text-sm font-semibold text-slate-700 hover:text-[#00c982] transition-colors">
        Blog
      </a>
      <a href="/vehiculos" class="text-sm font-semibold text-slate-700 hover:text-[#00c982] transition-colors">
        Wishlist
      </a>
    </nav>

    <!-- Right button: emerald "+ Post an Ad" button exactly as Car Dealer demo -->
    <div class="flex items-center gap-3">
      <a 
        href="/publicar" 
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-[#00c982] hover:bg-[#00b072] shadow-sm hover:shadow transition-all"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path></svg>
        Post an Ad
      </a>

      <!-- Mobile toggle -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="lg:hidden p-2 text-slate-600 hover:text-slate-900"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-5 space-y-3">
    <a href="/vehiculos" class="block py-1.5 text-sm font-semibold text-slate-800">Auto Listing</a>
    <div class="py-1">
      <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Tipos de Transporte</span>
      <div class="pl-3 space-y-1 border-l-2 border-[#00c982]">
        {TRANSPORT_TYPES.map(cat => (
          <a href={`/vehiculos?type=${cat.id}`} class="block py-1 text-xs text-slate-600 hover:text-[#00c982]">
            {cat.nameEs}
          </a>
        ))}
      </div>
    </div>
    <a href="/panel" class="block py-1.5 text-sm font-semibold text-slate-800">My Ads</a>
    <a href="/nosotros" class="block py-1.5 text-sm font-semibold text-slate-800">Single Seller</a>
    <a href="/contacto" class="block py-1.5 text-sm font-semibold text-slate-800">Blog / Contacto</a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>

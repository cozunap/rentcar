---
const pathname = Astro.url.pathname;
const isCurrent = (path: string) => pathname === path || (path !== '/' && pathname.startsWith(path));
---

<header class="sticky top-0 z-40 bg-white border-b border-gray-100 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
        
        <!-- Logo identical to original -->
        <a href="/" class="flex items-center gap-2 text-xl sm:text-2xl font-bold text-[#0d6efd] tracking-tight">
            <i class="fas fa-car-side"></i>
            <span>Rent A Car</span>
        </a>

        <!-- Desktop Navigation Links (Multi-page) -->
        <nav class="hidden md:flex items-center gap-7">
            <a href="/" class={`text-base transition-colors ${isCurrent('/') ? 'text-[#0d6efd] font-semibold' : 'text-gray-700 hover:text-[#0d6efd]'}`}>
                Inicio
            </a>
            <a href="/nosotros" class={`text-base transition-colors ${isCurrent('/nosotros') ? 'text-[#0d6efd] font-semibold' : 'text-gray-700 hover:text-[#0d6efd]'}`}>
                Nosotros
            </a>
            <a href="/flota" class={`text-base transition-colors ${isCurrent('/flota') ? 'text-[#0d6efd] font-semibold' : 'text-gray-700 hover:text-[#0d6efd]'}`}>
                Flota
            </a>
            <a href="/contacto" class={`text-base transition-colors ${isCurrent('/contacto') ? 'text-[#0d6efd] font-semibold' : 'text-gray-700 hover:text-[#0d6efd]'}`}>
                Contacto
            </a>
            <a href="/publicar" class={`text-base transition-colors ${isCurrent('/publicar') ? 'text-[#0d6efd] font-semibold' : 'text-gray-700 hover:text-[#0d6efd]'}`}>
                Publicar Auto
            </a>
        </nav>

        <!-- Right CTA Button identical to original -->
        <div class="hidden sm:flex items-center gap-3">
            <div id="auth-header-btn">
                <a href="/auth" class="text-sm font-semibold text-gray-600 hover:text-[#0d6efd] px-2 py-1 transition-colors">
                    <i class="fas fa-user-circle me-1"></i> Ingresar
                </a>
            </div>
            <a href="/flota" class="inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#0d6efd] hover:bg-[#0b5ed7] text-white font-semibold text-sm transition-colors shadow-sm">
                Reservar Ahora
            </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <div class="flex items-center gap-2 md:hidden">
            <button id="mobile-menu-btn" type="button" aria-label="Abrir menú" class="w-10 h-10 flex items-center justify-center text-gray-700 hover:text-[#0d6efd] border border-gray-200 rounded-lg">
                <i class="fas fa-bars text-lg" id="menu-icon"></i>
            </button>
        </div>

    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 bg-white px-4 pt-3 pb-5 space-y-2 text-center">
        <a href="/" class="block py-2 text-gray-700 hover:text-[#0d6efd] font-medium">Inicio</a>
        <a href="/nosotros" class="block py-2 text-gray-700 hover:text-[#0d6efd] font-medium">Nosotros</a>
        <a href="/flota" class="block py-2 text-gray-700 hover:text-[#0d6efd] font-medium">Flota</a>
        <a href="/contacto" class="block py-2 text-gray-700 hover:text-[#0d6efd] font-medium">Contacto</a>
        <a href="/publicar" class="block py-2 text-[#0d6efd] font-semibold">Publicar Auto</a>
        <div class="pt-3 border-t border-gray-100 flex flex-col gap-2">
            <div id="mobile-auth-slot">
                <a href="/auth" class="w-full block py-2 text-gray-700 font-semibold border border-gray-200 rounded-full">
                    Iniciar Sesión / Registro
                </a>
            </div>
            <a href="/flota" class="w-full block py-2.5 rounded-full bg-[#0d6efd] text-white font-semibold text-sm">
                Reservar Ahora
            </a>
        </div>
    </div>
</header>

<script>
    import { onAuthStateChanged, signOut } from "firebase/auth";
    import { auth } from "../lib/firebase/client";

    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuIcon = document.getElementById('menu-icon');

    menuBtn?.addEventListener('click', () => {
        const isHidden = mobileMenu?.classList.contains('hidden');
        if (isHidden) {
            mobileMenu?.classList.remove('hidden');
            menuIcon?.classList.replace('fa-bars', 'fa-times');
        } else {
            mobileMenu?.classList.add('hidden');
            menuIcon?.classList.replace('fa-times', 'fa-bars');
        }
    });

    const authSlot = document.getElementById('auth-header-btn');
    const mobileAuthSlot = document.getElementById('mobile-auth-slot');

    onAuthStateChanged(auth, (user) => {
        if (user) {
            const name = user.displayName || user.email?.split('@')[0] || 'Mi Panel';
            const desktopContent = `
                <div class="flex items-center gap-2">
                    <a href="/panel" class="text-sm font-semibold text-gray-700 hover:text-[#0d6efd] px-2 py-1">
                        <i class="fas fa-gauge text-[#0d6efd] me-1"></i> ${name}
                    </a>
                    <button id="logout-btn" title="Salir" class="text-gray-400 hover:text-red-500 text-sm p-1">
                        <i class="fas fa-sign-out-alt"></i>
                    </button>
                </div>
            `;
            const mobileContent = `
                <a href="/panel" class="w-full block py-2 text-[#0d6efd] font-semibold border border-[#0d6efd] rounded-full">
                    Mi Panel (${name})
                </a>
            `;
            if (authSlot) authSlot.innerHTML = desktopContent;
            if (mobileAuthSlot) mobileAuthSlot.innerHTML = mobileContent;
            document.getElementById('logout-btn')?.addEventListener('click', () => signOut(auth));
        }
    });
</script>

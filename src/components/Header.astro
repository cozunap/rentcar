---
// Header matching exact Crocoblock Car Dealer New demo - 100% Spanish with menu justified to the right
import { TRANSPORT_TYPES } from "../lib/carDealerData";
---

<!-- Top Demo notice banner en español -->
<div class="bg-[#0f172a] text-slate-300 text-[11px] py-1.5 px-4 text-center font-medium border-b border-white/10 hidden sm:block">
  <span>Plataforma Oficial de Concesionarios y Venta de Vehículos en República Dominicana — TuCarroYM</span>
</div>

<header class="sticky top-0 z-50 bg-white border-b border-slate-200 shadow-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-8 py-3.5 flex items-center justify-between">
    
    <!-- EXACT LOGO FROM USER IMAGE: TUCARRO in deep dark navy (#0c192c) + YM in bright vibrant green (#00c982) -->
    <a href="/" class="flex items-center gap-3 group shrink-0">
      <!-- Green circle with exact car icon from image -->
      <div class="w-11 h-11 rounded-full bg-[#00c982] flex items-center justify-center text-white shadow-md shadow-[#00c982]/25 group-hover:scale-105 transition-transform duration-200">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <!-- Stylized car outline like the exact logo mark -->
          <path d="M5 11l1.5-4.5A2 2 0 018.4 5h7.2a2 2 0 011.9 1.5L19 11M3 11h18v5H3v-5z"/>
          <circle cx="7.5" cy="17.5" r="1.5" fill="currentColor"/>
          <circle cx="16.5" cy="17.5" r="1.5" fill="currentColor"/>
        </svg>
      </div>

      <!-- Typography exact match: TUCARRO in #0c192c + YM in #00c982 with spaced subtitle REPÚBLICA DOMINICANA -->
      <div class="flex flex-col">
        <div class="flex items-baseline font-black tracking-tight leading-none text-2xl">
          <span class="text-[#0c192c]">TUCARRO</span><span class="text-[#00c982]">YM</span>
        </div>
        <span class="text-[9.5px] uppercase tracking-[0.22em] text-[#8492a6] font-bold mt-1">
          REPÚBLICA DOMINICANA
        </span>
      </div>
    </a>

    <!-- RIGHT-ALIGNED NAVIGATION & CTA BUTTON -->
    <div class="flex items-center gap-6">
      
      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-6">
        <a href="/vehiculos" class="text-xs uppercase tracking-wider font-bold text-slate-700 hover:text-[#00c982] transition-colors">
          Listado de Autos
        </a>

        <!-- Dropdown Categorías de Transporte -->
        <div class="relative group">
          <button type="button" class="text-xs uppercase tracking-wider font-bold text-slate-700 hover:text-[#00c982] flex items-center gap-1 transition-colors">
            <span>Comprar & Vender</span>
            <svg class="w-3.5 h-3.5 text-slate-400 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          <div class="absolute right-0 top-full pt-2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto transition-all w-64 z-50">
            <div class="bg-white border border-slate-200 shadow-xl py-2">
              {TRANSPORT_TYPES.map(cat => (
                <a href={`/vehiculos?type=${cat.id}`} class="block px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-50 hover:text-[#00c982]">
                  {cat.nameEs}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/brands" class="text-xs uppercase tracking-wider font-bold text-slate-700 hover:text-[#00c982] transition-colors">
          Marcas
        </a>
        <a href="/panel" class="text-xs uppercase tracking-wider font-bold text-slate-700 hover:text-[#00c982] transition-colors">
          Mis Anuncios
        </a>
        <a href="/nosotros" class="text-xs uppercase tracking-wider font-bold text-slate-700 hover:text-[#00c982] transition-colors">
          Concesionarios
        </a>
        <a href="/vehiculos" class="text-xs uppercase tracking-wider font-bold text-slate-700 hover:text-[#00c982] transition-colors">
          Favoritos
        </a>
      </nav>

      <!-- Botón Verde Publicar Anuncio -->
      <a 
        href="/publicar" 
        class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider text-white bg-[#00c982] hover:bg-[#00b072] shadow-sm hover:shadow transition-all shrink-0"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M12 4v16m8-8H4"></path></svg>
        Publicar Anuncio
      </a>

      <!-- Mobile toggle -->
      <button 
        id="mobile-menu-btn" 
        type="button" 
        class="lg:hidden p-2 text-slate-600 hover:text-slate-900"
        aria-label="Abrir menú"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
      </button>

    </div>

  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-5 space-y-3">
    <a href="/vehiculos" class="block py-1.5 text-sm font-semibold text-slate-800">Listado de Autos</a>
    <div class="py-1">
      <span class="block text-xs font-bold text-slate-400 uppercase tracking-wider mb-1">Tipos de Transporte</span>
      <div class="pl-3 space-y-1 border-l-2 border-[#00c982]">
        {TRANSPORT_TYPES.map(cat => (
          <a href={`/vehiculos?type=${cat.id}`} class="block py-1 text-xs text-slate-600 hover:text-[#00c982]">
            {cat.nameEs}
          </a>
        ))}
      </div>
    </div>
    <a href="/brands" class="block py-1.5 text-sm font-semibold text-slate-800">Marcas de Vehículos</a>
    <a href="/panel" class="block py-1.5 text-sm font-semibold text-slate-800">Mis Anuncios</a>
    <a href="/nosotros" class="block py-1.5 text-sm font-semibold text-slate-800">Concesionarios</a>
    <a href="/contacto" class="block py-1.5 text-sm font-semibold text-slate-800">Contacto</a>
  </div>
</header>

<script>
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  btn?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>

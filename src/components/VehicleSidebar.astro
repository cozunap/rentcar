<!-- Vehicle Details and Contact Sidebar (Offcanvas) -->
<div id="vehicle-offcanvas" class="fixed inset-0 z-50 pointer-events-none transition-opacity duration-300 opacity-0" aria-hidden="true">
    
    <!-- Backdrop Blur Overlay -->
    <div id="offcanvas-backdrop" class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity opacity-0"></div>

    <!-- Sliding Sidebar Panel (from right) -->
    <div id="offcanvas-panel" class="absolute top-0 right-0 h-full w-full max-w-lg bg-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out pointer-events-auto border-l border-slate-200 overflow-hidden">
        
        <!-- Header -->
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
            <div class="flex items-center gap-2">
                <span id="sidebar-category" class="px-2.5 py-1 text-xs font-bold uppercase tracking-wider bg-blue-50 text-[#0d6efd] border border-blue-100">
                    SUV
                </span>
                <span id="sidebar-available" class="inline-flex items-center gap-1.5 px-2.5 py-1 text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                    <span class="w-2 h-2 -full bg-emerald-500 animate-pulse"></span>
                    Disponible
                </span>
            </div>
            <button id="close-offcanvas-btn" type="button" aria-label="Cerrar panel" class="w-8 h-8  bg-white border border-slate-200 text-slate-500 hover:text-slate-800 hover:bg-slate-100 flex items-center justify-center transition-colors">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Scrollable Content Body -->
        <div class="flex-1 overflow-y-auto px-6 py-6 space-y-6">
            
            <!-- Main Image & Mini Gallery -->
            <div class="space-y-3">
                <div class="relative w-full h-64 bg-white border border-slate-100 overflow-hidden shadow-inner group">
                    <img id="sidebar-main-img" src="" alt="Vehículo" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
                    <div class="absolute bottom-3 left-3 px-3 py-1 bg-black/75 backdrop-blur-md text-white text-xs font-semibold">
                        <i class="fas fa-shield-alt text-[#0d6efd] me-1"></i> Vehículo Verificado
                    </div>
                </div>
                <div id="sidebar-gallery-thumbs" class="flex gap-2 overflow-x-auto pb-2 scrollbar-hide">
                    <!-- Dynamic Thumbnails inserted here -->
                </div>
            </div>

            <!-- Title & Price Block -->
            <div class="flex items-start justify-between gap-4 border-b border-slate-100 pb-5">
                <div>
                    <h2 id="sidebar-title" class="text-2xl font-bold text-[#0d1f3c] tracking-tight">Cargando...</h2>
                    <p id="sidebar-location" class="text-xs text-slate-500 flex items-center gap-1.5 mt-1">
                        <i class="fas fa-map-marker-alt text-[#0d6efd]"></i>
                        <span>Santo Domingo Este, República Dominicana</span>
                    </p>
                </div>
                <div class="text-right shrink-0">
                    <div class="text-2xl font-bold text-[#0d6efd]" id="sidebar-price">$0</div>
                    <span class="text-[11px] text-slate-400 font-medium uppercase tracking-wider">por día</span>
                </div>
            </div>

            <!-- Vehicle Specs Pills Grid -->
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">Especificaciones Técnicas</h3>
                <div class="grid grid-cols-2 gap-3 text-sm">
                    <div class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-100">
                        <i class="fas fa-users text-[#0d6efd] text-base w-5 text-center"></i>
                        <div>
                            <span class="text-[10px] uppercase text-slate-400 block font-semibold">Capacidad</span>
                            <span id="sidebar-seats" class="font-bold text-slate-800">5 Asientos</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-100">
                        <i class="fas fa-suitcase-rolling text-[#0d6efd] text-base w-5 text-center"></i>
                        <div>
                            <span class="text-[10px] uppercase text-slate-400 block font-semibold">Maletas</span>
                            <span id="sidebar-luggage" class="font-bold text-slate-800">3-4 Maletas</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-100">
                        <i class="fas fa-gear text-[#0d6efd] text-base w-5 text-center"></i>
                        <div>
                            <span class="text-[10px] uppercase text-slate-400 block font-semibold">Transmisión</span>
                            <span id="sidebar-transmission" class="font-bold text-slate-800">Automática</span>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 p-3 bg-slate-50 border border-slate-100">
                        <i class="fas fa-gas-pump text-[#0d6efd] text-base w-5 text-center"></i>
                        <div>
                            <span class="text-[10px] uppercase text-slate-400 block font-semibold">Combustible</span>
                            <span id="sidebar-fuel" class="font-bold text-slate-800">Gasolina</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Description -->
            <div>
                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">Descripción del Vehículo</h3>
                <p id="sidebar-description" class="text-sm text-slate-600 leading-relaxed bg-slate-50 p-4 border border-slate-100">
                    Vehículo en óptimas condiciones para rentar en Santo Domingo.
                </p>
            </div>

            <!-- Direct Contact Info Banner (WITHOUT USER PHOTO) -->
            <div class="bg-blue-50/50 p-4 border border-blue-100 space-y-2">
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-[#0d6efd]">
                        <i class="fas fa-handshake me-1"></i> Contacto Directo con el Propietario
                    </span>
                    <span class="text-[11px] font-bold text-emerald-600 flex items-center gap-1">
                        <i class="fas fa-check-circle"></i> Verificado
                    </span>
                </div>
                <div class="flex items-center justify-between pt-1">
                    <div>
                        <h4 id="sidebar-owner-name" class="font-bold text-slate-900 text-sm">Tu Carro y Más</h4>
                        <p id="sidebar-owner-phone" class="text-xs text-slate-600 mt-0.5 font-mono">+1 (849) 915-4010</p>
                    </div>
                    <div class="w-10 h-10 bg-emerald-50 text-emerald-600 border border-emerald-200 flex items-center justify-center text-xl">
                        <i class="fab fa-whatsapp"></i>
                    </div>
                </div>
                <p class="text-[11px] text-slate-500 leading-tight pt-1">
                    Comunícate directamente por WhatsApp para confirmar disponibilidad inmediata, acordar entrega y método de pago.
                </p>
            </div>

        </div>

        <!-- Sticky Footer CTA WhatsApp Button -->
        <div class="p-5 border-t border-slate-200 bg-white shadow-lg space-y-2">
            <a id="sidebar-whatsapp-btn" href="#" target="_blank" rel="noopener noreferrer" class="w-full py-3.5 px-6 bg-[#198754] hover:bg-[#157347] text-white font-bold text-sm uppercase tracking-wider flex items-center justify-center gap-2 transition-colors">
                <i class="fab fa-whatsapp text-xl"></i>
                <span>Contactar al Dueño por WhatsApp</span>
            </a>
            <p class="text-[11px] text-center text-slate-400">
                Respuesta directa e instantánea sin intermediarios
            </p>
        </div>

    </div>
</div>
